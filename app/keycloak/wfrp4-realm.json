{
  "realm": "wfrp4",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "wfrp4-joueur", "description": "Joueur WFRP4" },
      { "name": "wfrp4-maitre-jeu", "description": "Maitre de Jeu WFRP4" },
      { "name": "wfrp4-admin", "description": "Administrateur WFRP4" }
    ]
  },
  "clients": [
    {
      "clientId": "wfrp4-blazor",
      "name": "WFRP4 Blazor Client",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:5080/*", "https://localhost:7142/*"],
      "webOrigins": ["http://localhost:5080", "https://localhost:7142"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5080/*##https://localhost:7142/*"
      }
    },
    {
      "clientId": "wfrp4-api",
      "name": "WFRP4 API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "wfrp4-admin-service",
      "name": "WFRP4 Admin Service Account",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "secret": "dev-admin-secret-change-me"
    }
  ],
  "users": [
    {
      "username": "service-account-wfrp4-admin-service",
      "enabled": true,
      "serviceAccountClientId": "wfrp4-admin-service",
      "clientRoles": {
        "realm-management": ["manage-users", "view-realm"]
      }
    },
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "joueur1",
      "enabled": true,
      "email": "joueur1@wfrp4.local",
      "firstName": "Joueur",
      "lastName": "Un",
      "credentials": [{ "type": "password", "value": "joueur1", "temporary": false }],
      "realmRoles": ["wfrp4-joueur"]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "mj1",
      "enabled": true,
      "email": "mj1@wfrp4.local",
      "firstName": "Maitre",
      "lastName": "Jeu",
      "credentials": [{ "type": "password", "value": "mj1", "temporary": false }],
      "realmRoles": ["wfrp4-joueur", "wfrp4-maitre-jeu"]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "admin",
      "enabled": true,
      "email": "admin@wfrp4.local",
      "firstName": "Admin",
      "lastName": "WFRP4",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["wfrp4-joueur", "wfrp4-maitre-jeu", "wfrp4-admin"]
    }
  ]
}