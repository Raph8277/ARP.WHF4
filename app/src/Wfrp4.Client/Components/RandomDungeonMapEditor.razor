                    <MudSelectItem T="RandomMapPassageRouting" Value="RandomMapPassageRouting.HorizontalFirst">Angle horizontal</MudSelectItem>
                    <MudSelectItem T="RandomMapPassageRouting" Value="RandomMapPassageRouting.VerticalFirst">Angle vertical</MudSelectItem>
                </MudSelect>
                <MudCheckBox T="bool" Value="passage.Secret" ValueChanged="UpdateSelectedPassageSecret" Label="Passage secret" Class="mb-3" />
                <MudText Typo="Typo.body2" Class="mb-3">Cliquez sur un autre passage pour le modifier, ou sur une pièce pour revenir à son contenu.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LinkOff"
                           OnClick="DeleteSelectedPassage">Supprimer ce passage</MudButton>
            }
            else if (SelectedFeature is not null)
            {
                var feature = SelectedFeature;
                var owner = AreaById(feature.AreaId);
                <MudText Class="old-world-kicker">Détail de carte</MudText>
                <MudText Typo="Typo.h5" Class="mb-3" Style="font-family:var(--wfrp4-font-heading)">@FeatureLabel(feature.Kind)</MudText>
                <MudSelect T="RandomMapFeatureKind" Value="feature.Kind" ValueChanged="UpdateFeatureKind"
                           Label="Type de détail" Margin="Margin.Dense" Class="mb-2">
                    @foreach (var kind in Enum.GetValues<RandomMapFeatureKind>())
                    {
                        <MudSelectItem T="RandomMapFeatureKind" Value="kind">@FeatureLabel(kind)</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.body2" Class="mb-3">Dans : @(owner?.Name ?? "zone inconnue"). Faites glisser l’icône pour la placer précisément.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteSelectedFeature">Supprimer ce détail</MudButton>
            }
            else if (SelectedArea is null)
            {
                <div class="dungeon-editor__empty">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Sélectionnez un élément</MudText>
                    <MudText Typo="Typo.body2">Pièce, détail ou passage : chaque élément peut être modifié directement.</MudText>
                </div>
            }
            else
            {
                var selected = SelectedArea;
                <MudText Class="old-world-kicker">Zone @selected.Id</MudText>
                <MudText Typo="Typo.h5" Class="mb-3" Style="font-family:var(--wfrp4-font-heading)">@selected.Name</MudText>

                <MudTextField T="string" Value="selected.Name" ValueChanged="UpdateAreaName" Label="Nom" Margin="Margin.Dense" Class="mb-2" />
                <MudSelect T="RandomMapAreaPurpose" Value="selected.Purpose" ValueChanged="UpdateAreaPurpose" Label="Fonction" Margin="Margin.Dense" Class="mb-3">
                    @foreach (var purpose in Enum.GetValues<RandomMapAreaPurpose>())
                    {
                        <MudSelectItem T="RandomMapAreaPurpose" Value="purpose">@PurposeLabel(purpose)</MudSelectItem>
                    }
                </MudSelect>

                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Faites glisser la pièce pour la déplacer. Utilisez sa poignée dorée pour la redimensionner.
                </MudAlert>

                <MudText Typo="Typo.subtitle2" Class="mb-1">Déplacer</MudText>
                <div class="dungeon-editor__nudge mb-3">
                    <span></span>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" OnClick="@(() => MoveSelected(0, -20))" aria-label="Déplacer vers le haut" />
                    <span></span>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => MoveSelected(-20, 0))" aria-label="Déplacer vers la gauche" />
                    <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" OnClick="CenterSelected" aria-label="Centrer la zone" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => MoveSelected(20, 0))" aria-label="Déplacer vers la droite" />
                    <span></span>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" OnClick="@(() => MoveSelected(0, 20))" aria-label="Déplacer vers le bas" />
                    <span></span>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Link" OnClick="BeginLink">Relier</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelected" Disabled="@(_map.Areas.Count <= 4)">Supprimer</MudButton>
                </div>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Détails</MudText>
                <div class="dungeon-editor__add-feature mb-2">
                    <MudSelect T="RandomMapFeatureKind" @bind-Value="_newFeatureKind" Label="Nouveau détail" Margin="Margin.Dense">
                        @foreach (var kind in Enum.GetValues<RandomMapFeatureKind>())
                        {
                            <MudSelectItem T="RandomMapFeatureKind" Value="kind">@FeatureLabel(kind)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" OnClick="AddFeature" aria-label="Ajouter ce détail" />
                </div>
                @if (!FeaturesForSelectedArea.Any())
                {
                    <MudText Typo="Typo.caption" Class="mb-3">Aucun détail dans cette zone.</MudText>
                }
                else
                {
                    <div class="mb-3">
                        @foreach (var feature in FeaturesForSelectedArea)
                        {
                            <div class="dungeon-editor__feature-row">
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SelectFeature(feature.Id))">
                                    @FeatureLabel(feature.Kind)
                                </MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => RemoveFeature(feature))" aria-label="Supprimer le détail" />
                            </div>
                        }
                    </div>
                }

                <MudText Typo="Typo.subtitle2" Class="mb-2">Passages</MudText>
                @if (!SelectedPassages.Any())
                {
                    <MudText Typo="Typo.caption">Cette zone est isolée.</MudText>
                }
                else
                {
                    @foreach (var passage in SelectedPassages)
                    {
                        var other = OtherArea(passage);
                        <div class="dungeon-editor__passage-row">
                            <div>
                                <MudLink OnClick="@(() => SelectPassage(passage))">Vers @(other?.Name ?? "zone inconnue")</MudLink>
                                <MudText Typo="Typo.caption">@(passage.Secret ? "Passage secret" : "Passage visible")</MudText>
                            </div>
                            <MudIconButton Icon="@(passage.Secret ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                           Size="Size.Small" OnClick="@(() => ToggleSecret(passage))" aria-label="Basculer passage secret" />
                            <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemovePassage(passage))" aria-label="Supprimer le passage" />
                        </div>
                    }
                }
            }
        </aside>
    </div>
</div>

@code {
    private const string SvgId = "wfrp4-random-dungeon-map";
    [Parameter] public IReadOnlyList<RandomMapSettlement> Settlements { get; set; } = [];

    private readonly Stack<RandomDungeonMap> _history = new();
    private RandomMapKind _kind = RandomMapKind.Dungeon;
    private int _seed = 1789;
    private int _areaCount = 14;
    private int _loops = 2;
    private bool _showGrid;
    private bool _showLabels = true;
    private bool _showFeatures = true;
    private int? _selectedAreaId;
    private int? _selectedFeatureId;
    private int? _selectedPassageFromId;
    private int? _selectedPassageToId;
    private int? _linkSourceId;
    private string _selectedSettlementName = string.Empty;
    private RandomMapFeatureKind _newFeatureKind = RandomMapFeatureKind.Chest;
    private PointerAction _pointerAction;
    private int _pointerTargetId;
    private double _lastClientX;
    private double _lastClientY;
    private double _svgScaleX = 1;
    private double _svgScaleY = 1;
    private bool _pointerChanged;
    private RandomDungeonMap? _pointerSnapshot;
    private RandomDungeonMap _map = RandomDungeonMapGenerator.Generate(RandomMapKind.Dungeon, 14, 2, 1789);

    private RandomMapArea? SelectedArea => _selectedAreaId is null ? null : AreaById(_selectedAreaId.Value);
    private RandomMapFeature? SelectedFeature => _selectedFeatureId is null
        ? null
        : _map.Features.FirstOrDefault(feature => feature.Id == _selectedFeatureId.Value);
    private RandomMapPassage? SelectedPassage => _selectedPassageFromId is null || _selectedPassageToId is null
        ? null
        : _map.Passages.FirstOrDefault(passage => passage.FromAreaId == _selectedPassageFromId && passage.ToAreaId == _selectedPassageToId);
    private RandomMapSettlement? SelectedSettlement => string.IsNullOrWhiteSpace(_selectedSettlementName)
        ? null
        : Settlements.FirstOrDefault(settlement => settlement.Name == _selectedSettlementName);
    private IEnumerable<RandomMapPassage> SelectedPassages => _selectedAreaId is null
        ? []
        : _map.Passages.Where(passage => passage.FromAreaId == _selectedAreaId || passage.ToAreaId == _selectedAreaId);
    private IEnumerable<RandomMapFeature> FeaturesForSelectedArea => _selectedAreaId is null
        ? []
        : _map.Features.Where(feature => feature.AreaId == _selectedAreaId);
    private string CanvasFill => _map.Kind switch
    {
        RandomMapKind.Cave => "#9e9277",
        RandomMapKind.Inn => "#b99b75",
        RandomMapKind.Village => SettlementTerrainFill(_map.SettlementRegion),
        _ => "#756d5f"
    };
    private string PassageFill => _map.Kind switch
    {
        RandomMapKind.Cave => "#776b55",
        RandomMapKind.Village => "#c2aa78",
        RandomMapKind.Inn => "#a7835d",
        _ => "#8f8370"
    };
    private string PassageBorderColor => _map.Kind == RandomMapKind.Village ? "#8c7653" : "#241e18";
    private int PassageSelectionWidth => _map.Kind switch
    {
        RandomMapKind.Cave => 34,
        RandomMapKind.Village => _map.SettlementLayout == RandomMapSettlementLayout.Fortified ? 13 : 20,
        RandomMapKind.Inn => 16,
        _ => 28
    };
    private int PassageBorderWidth => _map.Kind switch
    {
        RandomMapKind.Cave => 24,
        RandomMapKind.Village => _map.SettlementLayout == RandomMapSettlementLayout.Fortified ? 6 : 9,
        RandomMapKind.Inn => 9,
        _ => 18
    };
    private int PassageInnerWidth => _map.Kind switch
    {
        RandomMapKind.Cave => 14,
        RandomMapKind.Village => _map.SettlementLayout == RandomMapSettlementLayout.Fortified ? 3 : 5,
        RandomMapKind.Inn => 5,
        _ => 10
    };
    private string VillageMainRoadPath => BuildVillageRoadPath();
    private int VillageRoadWidth => _map.SettlementType switch
    {
        "Cité" => 21,
        "Ville" => 19,
        "Bourg" => 17,
        _ => 15
    };
    private int VillageRoadBorderWidth => VillageRoadWidth + 6;
    private RandomMapSettlementLandscape CurrentSettlementLandscape =>
        _map.SettlementLandscape ?? RandomMapSettlementLandscape.River;
    private bool ShowRiver => CurrentSettlementLandscape == RandomMapSettlementLandscape.River;
    private bool ShowHarbor => CurrentSettlementLandscape == RandomMapSettlementLandscape.Port;
    private string HarborWaterPath => "M 575 640 C 568 565 590 486 652 451 C 728 407 817 402 960 443 L 960 640 Z";
    private string HarborShorePath => "M 578 634 C 575 557 598 493 658 459 C 732 417 817 414 957 451";
    private IReadOnlyList<string> FortifiedStreetPaths =>
    [
        "M 178 318 C 176 208 286 139 466 129 C 654 120 779 198 790 313 C 801 432 674 502 489 511 C 302 518 181 440 178 318 Z",
        "M 300 318 C 302 242 374 202 480 200 C 588 198 661 244 662 321 C 663 397 585 438 478 438 C 373 438 299 397 300 318 Z",
        "M 480 113 C 449 200 513 258 480 320 C 450 379 494 438 480 529",
        "M 127 315 C 261 282 354 340 480 320 C 610 299 707 342 842 309",
        "M 211 151 C 319 223 377 258 480 320 C 574 376 650 420 748 498",
        "M 753 154 C 657 217 585 260 480 320 C 381 377 314 420 221 491"
    ];
    private IReadOnlyList<string> HarborDocks =>
    [
        "M 650 511 L 713 540", "M 704 465 L 748 516", "M 787 437 L 803 497", "M 872 437 L 865 490"
    ];
    private string SettlementLayoutLabel => _map.SettlementLayout switch
    {
        RandomMapSettlementLayout.Fortified => "Enceinte fortifiée",
        RandomMapSettlementLayout.Clustered => "Bourg groupé",
        RandomMapSettlementLayout.Dispersed => "Habitat dispersé",
        _ => "Village-rue"
    };
    private bool IsPalisadedSettlement => _map.SettlementType == "Bourg";
    private bool ShowsSettlementWall => _map.SettlementLayout == RandomMapSettlementLayout.Fortified || IsPalisadedSettlement;
    private int SettlementWallOuterWidth => IsPalisadedSettlement ? 10 : 18;
    private int SettlementWallInnerWidth => IsPalisadedSettlement ? 6 : 11;
    private string SettlementWallFill => IsPalisadedSettlement ? "#72563c" : "#918571";
    private string SettlementWallPath => IsPalisadedSettlement
        ? "M 146 154 Q 476 62 816 166 Q 900 320 812 493 Q 480 584 142 486 Q 65 320 146 154 Z"
        : "M 112 134 Q 476 38 850 147 Q 925 320 844 518 Q 476 608 108 505 Q 33 318 112 134 Z";
    private IReadOnlyList<SettlementTower> SettlementTowers => IsPalisadedSettlement
        ?
        [
            new(146, 154, 10), new(816, 166, 10), new(812, 493, 10), new(142, 486, 10)
        ]
        :
        [
            new(112, 134, 15), new(480, 82, 15), new(850, 147, 15), new(884, 324, 15),
            new(844, 518, 15), new(476, 562, 15), new(108, 505, 15), new(70, 320, 15)
        ];
    private string VillageStreamPath
    {
        get
        {
            var offset = _map.Seed % 83 - 41;
            return $"M -30 {F(105 + offset)} C 180 {F(35 + offset)} 305 {F(185 + offset)} 505 {F(108 + offset)} S 785 {F(60 + offset)} 990 {F(132 + offset)}";
        }
    }
    private string CanvasClass => _pointerAction == PointerAction.None
        ? "dungeon-editor__canvas"
        : "dungeon-editor__canvas dungeon-editor__canvas--dragging";

    private void GenerateMap()
    {
        var settlement = _kind == RandomMapKind.Village ? SelectedSettlement : null;
        var landscape = CurrentSettlementLandscape;
        _map = RandomDungeonMapGenerator.Generate(_kind, _areaCount, _loops, Math.Max(1, _seed), settlement);
        if (_kind == RandomMapKind.Village)
            _map.SettlementLandscape = landscape;
        _history.Clear();
        _selectedAreaId = _map.Areas[0].Id;
        _selectedFeatureId = null;
        ClearPassageSelection();
        _linkSourceId = null;
        ResetPointerAction();
    }

    private void GenerateSurprise()
    {
        _seed = Random.Shared.Next(1, int.MaxValue);
        GenerateMap();
    }

    private void OnKindChanged(RandomMapKind kind)
    {
        _kind = kind;
        _showGrid = kind == RandomMapKind.Cave;
        _showFeatures = kind != RandomMapKind.Village;
        GenerateMap();
    }

    private void OnShowFeaturesChanged(bool show)
    {
        _showFeatures = show;
        if (!show)
            _selectedFeatureId = null;
    }

    private void OnSettlementChanged(string value)
    {
        _selectedSettlementName = value ?? string.Empty;
        if (SelectedSettlement is not null)
        {
            _areaCount = RandomDungeonMapGenerator.RecommendedAreaCount(SelectedSettlement);
            _seed = RandomDungeonMapGenerator.SettlementSeed(SelectedSettlement);
            _loops = SelectedSettlement.Type switch
            {
                "Ville" or "Cité" => 6,
                "Bourg" => 4,
                _ => 2
            };
        }
        GenerateMap();
    }

    private void UpdateSettlementLandscape(RandomMapSettlementLandscape landscape)
    {
        if (_map.SettlementLandscape == landscape) return;
        SaveSnapshot();
        _map.SettlementLandscape = landscape;
    }

    private void SaveSnapshot()
    {
        PushSnapshot(_map.Clone());
    }

    private void PushSnapshot(RandomDungeonMap snapshot)
    {
        _history.Push(snapshot);
        while (_history.Count > 40)
        {
            var retained = _history.Take(40).Reverse().ToArray();
            _history.Clear();
            foreach (var item in retained) _history.Push(item);
        }
    }

    private void Undo()
    {
        if (_history.Count == 0) return;
        _map = _history.Pop();
        _kind = _map.Kind;
        if (_selectedAreaId is not null && AreaById(_selectedAreaId.Value) is null)
            _selectedAreaId = null;
        if (_selectedFeatureId is not null && SelectedFeature is null)
            _selectedFeatureId = null;
        ClearPassageSelection();
        _linkSourceId = null;
        ResetPointerAction();
    }

    private void SelectArea(int id)
    {
        if (_linkSourceId is not null && _linkSourceId != id)
        {
            if (!HasPassage(_linkSourceId.Value, id))
            {
                SaveSnapshot();
                _map.Passages.Add(new RandomMapPassage
                {
                    FromAreaId = Math.Min(_linkSourceId.Value, id),
                    ToAreaId = Math.Max(_linkSourceId.Value, id),
                    Routing = _map.Kind != RandomMapKind.Cave
                        ? RandomMapPassageRouting.HorizontalFirst
                        : RandomMapPassageRouting.Direct
                });
            }
            _linkSourceId = null;
        }
        _selectedAreaId = id;
        _selectedFeatureId = null;
        ClearPassageSelection();
    }

    private void ClearSelection()
    {
        if (_linkSourceId is null)
        {
            _selectedAreaId = null;
            _selectedFeatureId = null;
            ClearPassageSelection();
        }
    }

    private void SelectFeature(int id)
    {
        var feature = _map.Features.FirstOrDefault(item => item.Id == id);
        if (feature is null) return;
        _selectedFeatureId = id;
        _selectedAreaId = feature.AreaId;
        _linkSourceId = null;
        ClearPassageSelection();
    }

    private void SelectPassage(RandomMapPassage passage)
    {
        _selectedPassageFromId = passage.FromAreaId;
        _selectedPassageToId = passage.ToAreaId;
        _selectedAreaId = null;
        _selectedFeatureId = null;
        _linkSourceId = null;
    }

    private bool IsSelectedPassage(RandomMapPassage passage) =>
        passage.FromAreaId == _selectedPassageFromId && passage.ToAreaId == _selectedPassageToId;

    private void ClearPassageSelection()
    {
        _selectedPassageFromId = null;
        _selectedPassageToId = null;
    }

    private void BeginLink()
    {
        if (_selectedAreaId is not null)
            _linkSourceId = _selectedAreaId;
    }

    private void CancelLink() => _linkSourceId = null;

    private void AddArea()
    {
        if (_map.Areas.Count >= 30) return;
        SaveSnapshot();
        var random = new Random(_map.Seed ^ (_map.Areas.Count + 1) * 7919);
        var width = _map.Kind switch
        {
            RandomMapKind.Cave => 135d,
            RandomMapKind.Village => 100d,
            _ => 110d
        };
        var height = _map.Kind switch
        {
            RandomMapKind.Cave => 105d,
            RandomMapKind.Village => 70d,
            _ => 80d
        };
        var x = 420d;
        var y = 280d;

        for (var attempt = 0; attempt < 120; attempt++)
        {
            var candidateX = 36 + random.NextDouble() * (RandomDungeonMap.CanvasWidth - 72 - width);
            var candidateY = 36 + random.NextDouble() * (RandomDungeonMap.CanvasHeight - 72 - height);
            if (_map.Areas.All(area => !Intersects(area, candidateX, candidateY, width, height)))
            {
                x = candidateX;
                y = candidateY;
                break;
            }
        }

        var previousSelection = SelectedArea;
        var id = _map.Areas.Count == 0 ? 1 : _map.Areas.Max(area => area.Id) + 1;
        var area = new RandomMapArea
        {
            Id = id,
            X = x,
            Y = y,
            Width = width,
            Height = height,
            Rotation = _map.Kind == RandomMapKind.Village ? random.NextDouble() * 24 - 12 : 0,
            ShapeSeed = random.Next(1, int.MaxValue),
            Name = _map.Kind switch
            {
                RandomMapKind.Cave => $"Nouvelle cavité {id}",
                RandomMapKind.Inn => $"Nouvelle pièce {id}",
                RandomMapKind.Village => $"Nouveau bâtiment {id}",
                _ => $"Nouvelle salle {id}"
            },
            Purpose = RandomMapAreaPurpose.Chamber
        };
        _map.Areas.Add(area);
        if (previousSelection is not null)
        {
            _map.Passages.Add(new RandomMapPassage
            {
                FromAreaId = Math.Min(previousSelection.Id, id),
                ToAreaId = Math.Max(previousSelection.Id, id),
                Routing = _map.Kind != RandomMapKind.Cave
                    ? RandomMapPassageRouting.HorizontalFirst
                    : RandomMapPassageRouting.Direct
            });
        }
        _selectedAreaId = id;
        _selectedFeatureId = null;
        ClearPassageSelection();
    }

    private void DeleteSelected()
    {
        if (SelectedArea is null || _map.Areas.Count <= 4) return;
        SaveSnapshot();
        var id = SelectedArea.Id;
        _map.Areas.RemoveAll(area => area.Id == id);
        _map.Passages.RemoveAll(passage => passage.FromAreaId == id || passage.ToAreaId == id);
        _map.Features.RemoveAll(feature => feature.AreaId == id);
        _selectedAreaId = null;
        _selectedFeatureId = null;
        ClearPassageSelection();
        _linkSourceId = null;
    }

    private void MoveSelected(double deltaX, double deltaY)
    {
        if (SelectedArea is null) return;
        SaveSnapshot();
        MoveAreaAndFeatures(SelectedArea, deltaX, deltaY);
    }

    private void CenterSelected()
    {
        if (SelectedArea is null) return;
        SaveSnapshot();
        var targetX = (RandomDungeonMap.CanvasWidth - SelectedArea.Width) / 2;
        var targetY = (RandomDungeonMap.CanvasHeight - SelectedArea.Height) / 2;
        MoveAreaAndFeatures(SelectedArea, targetX - SelectedArea.X, targetY - SelectedArea.Y);
    }

    private void MoveAreaAndFeatures(RandomMapArea area, double deltaX, double deltaY)
    {
        var oldX = area.X;
        var oldY = area.Y;
        area.X = Math.Clamp(area.X + deltaX, 12, RandomDungeonMap.CanvasWidth - area.Width - 12);
        area.Y = Math.Clamp(area.Y + deltaY, 12, RandomDungeonMap.CanvasHeight - area.Height - 12);
        var appliedX = area.X - oldX;
        var appliedY = area.Y - oldY;
        foreach (var feature in _map.Features.Where(feature => feature.AreaId == area.Id))
        {
            feature.X += appliedX;
            feature.Y += appliedY;
        }
    }

