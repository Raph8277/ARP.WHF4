    private string PassagePath(RandomMapArea from, RandomMapArea to, RandomMapPassage passage)
    {
        if (_map.Kind == RandomMapKind.Village)
        {
            var middleX = (from.CenterX + to.CenterX) / 2;
            var middleY = (from.CenterY + to.CenterY) / 2;
            var bend = ((from.Id * 37 + to.Id * 19 + _map.Seed) % 55) - 27;
            return passage.Routing switch
            {
                RandomMapPassageRouting.HorizontalFirst => $"M {F(from.CenterX)} {F(from.CenterY)} C {F(middleX)} {F(from.CenterY + bend)} {F(middleX)} {F(to.CenterY - bend)} {F(to.CenterX)} {F(to.CenterY)}",
                RandomMapPassageRouting.VerticalFirst => $"M {F(from.CenterX)} {F(from.CenterY)} C {F(from.CenterX + bend)} {F(middleY)} {F(to.CenterX - bend)} {F(middleY)} {F(to.CenterX)} {F(to.CenterY)}",
                _ => $"M {F(from.CenterX)} {F(from.CenterY)} Q {F(middleX + bend)} {F(middleY - bend)} {F(to.CenterX)} {F(to.CenterY)}"
            };
        }

        if (_map.Kind == RandomMapKind.Dungeon)
        {
            var ratio = 0.32 + ((from.Id * 17 + to.Id * 29 + _map.Seed) % 37) / 100d;
            var bendX = from.CenterX + (to.CenterX - from.CenterX) * ratio;
            var bendY = from.CenterY + (to.CenterY - from.CenterY) * (1 - ratio);
            return passage.Routing switch
            {
                RandomMapPassageRouting.VerticalFirst =>
                    $"M {F(from.CenterX)} {F(from.CenterY)} V {F(bendY)} H {F(to.CenterX)} V {F(to.CenterY)}",
                RandomMapPassageRouting.HorizontalFirst =>
                    $"M {F(from.CenterX)} {F(from.CenterY)} H {F(bendX)} V {F(to.CenterY)} H {F(to.CenterX)}",
                _ when (from.Id + to.Id + _map.Seed) % 2 == 0 =>
                    $"M {F(from.CenterX)} {F(from.CenterY)} H {F(bendX)} V {F(bendY)} H {F(to.CenterX)} V {F(to.CenterY)}",
                _ =>
                    $"M {F(from.CenterX)} {F(from.CenterY)} V {F(bendY)} H {F(bendX)} V {F(to.CenterY)} H {F(to.CenterX)}"
            };
        }

        if (_map.Kind != RandomMapKind.Cave)
        {
            return passage.Routing switch
            {
                RandomMapPassageRouting.Direct => $"M {F(from.CenterX)} {F(from.CenterY)} L {F(to.CenterX)} {F(to.CenterY)}",
                RandomMapPassageRouting.VerticalFirst => $"M {F(from.CenterX)} {F(from.CenterY)} V {F(to.CenterY)} H {F(to.CenterX)}",
                _ => $"M {F(from.CenterX)} {F(from.CenterY)} H {F(to.CenterX)} V {F(to.CenterY)}"
            };
        }

        return passage.Routing switch
        {
            RandomMapPassageRouting.Direct => $"M {F(from.CenterX)} {F(from.CenterY)} L {F(to.CenterX)} {F(to.CenterY)}",
            RandomMapPassageRouting.HorizontalFirst => $"M {F(from.CenterX)} {F(from.CenterY)} Q {F(to.CenterX)} {F(from.CenterY)} {F(to.CenterX)} {F(to.CenterY)}",
            _ => $"M {F(from.CenterX)} {F(from.CenterY)} Q {F(from.CenterX)} {F(to.CenterY)} {F(to.CenterX)} {F(to.CenterY)}"
        };
    }

    private static string CavePath(RandomMapArea area)
    {
        var random = new Random(area.ShapeSeed);
        const int count = 12;
        var points = new List<(double X, double Y)>(count);
        for (var index = 0; index < count; index++)
        {
            var angle = Math.PI * 2 * index / count;
            var radius = 0.82 + random.NextDouble() * 0.25;
            points.Add((
                area.CenterX + Math.Cos(angle) * area.Width / 2 * radius,
                area.CenterY + Math.Sin(angle) * area.Height / 2 * radius));
        }

        var builder = new StringBuilder();
        var start = Midpoint(points[^1], points[0]);
        builder.Append("M ").Append(F(start.X)).Append(' ').Append(F(start.Y));
        for (var index = 0; index < points.Count; index++)
        {
            var next = points[(index + 1) % points.Count];
            var middle = Midpoint(points[index], next);
            builder.Append(" Q ").Append(F(points[index].X)).Append(' ').Append(F(points[index].Y))
                .Append(' ').Append(F(middle.X)).Append(' ').Append(F(middle.Y));
        }
        return builder.Append(" Z").ToString();
    }

    private static string DungeonRoomPath(RandomMapArea area)
    {
        var random = new Random(area.ShapeSeed);
        var topLeft = 2 + random.NextDouble() * 5;
        var topMiddle = Jitter(random, 3);
        var topRight = 2 + random.NextDouble() * 5;
        var rightMiddle = Jitter(random, 3);
        var bottomRight = 2 + random.NextDouble() * 5;
        var bottomMiddle = Jitter(random, 3);
        var bottomLeft = 2 + random.NextDouble() * 5;
        var leftMiddle = Jitter(random, 3);
        return $"M {F(area.X + topLeft)} {F(area.Y + 2)} " +
               $"L {F(area.CenterX)} {F(area.Y + topMiddle)} " +
               $"L {F(area.X + area.Width - 2)} {F(area.Y + topRight)} " +
               $"L {F(area.X + area.Width + rightMiddle)} {F(area.CenterY)} " +
               $"L {F(area.X + area.Width - bottomRight)} {F(area.Y + area.Height - 2)} " +
               $"L {F(area.CenterX)} {F(area.Y + area.Height + bottomMiddle)} " +
               $"L {F(area.X + bottomLeft)} {F(area.Y + area.Height - 2)} " +
               $"L {F(area.X + leftMiddle)} {F(area.CenterY)} Z";
    }

    private static string DungeonInnerWallPath(RandomMapArea area) =>
        $"M {F(area.X + 9)} {F(area.Y + 10)} L {F(area.X + area.Width - 10)} {F(area.Y + 8)} " +
        $"L {F(area.X + area.Width - 8)} {F(area.Y + area.Height - 10)} L {F(area.X + 10)} {F(area.Y + area.Height - 8)} Z";

    private static string DungeonRoomCrackPath(RandomMapArea area)
    {
        var random = new Random(area.ShapeSeed ^ 0x5f3759df);
        var startX = area.X + 12 + random.NextDouble() * Math.Max(1, area.Width - 30);
        var startY = area.Y + 8;
        return $"M {F(startX)} {F(startY)} l {F(Jitter(random, 8))} 9 l {F(Jitter(random, 9))} 8 l {F(Jitter(random, 7))} 7";
    }

    private string DungeonCrackPath(int index)
    {
        var random = new Random(_map.Seed ^ ((index + 1) * 104729));
        var x = 60 + random.NextDouble() * 820;
        var y = 45 + random.NextDouble() * 520;
        return $"M {F(x)} {F(y)} l {F(Jitter(random, 22))} {F(18 + random.NextDouble() * 22)} " +
               $"l {F(Jitter(random, 26))} {F(16 + random.NextDouble() * 26)} l {F(Jitter(random, 20))} {F(12 + random.NextDouble() * 20)}";
    }

    private static double Jitter(Random random, double amplitude) =>
        (random.NextDouble() * 2 - 1) * amplitude;

    private static (double X, double Y) Midpoint((double X, double Y) left, (double X, double Y) right) =>
        ((left.X + right.X) / 2, (left.Y + right.Y) / 2);

    private IReadOnlyList<VillageBuildingGlyph> VillageBuildings(RandomMapArea area)
    {
        var count = _map.SettlementType switch
        {
            "Cité" => 4,
            "Ville" => 4,
            "Bourg" => 3,
            _ => 2
        };
        var random = new Random(area.ShapeSeed ^ 0x4a17c9);
        var buildings = new List<VillageBuildingGlyph>(count);
        var landmark = area.Purpose != RandomMapAreaPurpose.Chamber;
        var primaryWidth = area.Width * (landmark ? 0.68 : 0.55);
        var primaryHeight = area.Height * (landmark ? 0.62 : 0.52);
        buildings.Add(new VillageBuildingGlyph(
            area.CenterX - primaryWidth / 2,
            area.CenterY - primaryHeight / 2,
            primaryWidth,
            primaryHeight,
            area.Rotation,
            area.ShapeSeed,
            true));

        (double X, double Y)[] anchors =
        [
            (0.16, 0.18), (0.5, 0.14), (0.84, 0.2),
            (0.16, 0.8), (0.5, 0.85), (0.84, 0.78)
        ];
        for (var index = 1; index < count; index++)
        {
            var width = area.Width * (0.24 + random.NextDouble() * 0.07);
            var height = area.Height * (0.23 + random.NextDouble() * 0.075);
            var anchor = anchors[index - 1];
            var centerX = area.X + area.Width * anchor.X + Jitter(random, area.Width * 0.035);
            var centerY = area.Y + area.Height * anchor.Y + Jitter(random, area.Height * 0.035);
            buildings.Add(new VillageBuildingGlyph(
                Math.Clamp(centerX - width / 2, area.X + 2, area.X + area.Width - width - 2),
                Math.Clamp(centerY - height / 2, area.Y + 2, area.Y + area.Height - height - 2),
                width,
                height,
                area.Rotation + Jitter(random, 16),
                random.Next(1, int.MaxValue),
                false));
        }

        return buildings;
    }

    private IReadOnlyList<VillageBuildingGlyph> SettlementInfillBuildings()
    {
        if (_map.SettlementLayout == RandomMapSettlementLayout.Fortified)
            return FortifiedSettlementBlocks();

        var desiredCount = _map.SettlementType switch
        {
            "Bourg" => 55,
            _ => 24
        };
        var random = new Random(_map.Seed ^ 0x63b7a1);
        var buildings = new List<VillageBuildingGlyph>(desiredCount);
        var phase = new Random(_map.Seed).NextDouble() * Math.PI * 2;

        for (var attempt = 0; attempt < desiredCount * 35 && buildings.Count < desiredCount; attempt++)
        {
            var width = 14 + random.NextDouble() * 14;
            var height = 9 + random.NextDouble() * 10;
            double centerX;
            double centerY;

            if (_map.SettlementLayout is RandomMapSettlementLayout.Fortified or RandomMapSettlementLayout.Clustered)
            {
                var angle = random.NextDouble() * Math.PI * 2;
                var radius = Math.Sqrt(random.NextDouble());
                var radiusX = _map.SettlementLayout == RandomMapSettlementLayout.Fortified ? 330 : 295;
                var radiusY = _map.SettlementLayout == RandomMapSettlementLayout.Fortified ? 205 : 185;
                centerX = 480 + Math.Cos(angle) * radius * radiusX;
                centerY = 320 + Math.Sin(angle) * radius * radiusY;
            }
            else if (_map.SettlementLayout == RandomMapSettlementLayout.Linear)
            {
                centerX = 48 + random.NextDouble() * 864;
                var roadY = 318 + Math.Sin(centerX / 145 + phase) * 82 + Math.Sin(centerX / 62 + phase * 0.7) * 18;
                centerY = roadY + Jitter(random, 118);
            }
            else
            {
                centerX = 42 + random.NextDouble() * 876;
                centerY = 42 + random.NextDouble() * 556;
            }

            var x = centerX - width / 2;
            var y = centerY - height / 2;
            if (x < 38 || y < 38 || x + width > 922 || y + height > 602)
                continue;
            if (ShowHarbor && centerX > 570 && centerY > 405)
                continue;
            if (_map.Areas.Any(area => Intersects(area, x, y, width, height)))
                continue;
            if (buildings.Any(building =>
                    building.X - 2 < x + width && building.X + building.Width + 2 > x &&
                    building.Y - 2 < y + height && building.Y + building.Height + 2 > y))
                continue;

            buildings.Add(new VillageBuildingGlyph(
                x,
                y,
                width,
                height,
                Jitter(random, 18),
                random.Next(1, int.MaxValue),
                false));
        }

        return buildings;
    }

    private IReadOnlyList<VillageBuildingGlyph> FortifiedSettlementBlocks()
    {
        var desiredCount = _map.SettlementType == "Cité" ? 260 : 205;
        var random = new Random(_map.Seed ^ 0x2f96d3);
        var buildings = new List<VillageBuildingGlyph>(desiredCount);
        double[] blockColumns = [175, 280, 385, 490, 595, 700, 790];
        double[] blockRows = [145, 230, 315, 400, 485];

        foreach (var baseY in blockRows)
        foreach (var baseX in blockColumns)
        {
            var blockX = baseX + Jitter(random, 17);
            var blockY = baseY + Jitter(random, 13);
            var radialAngle = Math.Atan2(blockY - 320, blockX - 480) * 180 / Math.PI;
            var rotation = radialAngle + 90 + Jitter(random, 9);
            var radians = rotation * Math.PI / 180;
            var columns = random.Next(3, 5);
            var rows = random.Next(2, 4);
            var spacingX = 31 + random.NextDouble() * 5;
            var spacingY = 24 + random.NextDouble() * 4;

            for (var row = 0; row < rows && buildings.Count < desiredCount; row++)
            for (var column = 0; column < columns && buildings.Count < desiredCount; column++)
            {
                var localX = (column - (columns - 1) / 2d) * spacingX + Jitter(random, 2.5);
                var localY = (row - (rows - 1) / 2d) * spacingY + Jitter(random, 2.5);
                var centerX = blockX + localX * Math.Cos(radians) - localY * Math.Sin(radians);
                var centerY = blockY + localX * Math.Sin(radians) + localY * Math.Cos(radians);
                var width = 23 + random.NextDouble() * 8;
                var height = 15 + random.NextDouble() * 5;
                var x = centerX - width / 2;
                var y = centerY - height / 2;

                var ellipse = Math.Pow((centerX - 480) / 350, 2) + Math.Pow((centerY - 320) / 222, 2);
                if (ellipse > 0.9)
                    continue;
                if (ShowHarbor && centerX > 570 && centerY > 405)
                    continue;
                if (buildings.Any(building =>
                        building.X - 2 < x + width && building.X + building.Width + 2 > x &&
                        building.Y - 2 < y + height && building.Y + building.Height + 2 > y))
                    continue;

                buildings.Add(new VillageBuildingGlyph(
                    x,
                    y,
                    width,
                    height,
                    rotation + Jitter(random, 4),
                    random.Next(1, int.MaxValue),
                    false));
            }
        }

        return buildings;
    }

    private IEnumerable<VillageTree> VillageTrees()
    {
        var desiredCount = _map.SettlementType switch
        {
            "Cité" => 12,
            "Ville" => 16,
            "Bourg" => 21,
            _ => 28
        };
        var random = new Random(_map.Seed ^ 0x19d3a5);
        var trees = new List<VillageTree>(desiredCount);
        for (var attempt = 0; attempt < desiredCount * 10 && trees.Count < desiredCount; attempt++)
        {
            var x = 24 + random.NextDouble() * 912;
            var y = 24 + random.NextDouble() * 592;
            if (ShowHarbor && x > 555 && y > 405)
                continue;
            if (_map.SettlementLayout == RandomMapSettlementLayout.Fortified &&
                x is > 74 and < 886 && y is > 78 and < 566)
                continue;
            if (_map.Areas.Any(area =>
                    x > area.X - 24 && x < area.X + area.Width + 24 &&
                    y > area.Y - 24 && y < area.Y + area.Height + 24))
                continue;
            if (trees.Any(tree => Math.Pow(tree.X - x, 2) + Math.Pow(tree.Y - y, 2) < 430))
                continue;
            trees.Add(new VillageTree(x, y, 0.68 + random.NextDouble() * 0.5));
        }
        return trees;
    }

    private bool ShouldShowAreaLabel(RandomMapArea area)
    {
        if (!_showLabels) return false;
        if (_map.Kind != RandomMapKind.Village) return true;
        if (_map.SettlementType is "Ville" or "Cité")
        {
            return area.Purpose is RandomMapAreaPurpose.Entrance or RandomMapAreaPurpose.Exit ||
                   area.Purpose == RandomMapAreaPurpose.Shrine && area.Id % 10 == 0 ||
                   area.Purpose == RandomMapAreaPurpose.Treasure && area.Id % 14 == 0 ||
                   area.Purpose == RandomMapAreaPurpose.Chamber && area.Id % 11 == 0;
        }
        if (area.Purpose is RandomMapAreaPurpose.Entrance or RandomMapAreaPurpose.Exit or RandomMapAreaPurpose.Shrine) return true;
        return _map.SettlementType switch
        {
            "Bourg" => area.Id % 3 == 0,
            _ => area.Id % 3 == 0
        };
    }

    private string FeatureTransform(RandomMapFeature feature)
    {
        var scale = _map.Kind == RandomMapKind.Village ? 0.72 : 1;
        return $"translate({F(feature.X)} {F(feature.Y)}) scale({F(scale)})";
    }

    private static string BuildingRoofPath(VillageBuildingGlyph building) =>
        $"M {F(building.X + 5)} {F(building.CenterY)} H {F(building.X + building.Width - 5)} M {F(building.CenterX)} {F(building.Y + 5)} V {F(building.Y + building.Height - 5)}";

    private static string VillageTimberPath(VillageBuildingGlyph building) =>
        $"M {F(building.X + 6)} {F(building.Y + 6)} L {F(building.X + building.Width - 6)} {F(building.Y + building.Height - 6)} M {F(building.X + building.Width - 6)} {F(building.Y + 6)} L {F(building.X + 6)} {F(building.Y + building.Height - 6)}";

    private static string BuildingRotation(VillageBuildingGlyph building) =>
        $"rotate({F(building.Rotation)} {F(building.CenterX)} {F(building.CenterY)})";

    private static string VillageBuildingPath(VillageBuildingGlyph building)
    {
        var random = new Random(building.ShapeSeed);
        var topLeft = 2 + random.NextDouble() * 5;
        var topRight = 2 + random.NextDouble() * 6;
        var bottomRight = 2 + random.NextDouble() * 5;
        var bottomLeft = 2 + random.NextDouble() * 6;
        return $"M {F(building.X + topLeft)} {F(building.Y + 2)} " +
               $"L {F(building.X + building.Width - 2)} {F(building.Y + topRight)} " +
               $"L {F(building.X + building.Width - bottomRight)} {F(building.Y + building.Height - 2)} " +
               $"L {F(building.X + 2)} {F(building.Y + building.Height - bottomLeft)} Z";
    }

    private string BuildVillageRoadPath()
    {
        var phase = new Random(_map.Seed).NextDouble() * Math.PI * 2;
        var points = Enumerable.Range(-1, 9)
            .Select(index =>
            {
                var x = index * 130d;
                var y = 318 + Math.Sin(x / 145 + phase) * 82 + Math.Sin(x / 62 + phase * 0.7) * 18;
                return (X: x, Y: y);
            })
            .ToList();
        var builder = new StringBuilder($"M {F(points[0].X)} {F(points[0].Y)}");
        for (var index = 1; index < points.Count - 1; index++)
        {
            var midpoint = Midpoint(points[index], points[index + 1]);
            builder.Append(" Q ").Append(F(points[index].X)).Append(' ').Append(F(points[index].Y))
                .Append(' ').Append(F(midpoint.X)).Append(' ').Append(F(midpoint.Y));
        }
        return builder.Append(" T ").Append(F(points[^1].X)).Append(' ').Append(F(points[^1].Y)).ToString();
    }

    private async Task ExportMap(string format)
    {
        var fileName = string.Join('-', _map.Name.ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-'));
        while (fileName.Contains("--", StringComparison.Ordinal)) fileName = fileName.Replace("--", "-", StringComparison.Ordinal);
        fileName = fileName.Trim('-');
        if (fileName.Length == 0) fileName = "plan";
        await JS.InvokeVoidAsync("wfrp4DungeonMap.export", SvgId, fileName, format);
    }

    private static bool Intersects(RandomMapArea area, double x, double y, double width, double height) =>
        area.X - 12 < x + width && area.X + area.Width + 12 > x && area.Y - 12 < y + height && area.Y + area.Height + 12 > y;

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string ShortName(string value) => value.Length <= 22 ? value : value[..20] + "…";

    private static string SettlementTerrainFill(string? region)
    {
        if (string.IsNullOrWhiteSpace(region)) return "#91a16f";
        if (region.Contains("Sylvanie", StringComparison.OrdinalIgnoreCase) ||
            region.Contains("Terre des morts", StringComparison.OrdinalIgnoreCase)) return "#737762";
        if (region.Contains("Kislev", StringComparison.OrdinalIgnoreCase) ||
            region.Contains("Norsca", StringComparison.OrdinalIgnoreCase)) return "#87958c";
        if (region.Contains("Averland", StringComparison.OrdinalIgnoreCase)) return "#a6a06b";
        if (region.Contains("Wastelands", StringComparison.OrdinalIgnoreCase)) return "#819681";
        if (region.Contains("Bretonnie", StringComparison.OrdinalIgnoreCase)) return "#88a46f";
        return "#91a16f";
    }

