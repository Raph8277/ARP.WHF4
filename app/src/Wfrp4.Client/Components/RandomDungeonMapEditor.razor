    private static bool PointInPolygon(double x, double y, IReadOnlyList<RandomMapPoint> polygon)
    {
        var inside = false;
        for (var index = 0; index < polygon.Count; index++)
        {
            var current = polygon[index];
            var previous = polygon[(index + polygon.Count - 1) % polygon.Count];
            if ((current.Y > y) == (previous.Y > y)) continue;
            var crossingX = (previous.X - current.X) * (y - current.Y) / (previous.Y - current.Y) + current.X;
            if (x < crossingX) inside = !inside;
        }
        return inside;
    }

    private async Task ExportMap(string format)
    {
        await JS.InvokeVoidAsync("wfrp4DungeonMap.export", SvgId, ProjectFileName(), format);
    }

    private async Task SaveProject()
    {
        var project = new RandomDungeonMapProject
        {
            Map = _map.Clone(),
            AreaCount = _areaCount,
            Loops = _loops,
            ShowGrid = _showGrid,
            ShowLabels = _showLabels,
            ShowFeatures = _showFeatures
        };
        var json = RandomDungeonMapProjectSerializer.Serialize(project);
        await JS.InvokeVoidAsync("wfrp4DungeonMap.downloadText", json, $"{ProjectFileName()}.wfrp-map.json");
        _projectLoadFailed = false;
        _projectMessage = "Projet sauvegardé. Vous pourrez le rouvrir pour poursuivre l’édition.";
    }

    private async Task OpenProject(InputFileChangeEventArgs args)
    {
        _projectMessage = null;
        _projectLoadFailed = false;
        try
        {
            var file = args.File;
            if (file.Size > RandomDungeonMapProjectSerializer.MaxProjectBytes)
            {
                ShowProjectError("Le fichier de projet dépasse la taille maximale de 1 Mio.");
                return;
            }

            await using var stream = file.OpenReadStream(RandomDungeonMapProjectSerializer.MaxProjectBytes);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            if (!RandomDungeonMapProjectSerializer.TryDeserialize(json, out var project, out var error) || project is null)
            {
                ShowProjectError(error);
                return;
            }

            _map = project.Map.Clone();
            if (_map.Kind == RandomMapKind.Village) ConstrainSettlementPlacesAndCache();
            _kind = _map.Kind;
            _seed = _map.Seed;
            _areaCount = project.AreaCount;
            _loops = project.Loops;
            _showGrid = project.ShowGrid;
            _showLabels = project.ShowLabels;
            _showFeatures = project.ShowFeatures;
            _selectedSettlementName = _map.Kind == RandomMapKind.Village &&
                                      Settlements.Any(settlement => settlement.Name == _map.Name)
                ? _map.Name
                : string.Empty;
            _history.Clear();
            _selectedAreaId = _map.Areas[0].Id;
            _selectedFeatureId = null;
            ClearPassageSelection();
            _linkSourceId = null;
            ResetPointerAction();
            _projectMessage = $"Projet « {_map.Name} » ouvert : {_map.Areas.Count} zones éditables restaurées.";
        }
        catch (IOException)
        {
            ShowProjectError("Le projet n’a pas pu être lu. Vérifiez le fichier puis réessayez.");
        }
        finally
        {
            _projectFileInputKey++;
        }
    }

    private void ShowProjectError(string error)
    {
        _projectLoadFailed = true;
        _projectMessage = error;
    }

    private string ProjectFileName()
    {
        var fileName = string.Join('-', _map.Name.ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-'));
        while (fileName.Contains("--", StringComparison.Ordinal)) fileName = fileName.Replace("--", "-", StringComparison.Ordinal);
        fileName = fileName.Trim('-');
        return fileName.Length == 0 ? "plan" : fileName;
    }

    private static bool Intersects(RandomMapArea area, double x, double y, double width, double height) =>
        area.X - 12 < x + width && area.X + area.Width + 12 > x && area.Y - 12 < y + height && area.Y + area.Height + 12 > y;

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string ShortName(string value) => value.Length <= 22 ? value : value[..20] + "…";

    private static string SettlementTerrainFill(string? region)
    {
        if (string.IsNullOrWhiteSpace(region)) return "#91a16f";
        if (region.Contains("Sylvanie", StringComparison.OrdinalIgnoreCase) ||
            region.Contains("Terre des morts", StringComparison.OrdinalIgnoreCase)) return "#737762";
        if (region.Contains("Kislev", StringComparison.OrdinalIgnoreCase) ||
            region.Contains("Norsca", StringComparison.OrdinalIgnoreCase)) return "#87958c";
        if (region.Contains("Averland", StringComparison.OrdinalIgnoreCase)) return "#a6a06b";
        if (region.Contains("Wastelands", StringComparison.OrdinalIgnoreCase)) return "#819681";
        if (region.Contains("Bretonnie", StringComparison.OrdinalIgnoreCase)) return "#88a46f";
        return "#91a16f";
    }

