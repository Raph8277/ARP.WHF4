        if (SelectedArea is null) return;
        SaveSnapshot();
        var localCount = _map.Features.Count(feature => feature.AreaId == SelectedArea.Id);
        var angle = localCount * Math.PI * 0.72;
        var radius = Math.Min(26, 7 + localCount * 4);
        var feature = new RandomMapFeature
        {
            Id = _map.Features.Count == 0 ? 1 : _map.Features.Max(item => item.Id) + 1,
            AreaId = SelectedArea.Id,
            X = SelectedArea.CenterX + Math.Cos(angle) * radius,
            Y = SelectedArea.CenterY + Math.Sin(angle) * radius,
            Kind = _newFeatureKind
        };
        ClampFeatureToArea(feature, SelectedArea);
        _map.Features.Add(feature);
        SelectFeature(feature.Id);
    }

