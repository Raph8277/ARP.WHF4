@using System.Globalization
@using System.Text
@using Wfrp4.Shared.Maps
@inject IJSRuntime JS

<div class="dungeon-editor">
    <div class="dungeon-editor__heading">
        <div>
            <MudText Class="old-world-kicker mb-1">Plans tactiques</MudText>
            <MudText Typo="Typo.h4" Style="font-family:var(--wfrp4-font-heading)">Cartographe du Vieux Monde</MudText>
            <MudText Typo="Typo.body2">Générez un donjon, une grotte, une auberge ou un village, puis façonnez ses espaces, détails et chemins.</MudText>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Casino" OnClick="GenerateMap">
                Générer
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="GenerateSurprise">
                Surprise
            </MudButton>
        </div>
    </div>

    <MudPaper Class="dungeon-editor__settings pa-3" Elevation="0">
        <MudSelect T="RandomMapKind" Value="_kind" ValueChanged="OnKindChanged" Label="Type de plan" Margin="Margin.Dense">
            <MudSelectItem T="RandomMapKind" Value="RandomMapKind.Dungeon">Donjon</MudSelectItem>
            <MudSelectItem T="RandomMapKind" Value="RandomMapKind.Cave">Grotte</MudSelectItem>
            <MudSelectItem T="RandomMapKind" Value="RandomMapKind.Inn">Auberge</MudSelectItem>
            <MudSelectItem T="RandomMapKind" Value="RandomMapKind.Village">Village / ville</MudSelectItem>
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_seed" Label="Graine" Min="1" Max="2147483646" Margin="Margin.Dense" />
        <MudNumericField T="int" @bind-Value="_areaCount" Label="Zones" Min="4" Max="30" Margin="Margin.Dense" />
        <MudSelect T="int" @bind-Value="_loops" Label="Connexions" Margin="Margin.Dense">
            <MudSelectItem T="int" Value="0">Linéaire</MudSelectItem>
            <MudSelectItem T="int" Value="2">Ramifié</MudSelectItem>
            <MudSelectItem T="int" Value="4">Complexe</MudSelectItem>
            <MudSelectItem T="int" Value="6">Labyrinthique</MudSelectItem>
        </MudSelect>
        <MudCheckBox T="bool" @bind-Value="_showGrid" Label="Grille" />
        <MudCheckBox T="bool" @bind-Value="_showLabels" Label="Noms" />
        <MudCheckBox T="bool" Value="_showFeatures" ValueChanged="OnShowFeaturesChanged" Label="Détails" />
    </MudPaper>

    @if (_kind == RandomMapKind.Village && Settlements.Count > 0)
    {
        <MudPaper Class="dungeon-editor__settlement pa-3" Elevation="0">
            <MudSelect T="string" Value="_selectedSettlementName" ValueChanged="OnSettlementChanged"
                       Label="Localité existante" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@string.Empty">Village aléatoire</MudSelectItem>
                @foreach (var settlement in Settlements)
                {
                    <MudSelectItem T="string" Value="settlement.Name">
                        @settlement.Name — @settlement.Type
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="RandomMapSettlementLandscape" Value="CurrentSettlementLandscape" ValueChanged="UpdateSettlementLandscape"
                       Label="Paysage" Margin="Margin.Dense">
                <MudSelectItem T="RandomMapSettlementLandscape" Value="RandomMapSettlementLandscape.Countryside">Campagne</MudSelectItem>
                <MudSelectItem T="RandomMapSettlementLandscape" Value="RandomMapSettlementLandscape.River">Rivière</MudSelectItem>
                <MudSelectItem T="RandomMapSettlementLandscape" Value="RandomMapSettlementLandscape.Port">Port</MudSelectItem>
            </MudSelect>
            @if (SelectedSettlement is not null)
            {
                <div class="dungeon-editor__settlement-info">
                    <MudText Typo="Typo.subtitle1" Style="font-family:var(--wfrp4-font-heading)">@SelectedSettlement.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@SelectedSettlement.Type</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@SelectedSettlement.Population</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@SettlementLayoutLabel</MudChip>
                    <MudText Typo="Typo.caption">@SelectedSettlement.Region — @(_areaCount) lieux structurants représentés</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption">Choisissez une localité du référentiel pour adapter le nom, la région, la population et la densité du plan.</MudText>
            }
        </MudPaper>
    }

    <div class="dungeon-editor__workspace">
        <section class="dungeon-editor__canvas-panel" aria-label="Aperçu du plan">
            <div class="dungeon-editor__canvas-toolbar">
                <MudTextField T="string" Value="_map.Name" ValueChanged="UpdateMapName" Label="Nom de la carte" Margin="Margin.Dense" />
                <div class="d-flex gap-1">
                    <MudIconButton Icon="@Icons.Material.Filled.Undo" Disabled="@(_history.Count == 0)" OnClick="Undo" aria-label="Annuler la dernière modification" />
                    <MudIconButton Icon="@Icons.Material.Filled.AddBox" OnClick="AddArea" Disabled="@(_map.Areas.Count >= 30)" aria-label="Ajouter une zone" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="@(() => ExportMap("svg"))">SVG</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Image" OnClick="@(() => ExportMap("png"))">PNG</MudButton>
                </div>
            </div>

            @if (_linkSourceId is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Cliquez sur une seconde zone pour créer un passage. <MudLink OnClick="CancelLink">Annuler</MudLink>
                </MudAlert>
            }

            <div class="dungeon-editor__canvas-wrap">
                <svg id="@SvgId" class="@CanvasClass" viewBox="0 0 960 640" role="img"
                     aria-label="@($"Plan aléatoire : {_map.Name}")" @onclick="ClearSelection"
                     @onmousemove="OnCanvasMouseMove" @onmouseup="EndPointerAction" @onmouseleave="EndPointerAction">
                    <defs>
                        <pattern id="dungeon-small-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#80745f" stroke-width="0.65" opacity="0.34" />
                        </pattern>
                        <pattern id="dungeon-large-grid" width="100" height="100" patternUnits="userSpaceOnUse">
                            <rect width="100" height="100" fill="url(#dungeon-small-grid)" />
                            <path d="M 100 0 L 0 0 0 100" fill="none" stroke="#5d5242" stroke-width="1.2" opacity="0.38" />
                        </pattern>
                        <pattern id="village-fields" width="120" height="90" patternUnits="userSpaceOnUse" patternTransform="rotate(-7)">
                            <path d="M 0 18 H 120 M 0 36 H 120 M 0 54 H 120 M 0 72 H 120" fill="none" stroke="#65734d" stroke-width="1.5" opacity="0.3" />
                            <path d="M 20 0 V 90 M 80 0 V 90" fill="none" stroke="#c6b27a" stroke-width="1" opacity="0.22" />
                        </pattern>
                        <pattern id="inn-planks" width="34" height="34" patternUnits="userSpaceOnUse">
                            <path d="M 0 8 H 34 M 0 25 H 34 M 12 8 V 25 M 27 0 V 8 M 24 25 V 34" fill="none" stroke="#725238" stroke-width="1" opacity="0.28" />
                        </pattern>
                        <pattern id="dungeon-masonry" width="72" height="44" patternUnits="userSpaceOnUse">
                            <path d="M 0 2 H 72 M 0 23 H 72 M 0 43 H 72 M 17 2 V 23 M 55 2 V 23 M 35 23 V 43 M 68 23 V 43"
                                  fill="none" stroke="#403a32" stroke-width="1.4" opacity="0.38" />
                            <path d="M 3 7 L 12 5 M 43 29 L 51 32 M 61 15 L 67 12" stroke="#a69a83" stroke-width="1" opacity="0.22" />
                        </pattern>
                        <linearGradient id="harbor-water" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#63a9b5" />
                            <stop offset="55%" stop-color="#3d8799" />
                            <stop offset="100%" stop-color="#285f75" />
                        </linearGradient>
                        <filter id="dungeon-shadow" x="-20%" y="-20%" width="140%" height="140%">
                            <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#000" flood-opacity="0.45" />
                        </filter>
                        <filter id="village-grain" x="-5%" y="-5%" width="110%" height="110%">
                            <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="3" seed="@(_map.Seed % 97)" result="noise" />
                            <feColorMatrix in="noise" type="saturate" values="0" result="grain" />
                            <feBlend in="SourceGraphic" in2="grain" mode="soft-light" />
                        </filter>
                    </defs>

                    <rect width="960" height="640" fill="@CanvasFill" />
                    @if (_map.Kind == RandomMapKind.Dungeon)
                    {
                        <rect width="960" height="640" fill="url(#dungeon-masonry)" opacity="0.78" />
                        <path d="@DungeonCrackPath(0)" fill="none" stroke="#29251f" stroke-width="3" opacity="0.48" />
                        <path d="@DungeonCrackPath(1)" fill="none" stroke="#29251f" stroke-width="2" opacity="0.42" />
                        <path d="@DungeonCrackPath(2)" fill="none" stroke="#29251f" stroke-width="2.5" opacity="0.38" />
                    }
                    else if (_map.Kind == RandomMapKind.Village)
                    {
                        <rect width="960" height="640" fill="url(#village-fields)" opacity="0.64" filter="url(#village-grain)" />
                        @if (ShowHarbor)
                        {
                            <path d="@HarborWaterPath" fill="url(#harbor-water)" stroke="#294f59" stroke-width="7" filter="url(#dungeon-shadow)" />
                            <path d="@HarborShorePath" fill="none" stroke="#d9c58f" stroke-width="10" opacity="0.74" />
                        }
                        @foreach (var tree in VillageTrees())
                        {
                            <g transform="translate(@F(tree.X) @F(tree.Y)) scale(@F(tree.Scale))" opacity="0.82" pointer-events="none">
                                <path d="M 0 3 V 14" stroke="#644529" stroke-width="3" />
                                <circle cy="-2" r="10" fill="#4f7045" stroke="#30452d" stroke-width="2" />
                                <circle cx="-6" cy="1" r="6" fill="#607f50" opacity="0.88" />
                            </g>
                        }
                        @if (ShowRiver)
                        {
                            <path d="@VillageStreamPath" fill="none" stroke="#4e6f77" stroke-width="20" stroke-linecap="round" opacity="0.68" />
                            <path d="@VillageStreamPath" fill="none" stroke="#9ab1ad" stroke-width="8" stroke-linecap="round" opacity="0.64" />
                        }
                        @if (ShowsSettlementWall)
                        {
                            <path d="@SettlementWallPath" fill="rgba(202,183,137,.12)" stroke="#40382e" stroke-width="@SettlementWallOuterWidth"
                                  stroke-linejoin="round" filter="url(#dungeon-shadow)" />
                            <path d="@SettlementWallPath" fill="none" stroke="@SettlementWallFill" stroke-width="@SettlementWallInnerWidth"
                                  stroke-linejoin="round" stroke-dasharray="@(IsPalisadedSettlement ? "11 3" : null)" />
                            @foreach (var tower in SettlementTowers)
                            {
                                <circle cx="@F(tower.X)" cy="@F(tower.Y)" r="@F(tower.Radius)" fill="@SettlementWallFill"
                                        stroke="#40382e" stroke-width="4" filter="url(#dungeon-shadow)" />
                                <circle cx="@F(tower.X)" cy="@F(tower.Y)" r="@F(Math.Max(3, tower.Radius - 6))" fill="none"
                                        stroke="#d6c395" stroke-width="1.5" opacity="0.65" />
                            }
                        }
                        @foreach (var building in SettlementInfillBuildings())
                        {
                            <g transform="@BuildingRotation(building)" opacity="0.92" pointer-events="none">
                                <path d="@VillageBuildingPath(building)" fill="@VillageBuildingFill(RandomMapAreaPurpose.Chamber, building)"
                                      stroke="#4b342a" stroke-width="2" stroke-linejoin="round" />
                                <path d="@BuildingRoofPath(building)" fill="none" stroke="#4b342a" stroke-width="1.25" opacity="0.7" />
                            </g>
                        }
                        @if (_map.SettlementLayout == RandomMapSettlementLayout.Fortified)
                        {
                            @foreach (var street in FortifiedStreetPaths)
                            {
                                <path d="@street" fill="none" stroke="#755e40" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" opacity="0.76" />
                                <path d="@street" fill="none" stroke="#cdb581" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" opacity="0.98" />
                            }
                            <ellipse cx="480" cy="320" rx="47" ry="34" fill="#cdb581" stroke="#755e40" stroke-width="5" opacity="0.96" />
                            <ellipse cx="480" cy="320" rx="31" ry="20" fill="none" stroke="#e0ca94" stroke-width="2" stroke-dasharray="3 5" />
                        }
                        @if (_map.SettlementLayout != RandomMapSettlementLayout.Fortified)
                        {
                            <path d="@VillageMainRoadPath" fill="none" stroke="#65513a" stroke-width="@VillageRoadBorderWidth" stroke-linecap="round" opacity="0.7" />
                            <path d="@VillageMainRoadPath" fill="none" stroke="#b49a6b" stroke-width="@VillageRoadWidth" stroke-linecap="round" opacity="0.96" />
                            <path d="@VillageMainRoadPath" fill="none" stroke="#d0b985" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round" opacity="0.58" />
                        }
                        @if (ShowHarbor)
                        {
                            @foreach (var dock in HarborDocks)
                            {
                                <path d="@dock" fill="none" stroke="#4c3424" stroke-width="11" stroke-linecap="square" />
                                <path d="@dock" fill="none" stroke="#9a6d43" stroke-width="6" stroke-dasharray="2 4" />
                            }
                            <path d="M 735 535 q 18 -12 36 0 l -5 18 q -13 8 -26 0 Z" fill="#795138" stroke="#302015" stroke-width="3" />
                            <path d="M 842 485 q 15 -10 31 1 l -5 16 q -11 7 -23 0 Z" fill="#795138" stroke="#302015" stroke-width="3" />
                        }
                    }
                    else if (_map.Kind == RandomMapKind.Inn)
                    {
                        <path d="M 72 45 L 892 54 L 882 593 L 68 584 Z" fill="#8c6a49" stroke="#2d2118" stroke-width="12" filter="url(#dungeon-shadow)" />
                        <path d="M 83 59 L 879 66 L 870 579 L 82 570 Z" fill="url(#inn-planks)" stroke="#b69365" stroke-width="3" />
                    }
                    @if (_showGrid)
                    {
                        <rect width="960" height="640" fill="url(#dungeon-large-grid)" />
                    }

                    @foreach (var passage in _map.Passages)
                    {
                        var from = AreaById(passage.FromAreaId);
                        var to = AreaById(passage.ToAreaId);
                        if (from is not null && to is not null)
                        {
                            var path = PassagePath(from, to, passage);
                            var passageSelected = IsSelectedPassage(passage);
                            @if (passageSelected)
                            {
                                <path d="@path" fill="none" stroke="#e2bf5b" stroke-width="@PassageSelectionWidth" stroke-linecap="round" stroke-linejoin="round" opacity="0.9" />
                            }
                            <path d="@path" fill="none" stroke="@PassageBorderColor" stroke-width="@PassageBorderWidth" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="@path" fill="none" stroke="@PassageFill" stroke-width="@PassageInnerWidth"
                                  stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="@(passage.Secret ? "8 7" : null)" />
                            <path d="@path" fill="none" stroke="transparent" stroke-width="34" pointer-events="stroke"
                                  class="dungeon-editor__passage-hit" @onclick="@(() => SelectPassage(passage))" @onclick:stopPropagation="true" />
                        }
                    }

                    @foreach (var area in _map.Areas)
                    {
                        var selected = area.Id == _selectedAreaId;
                        <g class="dungeon-editor__area" @onclick="@(() => SelectArea(area.Id))" @onclick:stopPropagation="true"
                           @onmousedown="@((MouseEventArgs args) => StartAreaDrag(area.Id, args))" @onmousedown:stopPropagation="true">
                            @if (_map.Kind == RandomMapKind.Dungeon)
                            {
                                <path d="@DungeonRoomPath(area)" fill="@DungeonRoomFill(area.Purpose)"
                                      stroke="@(selected ? "#e2bf5b" : "#1f1b17")" stroke-width="@(selected ? 7 : 5)"
                                      stroke-linejoin="round" filter="url(#dungeon-shadow)" />
                                <path d="@DungeonInnerWallPath(area)" fill="none" stroke="#d0c3a7" stroke-width="1.5"
                                      stroke-dasharray="10 4" opacity="0.45" pointer-events="none" />
                                <path d="@DungeonRoomCrackPath(area)" fill="none" stroke="#554b3e" stroke-width="2"
                                      opacity="0.58" pointer-events="none" />
                            }
                            else if (_map.Kind == RandomMapKind.Village)
                            {
                                @foreach (var building in VillageBuildings(area))
                                {
                                    <g transform="@BuildingRotation(building)">
                                        <path d="@VillageBuildingPath(building)" fill="@VillageBuildingFill(area.Purpose, building)"
                                              stroke="@(selected && building.IsPrimary ? "#e2bf5b" : "#3b281c")"
                                              stroke-width="@(selected && building.IsPrimary ? 5 : 3)"
                                              stroke-linejoin="round" filter="url(#dungeon-shadow)" />
                                        <path d="@BuildingRoofPath(building)" fill="none" stroke="#4b342a" stroke-width="2.1" opacity="0.82" pointer-events="none" />
                                        @if (building.IsPrimary)
                                        {
                                            <path d="@VillageTimberPath(building)" fill="none" stroke="#f0d39b" stroke-width="1.25" opacity="0.48" pointer-events="none" />
                                        }
                                    </g>
                                }
                                @if (selected)
                                {
                                    <rect x="@F(area.X - 5)" y="@F(area.Y - 5)" width="@F(area.Width + 10)" height="@F(area.Height + 10)" rx="8"
                                          fill="none" stroke="#e2bf5b" stroke-width="2" stroke-dasharray="7 5" pointer-events="none" />
                                }
                            }
                            else if (_map.Kind != RandomMapKind.Cave)
                            {
                                <rect x="@F(area.X)" y="@F(area.Y)" width="@F(area.Width)" height="@F(area.Height)" rx="3"
                                      fill="@AreaFill(area.Purpose)" stroke="@(selected ? "#e2bf5b" : "#211b16")"
                                      stroke-width="@(selected ? 6 : 4)" filter="url(#dungeon-shadow)" />
                                <rect x="@F(area.X + 8)" y="@F(area.Y + 8)" width="@F(Math.Max(1, area.Width - 16))" height="@F(Math.Max(1, area.Height - 16))"
                                      fill="none" stroke="#7c6c55" stroke-width="1.2" opacity="0.62" pointer-events="none" />
                            }
                            else
                            {
                                <path d="@CavePath(area)" fill="@AreaFill(area.Purpose)" stroke="@(selected ? "#e2bf5b" : "#211b16")"
                                      stroke-width="@(selected ? 6 : 4)" filter="url(#dungeon-shadow)" />
                            }

                            <foreignObject x="@F(area.CenterX - 70)" y="@F(area.CenterY - 25)" width="140" height="62" pointer-events="none">
                                <div xmlns="http://www.w3.org/1999/xhtml" style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:140px;height:62px;text-align:center;color:#16120e;font-family:Cormorant Garamond,Georgia,serif;font-size:13px;font-weight:700;line-height:1.05">
                                    @if (_map.Kind is RandomMapKind.Dungeon or RandomMapKind.Cave)
                                    {
                                        <span style="display:flex;align-items:center;justify-content:center;width:24px;height:24px;border:1.5px solid #f1e4c8;border-radius:50%;background:@PurposeColor(area.Purpose);color:#fff;font-family:Inter,sans-serif;font-size:12px">@area.Id</span>
                                    }
                                    @if (ShouldShowAreaLabel(area))
                                    {
                                        <span style="margin-top:3px;padding:2px 5px;border-radius:3px;background:rgba(239,222,185,.82);box-shadow:0 1px 2px rgba(30,20,12,.28)">@ShortName(area.Name)</span>
                                    }
                                </div>
                            </foreignObject>
                            @if (selected && _linkSourceId is null)
                            {
                                <rect x="@F(area.X + area.Width - 8)" y="@F(area.Y + area.Height - 8)" width="18" height="18" rx="3"
                                      class="dungeon-editor__resize-handle" fill="#e2bf5b" stroke="#211b16" stroke-width="3"
                                      @onmousedown="@((MouseEventArgs args) => StartAreaResize(area.Id, args))" @onmousedown:stopPropagation="true"
                                      @onclick:stopPropagation="true" />
                            }
                        </g>
                    }

                    @if (_showFeatures)
                    {
                        @foreach (var feature in _map.Features)
                        {
                            var featureSelected = feature.Id == _selectedFeatureId;
                            <g transform="@FeatureTransform(feature)" class="dungeon-editor__feature"
                           role="button" aria-label="@FeatureLabel(feature.Kind)"
                           @onmousedown="@((MouseEventArgs args) => StartFeatureDrag(feature.Id, args))" @onmousedown:stopPropagation="true"
                           @onclick="@(() => SelectFeature(feature.Id))" @onclick:stopPropagation="true">
                            @if (featureSelected)
                            {
                                <circle r="20" fill="none" stroke="#e2bf5b" stroke-width="4" stroke-dasharray="5 3" />
                            }
                            <circle r="14" fill="#f1e4c8" stroke="#211b16" stroke-width="2.5" />
                            @switch (feature.Kind)
                            {
                                case RandomMapFeatureKind.Chest:
                                    <rect x="-8" y="-5" width="16" height="11" rx="2" fill="#8a532b" stroke="#2d1b10" stroke-width="2" />
                                    <path d="M -8 -4 Q 0 -11 8 -4 M 0 -4 V 6" fill="none" stroke="#e2bf5b" stroke-width="2" />
                                    break;
                                case RandomMapFeatureKind.Npc:
                                    <circle cy="-5" r="4" fill="#6d3e32" />
                                    <path d="M -7 8 Q 0 -1 7 8" fill="#355f6b" stroke="#211b16" stroke-width="1.5" />
                                    break;
                                case RandomMapFeatureKind.Light:
                                    <circle r="5" fill="#ffd45c" />
                                    <path d="M 0 -11 V -7 M 0 7 V 11 M -11 0 H -7 M 7 0 H 11 M -8 -8 L -5 -5 M 5 5 L 8 8 M 8 -8 L 5 -5 M -5 5 L -8 8" stroke="#c46e22" stroke-width="2" />
                                    break;
                                case RandomMapFeatureKind.Well:
                                    <circle r="9" fill="#5e6d6f" stroke="#29231d" stroke-width="2" />
                                    <circle r="5" fill="#4f8795" stroke="#b6c9c7" stroke-width="1.5" />
                                    break;
                                case RandomMapFeatureKind.Trap:
                                    <path d="M 0 -9 L 10 8 H -10 Z" fill="#a63228" stroke="#32140f" stroke-width="2" />
                                    <path d="M 0 -4 V 3 M 0 6 V 7" stroke="#fff" stroke-width="2" />
                                    break;
                                case RandomMapFeatureKind.Altar:
                                    <rect x="-9" y="-6" width="18" height="12" fill="#77706a" stroke="#25211e" stroke-width="2" />
                                    <path d="M 0 -10 V 5 M -5 -5 H 5" stroke="#e7d9ba" stroke-width="2" />
                                    break;
                                case RandomMapFeatureKind.Stairs:
                                    <path d="M -9 8 H 9 M -7 3 H 9 M -5 -2 H 9 M -3 -7 H 9" stroke="#41372c" stroke-width="2.5" />
                                    break;
                                case RandomMapFeatureKind.Campfire:
                                    <path d="M -8 8 L 8 -3 M -8 -3 L 8 8" stroke="#493021" stroke-width="3" />
                                    <path d="M 0 5 C -8 0 -3 -9 1 -11 C 0 -5 9 -2 4 5 Z" fill="#e06a27" stroke="#8d2d18" stroke-width="1.5" />
                                    break;
                                case RandomMapFeatureKind.Table:
                                    <rect x="-9" y="-6" width="18" height="12" rx="2" fill="#815432" stroke="#2d1b10" stroke-width="2" />
                                    <circle cx="-5" cy="0" r="1.5" fill="#e2bf5b" /><circle cx="5" cy="0" r="1.5" fill="#e2bf5b" />
                                    break;
                                case RandomMapFeatureKind.Bed:
                                    <rect x="-8" y="-10" width="16" height="20" rx="2" fill="#8b4c45" stroke="#2d1b10" stroke-width="2" />
                                    <rect x="-6" y="-8" width="12" height="5" rx="1" fill="#eadfca" />
                                    break;
                                case RandomMapFeatureKind.Barrel:
