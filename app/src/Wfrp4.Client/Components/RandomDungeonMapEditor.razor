    private static string VillageBuildingFill(RandomMapAreaPurpose purpose, VillageBuildingGlyph building)
    {
        if (building.IsPrimary && purpose != RandomMapAreaPurpose.Chamber)
        {
            return purpose switch
            {
                RandomMapAreaPurpose.Entrance => "#9d7653",
                RandomMapAreaPurpose.Hazard => "#79584a",
                RandomMapAreaPurpose.Treasure => "#b08b4e",
                RandomMapAreaPurpose.Shrine => "#79717f",
                RandomMapAreaPurpose.Exit => "#8a735d",
                _ => "#a86f4d"
            };
        }

        string[] roofs = ["#a85f49", "#bd7654", "#6f8991", "#8d6d59", "#b18a63", "#79554a"];
        return roofs[(int)((uint)building.ShapeSeed % roofs.Length)];
    }

