                    @if (_map.Kind == RandomMapKind.Village)
                    {
                        <g pointer-events="none">
                            <rect x="8" y="8" width="944" height="624" rx="4" fill="none" stroke="#3b2a1c" stroke-width="8" opacity="0.88" />
                            <rect x="17" y="17" width="926" height="606" rx="3" fill="none" stroke="#d6bd83" stroke-width="2" opacity="0.72" />
                            <rect x="27" y="24" width="245" height="34" rx="4" fill="#e9dab0" stroke="#5e4932" stroke-width="2" opacity="0.9" />
                            <path d="M 900 52 v 54 M 873 79 h 54 M 882 61 l 36 36 M 918 61 l -36 36" stroke="#33261c" stroke-width="3" />
                            <text x="900" y="46" text-anchor="middle" fill="#33261c" font-family="Cormorant Garamond,Georgia,serif" font-size="18" font-weight="700">N</text>
                            <text x="39" y="48" fill="#33261c" font-family="Cormorant Garamond,Georgia,serif" font-size="22" font-weight="700">@ShortName(_map.Name)</text>
