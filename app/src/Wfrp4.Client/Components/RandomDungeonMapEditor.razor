            </div>
        </section>

        <aside class="dungeon-editor__inspector">
            @if (SelectedPassage is not null)
            {
                var passage = SelectedPassage;
                var from = AreaById(passage.FromAreaId);
                var to = AreaById(passage.ToAreaId);
                <MudText Class="old-world-kicker">Passage</MudText>
                <MudText Typo="Typo.h5" Class="mb-3" Style="font-family:var(--wfrp4-font-heading)">
