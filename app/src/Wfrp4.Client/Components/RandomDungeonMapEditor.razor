    private async Task StartPointerAction(PointerAction action, int targetId, MouseEventArgs args)
    {
        var scale = await JS.InvokeAsync<double[]>("wfrp4DungeonMap.measure", SvgId);
        _svgScaleX = scale.Length > 0 && scale[0] > 0 ? scale[0] : 1;
        _svgScaleY = scale.Length > 1 && scale[1] > 0 ? scale[1] : _svgScaleX;
        _pointerAction = action;
        _pointerTargetId = targetId;
        _lastClientX = args.ClientX;
        _lastClientY = args.ClientY;
        _pointerChanged = false;
        _pointerSnapshot = _map.Clone();
    }

    private void OnCanvasMouseMove(MouseEventArgs args)
    {
        if (_pointerAction == PointerAction.None) return;
        var deltaX = (args.ClientX - _lastClientX) / _svgScaleX;
        var deltaY = (args.ClientY - _lastClientY) / _svgScaleY;
        _lastClientX = args.ClientX;
        _lastClientY = args.ClientY;
        if (Math.Abs(deltaX) < 0.01 && Math.Abs(deltaY) < 0.01) return;

        if (!_pointerChanged && _pointerSnapshot is not null)
        {
            PushSnapshot(_pointerSnapshot);
            _pointerChanged = true;
        }

        switch (_pointerAction)
        {
            case PointerAction.MoveArea:
                var area = AreaById(_pointerTargetId);
                if (area is not null) MoveAreaAndFeatures(area, deltaX, deltaY);
                break;
            case PointerAction.ResizeArea:
                ResizeArea(_pointerTargetId, deltaX, deltaY);
                break;
            case PointerAction.MoveFeature:
                MoveFeature(_pointerTargetId, deltaX, deltaY);
                break;
        }
    }

    private void ResizeArea(int areaId, double deltaX, double deltaY)
    {
        var area = AreaById(areaId);
        if (area is null) return;
        area.Width = Math.Clamp(area.Width + deltaX, 60, RandomDungeonMap.CanvasWidth - area.X - 12);
        area.Height = Math.Clamp(area.Height + deltaY, 44, RandomDungeonMap.CanvasHeight - area.Y - 12);
        foreach (var feature in _map.Features.Where(feature => feature.AreaId == areaId))
            ClampFeatureToArea(feature, area);
    }

    private void MoveFeature(int featureId, double deltaX, double deltaY)
    {
        var feature = _map.Features.FirstOrDefault(item => item.Id == featureId);
        var area = feature is null ? null : AreaById(feature.AreaId);
        if (feature is null || area is null) return;
        feature.X += deltaX;
        feature.Y += deltaY;
        ClampFeatureToArea(feature, area);
    }

    private static void ClampFeatureToArea(RandomMapFeature feature, RandomMapArea area)
    {
        const double padding = 14;
        var minX = Math.Min(area.CenterX, area.X + padding);
        var maxX = Math.Max(area.CenterX, area.X + area.Width - padding);
        var minY = Math.Min(area.CenterY, area.Y + padding);
        var maxY = Math.Max(area.CenterY, area.Y + area.Height - padding);
        feature.X = Math.Clamp(feature.X, minX, maxX);
        feature.Y = Math.Clamp(feature.Y, minY, maxY);
    }

    private void EndPointerAction(MouseEventArgs args) => ResetPointerAction();

    private void ResetPointerAction()
    {
        _pointerAction = PointerAction.None;
        _pointerTargetId = 0;
        _pointerChanged = false;
        _pointerSnapshot = null;
    }

