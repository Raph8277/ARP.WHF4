<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Sort.Nom</MudText>
    </TitleContent>
    <DialogContent>
        <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table mb-3">
            <tbody>
                <tr><td><strong>Catégorie</strong></td><td>@Sort.Categorie</td></tr>
                <tr><td><strong>Domaine</strong></td><td>@(Sort.Domaine ?? "—")</td></tr>
                <tr><td><strong>CN</strong></td><td>@(Sort.Cn?.ToString() ?? "—")</td></tr>
                <tr><td><strong>Portée</strong></td><td>@(Sort.Portee ?? "—")</td></tr>
                <tr><td><strong>Cible</strong></td><td>@(Sort.Cible ?? "—")</td></tr>
                <tr><td><strong>Durée</strong></td><td>@(Sort.Duree ?? "—")</td></tr>
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.body2">@Sort.Resume</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Fermer</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public SortReferenceDto Sort { get; set; } = null!;

    private void Close() => MudDialog.Close();
}
