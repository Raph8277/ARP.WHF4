@inject Wfrp4ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        Octroyer de l'XP
    </TitleContent>
    <DialogContent>
        <MudNumericField T="int" @bind-Value="_request.Montant" Label="Montant" Min="1" Required="true" Class="mb-2" />
        <MudTextField @bind-Value="_request.Notes" Label="Notes" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annuler</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirmer" Disabled="_submitting">
            Octroyer
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int PersonnageId { get; set; }

    private readonly XPGrantRequest _request = new() { Montant = 50 };
    private bool _submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task Confirmer()
    {
        if (_request.Montant <= 0)
        {
            Snackbar.Add("Le montant doit être supérieur à 0.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            await Api.OctroyerXPAsync(PersonnageId, _request);
            Snackbar.Add("XP octroyée.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}