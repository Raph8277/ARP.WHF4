    private static CreatureStats VaryCreatureStats(BestiaryEntry creature)
        => VaryCreatureStats(creature, creature.Danger);

    private static CreatureStats VaryCreatureStats(BestiaryEntry creature, string targetDanger)
    {
        var variance = targetDanger switch
        {
            "Elevee" => 10,
            "Moyenne" => 7,
            _ => 5,
        };

        var modifier = DangerRank(targetDanger) - DangerRank(creature.Danger);
        var characteristicBonus = modifier * 8;
        var woundsBonus = modifier * 4;

        return new CreatureStats(
            VaryShifted(creature.BaseStats.WS, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.BS, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.S, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.T, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.I, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Ag, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Dex, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Int, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.WP, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Fel, characteristicBonus, variance),
            Math.Max(1, Vary(creature.BaseStats.Wounds + woundsBonus, Math.Max(2, variance / 2))),
            Math.Max(1, Vary(creature.BaseStats.Move, 1)));
    }

    private static int Vary(int value, int variance) =>
        Math.Clamp(value + Random.Shared.Next(-variance, variance + 1), 1, 99);

    private static int VaryShifted(int value, int modifier, int variance) =>
        Math.Clamp(value + modifier + Random.Shared.Next(-variance, variance + 1), 0, 99);

