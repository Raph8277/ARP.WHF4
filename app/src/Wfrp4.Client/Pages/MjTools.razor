            }
        </div>
    </MudTabPanel>
</MudTabs>
</MudPaper>

@code {
    private string? _bestiarySearch;
    private string _pnjSource = "Humanoide";
    private string _pnjTone = "Urbain";
    private string _pnjRole = "Aleatoire";
    private string _pnjPower = "Ordinaire";
    private string _pnjRace = "Aleatoire";
    private string _pnjClass = "Aleatoire";
    private string _pnjCareer = "Aleatoire";
    private string _pnjBestiaryChoice = "Aleatoire";
    private string _pnjDanger = "Aleatoire";
    private string _groupSource = "Humanoide";
    private int _groupSize = 4;
    private string _groupThreat = "Moyenne";
    private string _groupRace = "Aleatoire";
    private string _groupClass = "Aleatoire";
    private string _groupCareer = "Aleatoire";
    private string _groupBestiaryChoice = "Aleatoire";
    private bool _groupSourcesRandom = true;
    private string _lootWealth = "Correcte";
    private string _lootType = "Route";
    private GeneratedNpc? _pnj;
    private GeneratedGroup? _group;
    private GeneratedLoot? _loot;
    private bool _pdfExportEnCours;
    private List<GroupMemberSetup> _groupMemberSetups = [];
    private List<EspeceDto> _especes = [];
    private List<ClasseDto> _classes = [];
    private List<CarriereDto> _carrieres = [];
    private Dictionary<string, CreatureStats> _generatedCreatureStats = [];

    private IEnumerable<BestiaryEntry> FilteredBestiary =>
        Bestiary.Where(c => string.IsNullOrWhiteSpace(_bestiarySearch)
            || c.Name.Contains(_bestiarySearch, StringComparison.OrdinalIgnoreCase)
            || c.Role.Contains(_bestiarySearch, StringComparison.OrdinalIgnoreCase)
            || c.Environment.Contains(_bestiarySearch, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<string> NpcRaceOptions => OptionsFrom(_especes.Select(e => e.Nom), FallbackNpcRaces);
    private IReadOnlyList<string> NpcClassOptions => OptionsFrom(_classes.Select(c => c.Nom), FallbackNpcClasses);

    private IReadOnlyList<string> NpcCareerOptions(string race, string npcClass)
    {
        if (_carrieres.Count == 0)
            return FallbackNpcCareers;

        var careers = AllowedCareers(race, npcClass)
            .Select(c => c.Nom)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n)
            .ToList();

        return ["Aleatoire", .. careers];
    }

    protected override async Task OnInitializedAsync()
    {
        _especes = await Api.GetEspecesAsync() ?? [];
        _classes = await Api.GetClassesAsync() ?? [];
        _carrieres = await Api.GetCarrieresAsync() ?? [];
        ToutGenerer();
    }

    private Task ExporterCreaturePdf(BestiaryEntry creature)
    {
        var stats = CreatureStatsFor(creature);
        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "bestiaire",
            Title = creature.Name,
            Sections =
            [
                new()
                {
                    Title = "Bestiaire",
                    Lines =
                    [
                        Line("Role", creature.Role),
                        Line("Environnement", creature.Environment),
                        Line("Danger", creature.Danger),
                        Line("Profil", creature.Profile),
                        Line("Attaque", creature.Attack),
                        Line("Defense", creature.Defense),
                        Line("Special", creature.Special),
                        Line("Accroche", creature.Hook),
                    ],
                    Stats = [Stats(creature.Name, creature.Role, creature.Environment, creature.Danger, stats)]
                }
            ]
        });
    }

    private Task ExporterPnjPdf()
    {
        if (_pnj is null)
            return Task.CompletedTask;

        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "pnj",
            Title = _pnj.Name,
            Sections =
            [
                new()
                {
                    Title = "PNJ",
                    Lines =
                    [
                        Line("Role", _pnj.Role),
                        Line("Profession", _pnj.Profession),
                        Line("Origine", _pnj.Origin),
                        Line("Danger", _pnj.Danger),
                        Line("Apparence", _pnj.Appearance),
                        Line("Voix / attitude", _pnj.Manner),
                        Line("Motivation", _pnj.Motivation),
                        Line("Secret", _pnj.Secret),
                        Line("Accroche", _pnj.Hook),
                        Line("Profil rapide", _pnj.Profile),
                    ],
                    Stats = [Stats(_pnj.Name, _pnj.Role, _pnj.Origin, _pnj.Danger, _pnj.Stats)]
                }
            ]
        });
    }

    private Task ExporterGroupePdf()
    {
        if (_group is null)
            return Task.CompletedTask;

        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "groupe-pnj",
            Title = _group.Name,
            Sections =
            [
                new()
                {
                    Title = "Groupe de PNJ",
                    Lines =
                    [
                        Line("Objectif", _group.Objective),
                        Line("Complication", _group.Complication),
                    ],
                    Stats = _group.Members
                        .Select(member => Stats(member.Name, member.Role, member.Origin, member.Danger, member.Stats))
                        .ToList()
                }
            ]
        });
    }

    private Task ExporterButinPdf()
    {
        if (_loot is null)
            return Task.CompletedTask;

        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "butin",
            Title = "Butin et indices",
            Sections =
            [
                new()
                {
                    Title = "Tresor et butin",
                    Lines =
                    [
                        Line("Monnaie", _loot.Coins),
                        Line("Objets", string.Join(", ", _loot.Items)),
                        Line("Indice", _loot.Clue),
                        Line("Complication", _loot.Complication),
                    ]
                }
            ]
        });
    }

    private async Task ExporterMjPdf(MjPdfExportRequest request)
    {
        _pdfExportEnCours = true;
        try
        {
            var content = await Api.ExporterMjPdfAsync(request);
            var fileName = $"atelier-mj-{Slug(request.Type)}-{Slug(request.Title)}.pdf";
            await JS.InvokeVoidAsync("saveWfrp4File", fileName, "application/pdf", Convert.ToBase64String(content));
            Snackbar.Add("PDF MJ genere.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export PDF MJ impossible : {ex.Message}", Severity.Error);
        }
        finally
        {
            _pdfExportEnCours = false;
        }
    }

    private static MjPdfLineDto Line(string label, string value) => new() { Label = label, Value = value };

    private static MjPdfStatsDto Stats(string name, string role, string origin, string danger, CreatureStats stats) => new()
    {
        Name = name,
        Role = role,
        Origin = origin,
        Danger = danger,
        WS = stats.WS,
        BS = stats.BS,
        S = stats.S,
        T = stats.T,
        I = stats.I,
        Ag = stats.Ag,
        Dex = stats.Dex,
        Int = stats.Int,
        WP = stats.WP,
        Fel = stats.Fel,
        Wounds = stats.Wounds,
        Move = stats.Move
    };

    private void ToutGenerer()
    {
        GenererPnj();
        GenererGroupe();
        GenererButin();
    }

    private void Reinitialiser()
    {
        _pnj = null;
        _group = null;
        _loot = null;
        _groupMemberSetups.Clear();
        _generatedCreatureStats.Clear();
    }

    private void GenererPnj()
    {
        if (_pnjSource == "Bestiaire")
        {
            var creature = PickBestiary(_pnjBestiaryChoice, _pnjDanger);
            var bestiaryDanger = _pnjDanger == "Aleatoire" ? creature.Danger : _pnjDanger;
            var stats = VaryCreatureStats(creature, bestiaryDanger);
            _pnj = new GeneratedNpc(
                Name: creature.Name,
                Role: creature.Role,
                Tone: creature.Environment,
                Profession: creature.Profile,
                Origin: "Bestiaire",
                Danger: bestiaryDanger,
                Visual: creature.Visual,
                Appearance: creature.Special,
                Manner: creature.Defense,
                Motivation: creature.Attack,
                Secret: creature.Hook,
                Hook: creature.Hook,
                Stats: stats,
                Profile: $"{creature.Profile}. {creature.Special}");
            return;
        }

        var role = _pnjRole == "Aleatoire" ? Pick(["Allie", "Contact", "Rival", "Adversaire"]) : _pnjRole;
        var profile = ResolveHumanoidProfile(_pnjRace, _pnjClass, _pnjCareer, Pick(ProfessionsByTone[_pnjTone]));
        var danger = DangerFromPower(_pnjPower);
        var power = _pnjPower switch
        {
            "Competent" => "Tests utiles autour de 45-55, 1 talent marquant, moral stable.",
            "Dangereux" => "Tests utiles autour de 55-65, 2 talents marquants, ressources ou garde du corps.",
            _ => "Tests utiles autour de 30-40, 1 specialite simple, moral fragile.",
        };

        _pnj = new GeneratedNpc(
            Name: $"{Pick(FirstNames)} {Pick(LastNames)}",
            Role: role,
            Tone: _pnjTone,
            Profession: profile.Career,
            Origin: $"{profile.Race} - {profile.Class}",
            Danger: danger,
            Visual: "human",
            Appearance: Pick(Appearances),
            Manner: Pick(Manners),
            Motivation: Pick(Motivations),
            Secret: Pick(Secrets),
            Hook: Pick(Hooks),
            Stats: GenerateNpcStats(_pnjPower, role, profile.Career, profile.Race, profile.Class),
            Profile: power);
    }

    private void GenererVariantePnj()
    {
        if (_pnj is null)
        {
            GenererPnj();
            return;
        }

        _pnj = _pnj with
        {
            Appearance = Pick(Appearances),
            Manner = Pick(Manners),
            Stats = _pnj.Origin == "Bestiaire"
                ? VaryCreatureStats(PickBestiary(_pnj.Name, _pnj.Danger), _pnj.Danger)
                : GenerateNpcStats(_pnjPower, _pnj.Role, _pnj.Profession, _pnj.Origin, _pnj.Origin)
        };
    }

    private void GenererGroupe()
    {
        PreparerGroupe();
        DefinirSourcesGroupe();
        GenererGroupeDepuisPreparation();
    }

    private void PreparerGroupe()
    {
        var existing = _groupMemberSetups.ToDictionary(s => s.Order);
        _groupMemberSetups = Enumerable.Range(1, _groupSize)
            .Select(i => existing.TryGetValue(i, out var setup) ? setup : CreateDefaultGroupSetup(i))
            .ToList();
        ReindexGroupSetups();
    }

    private void DefinirSourcesGroupe()
    {
        if (_groupMemberSetups.Count == 0)
            PreparerGroupe();

        foreach (var setup in _groupMemberSetups)
        {
            if (_groupSourcesRandom)
            {
                setup.Source = Pick(["Humanoide", "Bestiaire"]);
                setup.Danger = Pick(["Faible", "Moyenne", "Elevee"]);
                var profile = ResolveHumanoidProfile("Aleatoire", "Aleatoire", "Aleatoire", Pick(GroupRoles[ThreatFromDanger(setup.Danger)]));
                setup.Race = profile.Race;
                setup.Class = profile.Class;
                setup.Career = profile.Career;
                setup.BestiaryChoice = "Aleatoire";
                setup.Quantity = Math.Max(1, setup.Quantity);
            }
            else
            {
                setup.Source = _groupSource == "Mixte" ? Pick(["Humanoide", "Bestiaire"]) : _groupSource;
                setup.Danger = DangerFromThreat(_groupThreat);
                setup.Race = _groupRace;
                setup.Class = _groupClass;
                setup.Career = _groupCareer;
                setup.BestiaryChoice = _groupBestiaryChoice;
                setup.Quantity = Math.Max(1, setup.Quantity);
            }
        }
    }

    private void GenererGroupeDepuisPreparation()
    {
        var baseName = Pick(GroupNames);
        var leader = Pick(FirstNames);

        if (_groupMemberSetups.Count == 0)
            PreparerGroupe();

        if (_groupMemberSetups.All(s => s.Source == "Humanoide" && s.Race == "Aleatoire" && s.Class == "Aleatoire" && s.Career == "Aleatoire" && s.BestiaryChoice == "Aleatoire"))
            DefinirSourcesGroupe();

        var members = _groupMemberSetups
            .OrderBy(s => s.Order)
            .SelectMany(setup => Enumerable.Range(1, Math.Max(1, setup.Quantity)).Select(_ => GenerateGroupMember(setup)))
            .ToList();

        _group = new GeneratedGroup(
            Name: $"{baseName} de {leader}",
            Threat: _groupThreat,
            Objective: Pick(GroupObjectives),
            Members: members,
            Complication: Pick(GroupComplications));
    }

    private void GenererVariantesGroupe()
    {
        if (_group is null)
        {
            GenererGroupe();
            return;
        }

        _group = _group with
        {
            Threat = _groupThreat,
            Members = _groupMemberSetups
                .OrderBy(s => s.Order)
                .SelectMany(setup => Enumerable.Range(1, Math.Max(1, setup.Quantity)).Select(_ => GenerateGroupMember(setup)))
                .ToList()
        };
    }

    private void DupliquerLigneGroupe(GroupMemberSetup setup)
    {
        var index = _groupMemberSetups.IndexOf(setup);
        if (index < 0)
            return;

        _groupMemberSetups.Insert(index + 1, setup.Clone());
        ReindexGroupSetups();
    }

    private void SupprimerLigneGroupe(GroupMemberSetup setup)
    {
        if (_groupMemberSetups.Count <= 1)
            return;

        _groupMemberSetups.Remove(setup);
        ReindexGroupSetups();
    }

    private void ReindexGroupSetups()
    {
        for (var i = 0; i < _groupMemberSetups.Count; i++)
            _groupMemberSetups[i].Order = i + 1;
    }

    private void GenererButin()
    {
        var coins = _lootWealth switch
        {
            "Pauvre" => $"{Roll(2, 10)} sous de cuivre, {Roll(1, 5)} pistoles d'argent",
            "Riche" => $"{Roll(2, 10)} pistoles d'argent, {Roll(1, 5)} couronnes d'or",
            _ => $"{Roll(3, 10)} sous de cuivre, {Roll(2, 10)} pistoles d'argent",
        };

        _loot = new GeneratedLoot(
            Coins: coins,
            Items: PickMany(LootItems[_lootType], 3),
            Clue: Pick(LootClues),
            Complication: Pick(LootComplications));
    }

    private static GroupMemberSetup CreateDefaultGroupSetup(int order) =>
        new()
        {
            Order = order,
            Quantity = 1,
            Source = "Humanoide",
            Danger = "Moyenne",
            Race = "Aleatoire",
            Class = "Aleatoire",
            Career = "Aleatoire",
            BestiaryChoice = "Aleatoire"
        };

    private GeneratedGroupMember GenerateGroupMember(GroupMemberSetup setup, GeneratedGroupMember? previous = null)
    {
        if (setup.Source == "Bestiaire")
        {
            var creature = PickBestiary(previous?.BestiaryName ?? setup.BestiaryChoice, setup.Danger);
            return new GeneratedGroupMember(
                Order: setup.Order,
                Name: creature.Name,
                Role: creature.Role,
                Origin: $"Bestiaire - {creature.Environment}",
                BestiaryName: creature.Name,
                Danger: setup.Danger,
                Visual: creature.Visual,
                Manner: creature.Special,
                Stats: VaryCreatureStats(creature, setup.Danger));
        }

        var threat = ThreatFromDanger(setup.Danger);
        var role = previous?.Role ?? Pick(GroupRoles[threat]);
        var profile = ResolveHumanoidProfile(setup.Race, setup.Class, setup.Career, role);

        return new GeneratedGroupMember(
            Order: setup.Order,
            Name: previous?.Name ?? $"{Pick(FirstNames)} {Pick(LastNames)}",
            Role: profile.Career,
            Origin: $"{profile.Race} - {profile.Class}",
            BestiaryName: null,
            Danger: setup.Danger,
            Visual: "human",
            Manner: Pick(Manners),
            Stats: GenerateGroupMemberStats(threat, profile.Career, profile.Race, profile.Class));
    }

    private CreatureStats CreatureStatsFor(BestiaryEntry creature) =>
        _generatedCreatureStats.TryGetValue(creature.Name, out var stats)
            ? stats
            : creature.BaseStats;

    private void GenererCaracteristiquesCreature(BestiaryEntry creature)
    {
        _generatedCreatureStats[creature.Name] = VaryCreatureStats(creature);
    }

    private static CreatureStats VaryCreatureStats(BestiaryEntry creature)
        => VaryCreatureStats(creature, creature.Danger);

    private static CreatureStats VaryCreatureStats(BestiaryEntry creature, string targetDanger)
    {
        var variance = targetDanger switch
        {
            "Elevee" => 10,
            "Moyenne" => 7,
            _ => 5,
        };

        var modifier = DangerRank(targetDanger) - DangerRank(creature.Danger);
        var characteristicBonus = modifier * 8;
        var woundsBonus = modifier * 4;

        return new CreatureStats(
            VaryShifted(creature.BaseStats.WS, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.BS, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.S, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.T, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.I, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Ag, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Dex, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Int, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.WP, characteristicBonus, variance),
            VaryShifted(creature.BaseStats.Fel, characteristicBonus, variance),
            Math.Max(1, Vary(creature.BaseStats.Wounds + woundsBonus, Math.Max(2, variance / 2))),
            Math.Max(1, Vary(creature.BaseStats.Move, 1)));
    }

    private static int Vary(int value, int variance) =>
        Math.Clamp(value + Random.Shared.Next(-variance, variance + 1), 1, 99);

    private static int VaryShifted(int value, int modifier, int variance) =>
        Math.Clamp(value + modifier + Random.Shared.Next(-variance, variance + 1), 0, 99);

    private static int DangerRank(string danger) => danger switch
    {
        "Elevee" => 3,
        "Moyenne" => 2,
        _ => 1,
    };

    private static string CreaturePortraitClass(BestiaryEntry creature) =>
        $"mj-creature-portrait mj-creature-portrait--{creature.Visual.ToLowerInvariant()}";

    private static string PortraitClass(string visual) =>
        $"mj-creature-portrait {PortraitModifierClass(visual)}";

    private static string PortraitModifierClass(string visual) =>
        $"mj-creature-portrait--{visual.ToLowerInvariant()}";

    private static string InactiveSetupCell(bool inactive) =>
        inactive ? "mj-setup-cell mj-setup-cell--inactive" : "mj-setup-cell";

    private static string CreatureIcon(string visual) => visual switch
    {
        "beast" => Icons.Material.Filled.Pets,
        "undead" => Icons.Material.Filled.NightsStay,
        "chaos" => Icons.Material.Filled.Flare,
        "greenskin" => Icons.Material.Filled.Grass,
        "vermin" => Icons.Material.Filled.BugReport,
        "spirit" => Icons.Material.Filled.AutoAwesome,
        "monster" => Icons.Material.Filled.Warning,
        "human" => Icons.Material.Filled.Person,
        _ => Icons.Material.Filled.Shield,
    };

    private static Color DangerColor(string danger) => danger switch
    {
        "Elevee" => Color.Error,
        "Moyenne" => Color.Warning,
        _ => Color.Success,
    };

    private static Color NpcRoleColor(string role) => role switch
    {
        "Adversaire" => Color.Error,
        "Rival" => Color.Warning,
        "Allie" => Color.Success,
        _ => Color.Info,
    };

    private static Color ThreatColor(string threat) => threat switch
    {
        "Forte" => Color.Error,
        "Moyenne" => Color.Warning,
        _ => Color.Success,
    };

    private static string DangerFromPower(string power) => power switch
    {
        "Dangereux" => "Elevee",
        "Competent" => "Moyenne",
        _ => "Faible",
    };

    private static string DangerFromThreat(string threat) => threat switch
    {
        "Forte" => "Elevee",
        "Moyenne" => "Moyenne",
        _ => "Faible",
    };

    private static string ThreatFromDanger(string danger) => danger switch
    {
        "Elevee" => "Forte",
        "Moyenne" => "Moyenne",
        _ => "Faible",
    };

    private static string PickChoice(string selected, IReadOnlyList<string> values) =>
        selected == "Aleatoire" ? Pick(values) : selected;

    private HumanoidProfile ResolveHumanoidProfile(string raceSelection, string classSelection, string careerSelection, string fallbackCareer)
    {
        if (_especes.Count == 0 || _classes.Count == 0 || _carrieres.Count == 0)
        {
            var fallbackRace = PickChoice(raceSelection, FallbackNpcRacesWithoutRandom);
            var fallbackClass = PickChoice(classSelection, FallbackNpcClassesWithoutRandom);
            var fallbackCareerName = careerSelection == "Aleatoire" ? fallbackCareer : careerSelection;
            return new HumanoidProfile(fallbackRace, fallbackClass, fallbackCareerName);
        }

        var selectedRace = FindEspece(raceSelection);
        var selectedClass = FindClasse(classSelection);
        var selectedCareer = FindCarriere(careerSelection);

        if (selectedCareer is not null
            && (selectedClass is null || selectedCareer.ClasseId == selectedClass.Id)
            && (selectedRace is null || IsCareerAllowedForRace(selectedCareer, selectedRace)))
        {
            var race = selectedRace ?? PickRaceForCareer(selectedCareer);
            var npcClass = _classes.FirstOrDefault(c => c.Id == selectedCareer.ClasseId) ?? selectedClass ?? Pick(_classes);
            return new HumanoidProfile(race.Nom, npcClass.Nom, selectedCareer.Nom);
        }

        var candidates = AllowedCareers(raceSelection, classSelection).ToList();
        if (candidates.Count == 0 && selectedRace is not null)
            candidates = _carrieres.Where(c => IsCareerAllowedForRace(c, selectedRace)).ToList();
        if (candidates.Count == 0)
            candidates = _carrieres.ToList();

        var career = candidates.Count > 0 ? Pick(candidates) : null;
        if (career is null)
            return new HumanoidProfile(PickChoice(raceSelection, FallbackNpcRacesWithoutRandom), PickChoice(classSelection, FallbackNpcClassesWithoutRandom), fallbackCareer);

        var resolvedRace = selectedRace is not null && IsCareerAllowedForRace(career, selectedRace)
            ? selectedRace
            : PickRaceForCareer(career);
        var resolvedClass = _classes.FirstOrDefault(c => c.Id == career.ClasseId) ?? selectedClass ?? Pick(_classes);

        return new HumanoidProfile(resolvedRace.Nom, resolvedClass.Nom, career.Nom);
    }

    private IEnumerable<CarriereDto> AllowedCareers(string raceSelection, string classSelection)
    {
        if (_carrieres.Count == 0)
            return [];

        var selectedRace = FindEspece(raceSelection);
        var selectedClass = FindClasse(classSelection);

        return _carrieres
            .Where(c => selectedClass is null || c.ClasseId == selectedClass.Id)
            .Where(c => selectedRace is null || IsCareerAllowedForRace(c, selectedRace))
            .OrderBy(c => c.Nom);
    }

    private EspeceDto PickRaceForCareer(CarriereDto career)
    {
        var candidates = career.EspecesAutorisees.Count == 0
            ? _especes
            : _especes.Where(e => career.EspecesAutorisees.Contains(e.Code)).ToList();

        return candidates.Count > 0 ? Pick(candidates) : Pick(_especes);
    }

    private EspeceDto? FindEspece(string name) =>
        name == "Aleatoire" ? null : _especes.FirstOrDefault(e => string.Equals(e.Nom, name, StringComparison.OrdinalIgnoreCase));

    private ClasseDto? FindClasse(string name) =>
        name == "Aleatoire" ? null : _classes.FirstOrDefault(c => string.Equals(c.Nom, name, StringComparison.OrdinalIgnoreCase));

    private CarriereDto? FindCarriere(string name) =>
        name == "Aleatoire" ? null : _carrieres.FirstOrDefault(c => string.Equals(c.Nom, name, StringComparison.OrdinalIgnoreCase));

    private static bool IsCareerAllowedForRace(CarriereDto career, EspeceDto race) =>
        career.EspecesAutorisees.Count == 0 || career.EspecesAutorisees.Contains(race.Code);

    private static IReadOnlyList<string> OptionsFrom(IEnumerable<string> values, IReadOnlyList<string> fallback)
    {
        var options = values
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();

        return options.Count == 0 ? fallback : ["Aleatoire", .. options];
    }

    private static BestiaryEntry PickBestiary(string selectedName, string danger)
    {
        if (selectedName != "Aleatoire")
            return Bestiary.FirstOrDefault(c => c.Name == selectedName) ?? Bestiary[0];

        var candidates = danger == "Aleatoire"
            ? Bestiary
            : Bestiary.Where(c => c.Danger == danger).ToList();

        return Pick(candidates.Count == 0 ? Bestiary : candidates);
    }

    private static CreatureStats GenerateNpcStats(string power, string role, string profession, string race, string npcClass)
    {
        var baseValue = power switch
        {
            "Dangereux" => 54,
            "Competent" => 44,
            _ => 34,
        };

        var wounds = power switch
        {
            "Dangereux" => 16,
            "Competent" => 12,
            _ => 9,
        };

        return ApplyHumanoidRoleProfile(RandomHumanoidStats(baseValue, 9, wounds, 4), $"{role} {profession} {race} {npcClass}");
    }

    private static CreatureStats GenerateGroupMemberStats(string threat, string role, string race, string npcClass)
    {
        var baseValue = threat switch
        {
            "Forte" => 50,
            "Moyenne" => 40,
            _ => 30,
        };

        var wounds = threat switch
        {
            "Forte" => 15,
            "Moyenne" => 11,
            _ => 8,
        };

        return ApplyHumanoidRoleProfile(RandomHumanoidStats(baseValue, 8, wounds, 4), $"{role} {race} {npcClass}");
    }

    private static CreatureStats RandomHumanoidStats(int baseValue, int variance, int wounds, int move) =>
        new(
            Vary(baseValue, variance),
            Vary(baseValue - 3, variance),
            Vary(baseValue - 2, variance),
            Vary(baseValue + 1, variance),
            Vary(baseValue, variance),
            Vary(baseValue, variance),
            Vary(baseValue - 1, variance),
            Vary(baseValue - 1, variance),
            Vary(baseValue, variance),
            Vary(baseValue - 2, variance),
            Math.Max(1, Vary(wounds, 3)),
            move);

    private static CreatureStats ApplyHumanoidRoleProfile(CreatureStats stats, string role)
    {
        var profile = role.ToLowerInvariant();
        if (profile.Contains("arbaletrier") || profile.Contains("tireur"))
            stats = stats with { BS = Math.Clamp(stats.BS + 10, 1, 99), I = Math.Clamp(stats.I + 3, 1, 99) };

        if (profile.Contains("spadassin") || profile.Contains("duelliste") || profile.Contains("veteran") || profile.Contains("adversaire"))
            stats = stats with { WS = Math.Clamp(stats.WS + 10, 1, 99), WP = Math.Clamp(stats.WP + 5, 1, 99), Wounds = Math.Max(1, stats.Wounds + 2) };

        if (profile.Contains("chef") || profile.Contains("rival"))
            stats = stats with { Fel = Math.Clamp(stats.Fel + 7, 1, 99), WP = Math.Clamp(stats.WP + 5, 1, 99) };

        if (profile.Contains("eclaireur") || profile.Contains("guetteur") || profile.Contains("messager"))
            stats = stats with { Ag = Math.Clamp(stats.Ag + 8, 1, 99), Dex = Math.Clamp(stats.Dex + 5, 1, 99), I = Math.Clamp(stats.I + 5, 1, 99) };

        if (profile.Contains("allie") || profile.Contains("contact") || profile.Contains("intendant") || profile.Contains("precepteur"))
            stats = stats with { Int = Math.Clamp(stats.Int + 6, 1, 99), Fel = Math.Clamp(stats.Fel + 6, 1, 99) };

        if (profile.Contains("fanatique") || profile.Contains("cultiste"))
            stats = stats with { WP = Math.Clamp(stats.WP + 10, 1, 99), Fel = Math.Clamp(stats.Fel - 5, 1, 99) };

        return stats;
    }

    private static T Pick<T>(IReadOnlyList<T> values) => values[Random.Shared.Next(values.Count)];

    private static string Slug(string value)
    {
        var chars = value.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray();
        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }

    private static List<string> PickMany(IReadOnlyList<string> values, int count) =>
        values.OrderBy(_ => Random.Shared.Next()).Take(count).ToList();

    private static int Roll(int dice, int sides)
    {
        var total = 0;
        for (var i = 0; i < dice; i++)
            total += Random.Shared.Next(1, sides + 1);

        return total;
    }

