@page "/mj"
@attribute [Authorize]
@inject Wfrp4ApiClient Api
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Atelier MJ - WFRP4</PageTitle>

<section class="old-world-hero old-world-hero--reference mb-6">
    <div class="d-flex flex-wrap align-center justify-space-between gap-4">
        <div>
            <MudText Class="old-world-kicker">Ecran du MJ</MudText>
            <MudText Typo="Typo.h2" Class="old-world-hero__title">Atelier MJ</MudText>
            <MudText Class="old-world-hero__text">
                Bestiaire, PNJ rapides, groupes d'adversaires et butin pret a poser sur la table.
            </MudText>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Casino"
                       OnClick="ToutGenerer">
                Generer une rencontre
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="Reinitialiser">
                Reinitialiser
            </MudButton>
        </div>
    </div>
</section>

<MudPaper Class="old-world-panel pa-4">
<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="old-world-tabs">
    <MudTabPanel Text="Bestiaire" Icon="@Icons.Material.Filled.MenuBook">
        <div class="old-world-tab-body">
            <MudText Class="old-world-kicker mb-2">Bestiaire</MudText>
            <MudText Typo="Typo.h4" Class="mb-3" Style="font-family: var(--wfrp4-font-heading)">Menaces rapides</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                Selectionnez un profil pour improviser une opposition. Les valeurs restent volontairement compactes pour tenir en partie.
            </MudText>

            <MudTextField T="string" @bind-Value="_bestiarySearch" Label="Rechercher" Dense="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

            <MudExpansionPanels MultiExpansion="true" Class="guide-panels">
                @foreach (var creature in FilteredBestiary)
                {
                    <MudExpansionPanel Text="@creature.Name">
                        @{
                            var stats = CreatureStatsFor(creature);
                        }
                        <div class="mj-creature-card">
                            <div class="@CreaturePortraitClass(creature)">
                                <MudIcon Icon="@CreatureIcon(creature.Visual)" Size="Size.Large" />
                                <span>@creature.Name</span>
                            </div>
                            <div class="mj-creature-card__body">
                                <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                                    <div class="d-flex flex-wrap gap-2">
                                        <MudChip T="string" Color="@DangerColor(creature.Danger)" Variant="Variant.Filled">@creature.Danger</MudChip>
                                        <MudChip T="string" Variant="Variant.Outlined">@creature.Role</MudChip>
                                        <MudChip T="string" Variant="Variant.Outlined">@creature.Environment</MudChip>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Casino"
                                                   OnClick="@(() => GenererCaracteristiquesCreature(creature))">
                                            Generer variante
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.PictureAsPdf" Disabled="_pdfExportEnCours"
                                                   OnClick="@(() => ExporterCreaturePdf(creature))">
                                            Export PDF
                                        </MudButton>
                                    </div>
                                </div>
                                <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table mb-3">
                                    <thead>
                                        <tr>
                                            <th>CC</th><th>CT</th><th>F</th><th>E</th><th>I</th><th>Ag</th><th>Dex</th><th>Int</th><th>FM</th><th>Soc</th><th>B</th><th>M</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>@stats.WS</td><td>@stats.BS</td><td>@stats.S</td><td>@stats.T</td><td>@stats.I</td><td>@stats.Ag</td><td>@stats.Dex</td><td>@stats.Int</td><td>@stats.WP</td><td>@stats.Fel</td><td>@stats.Wounds</td><td>@stats.Move</td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                                <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table mb-3">
                                    <tbody>
                                        <tr><td><strong>Profil</strong></td><td>@creature.Profile</td></tr>
                                        <tr><td><strong>Attaque</strong></td><td>@creature.Attack</td></tr>
                                        <tr><td><strong>Defense</strong></td><td>@creature.Defense</td></tr>
                                        <tr><td><strong>Special</strong></td><td>@creature.Special</td></tr>
                                    </tbody>
                                </MudSimpleTable>
                                <MudText Typo="Typo.body2">@creature.Hook</MudText>
                            </div>
                        </div>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    </MudTabPanel>

    <MudTabPanel Text="PNJ" Icon="@Icons.Material.Filled.PersonAdd">
        <div class="old-world-tab-body">
            <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
                <div>
                    <MudText Class="old-world-kicker mb-2">PNJ</MudText>
                    <MudText Typo="Typo.h4" Style="font-family: var(--wfrp4-font-heading)">Generation de PNJ</MudText>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="GenererPnj">
                        Generer PNJ
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Casino"
                               OnClick="GenererVariantePnj">
                        Variante
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               Disabled="@(_pnj is null || _pdfExportEnCours)" OnClick="ExporterPnjPdf">
                        Export PDF
                    </MudButton>
                </div>
            </div>

            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_pnjSource" Label="Source" Dense="true">
                        <MudSelectItem Value="@("Humanoide")">Race / classe / carriere</MudSelectItem>
                        <MudSelectItem Value="@("Bestiaire")">Bestiaire</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_pnjTone" Label="Ambiance" Dense="true">
                        <MudSelectItem Value="@("Urbain")">Urbain</MudSelectItem>
                        <MudSelectItem Value="@("Route")">Route</MudSelectItem>
                        <MudSelectItem Value="@("Noble")">Noble</MudSelectItem>
                        <MudSelectItem Value="@("Sombre")">Sombre</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_pnjRole" Label="Role" Dense="true">
                        <MudSelectItem Value="@("Aleatoire")">Aleatoire</MudSelectItem>
                        <MudSelectItem Value="@("Allie")">Allie</MudSelectItem>
                        <MudSelectItem Value="@("Contact")">Contact</MudSelectItem>
                        <MudSelectItem Value="@("Rival")">Rival</MudSelectItem>
                        <MudSelectItem Value="@("Adversaire")">Adversaire</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_pnjPower" Label="Niveau" Dense="true">
                        <MudSelectItem Value="@("Ordinaire")">Ordinaire</MudSelectItem>
                        <MudSelectItem Value="@("Competent")">Competent</MudSelectItem>
                        <MudSelectItem Value="@("Dangereux")">Dangereux</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="_pnjRace" Label="Race" Dense="true" Disabled="@(_pnjSource == "Bestiaire")">
                        @foreach (var race in NpcRaceOptions)
                        {
                            <MudSelectItem Value="@race">@race</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="_pnjClass" Label="Classe" Dense="true" Disabled="@(_pnjSource == "Bestiaire")">
                        @foreach (var npcClass in NpcClassOptions)
                        {
                            <MudSelectItem Value="@npcClass">@npcClass</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="_pnjCareer" Label="Carriere" Dense="true" Disabled="@(_pnjSource == "Bestiaire")">
                        @foreach (var career in NpcCareerOptions(_pnjRace, _pnjClass))
                        {
                            <MudSelectItem Value="@career">@career</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="_pnjBestiaryChoice" Label="Creature" Dense="true" Disabled="@(_pnjSource != "Bestiaire")">
                        <MudSelectItem Value="@("Aleatoire")">Aleatoire</MudSelectItem>
                        @foreach (var creature in Bestiary)
                        {
                            <MudSelectItem Value="@creature.Name">@creature.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="_pnjDanger" Label="Danger" Dense="true">
                        <MudSelectItem Value="@("Aleatoire")">Aleatoire</MudSelectItem>
                        <MudSelectItem Value="@("Faible")">Faible</MudSelectItem>
                        <MudSelectItem Value="@("Moyenne")">Moyenne</MudSelectItem>
                        <MudSelectItem Value="@("Elevee")">Elevee</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudText Class="old-world-kicker mt-2">Armement, equipement et sorts</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_pnjWeaponChoice" Label="Armement" Dense="true">
                        @foreach (var weapon in WeaponOptions)
                        {
                            <MudSelectItem Value="@weapon">@weapon</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_pnjEquipmentChoice" Label="Equipement" Dense="true">
                        @foreach (var equipment in EquipmentOptions)
                        {
                            <MudSelectItem Value="@equipment">@equipment</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_pnjSpellChoice" Label="Sort" Dense="true">
                        @foreach (var spell in SpellOptions)
                        {
                            <MudSelectItem Value="@spell">@spell</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (_pnj is not null)
            {
                <div class="mj-creature-card">
                    <div class="@PortraitClass(_pnj.Visual)">
                        <MudIcon Icon="@CreatureIcon(_pnj.Visual)" Size="Size.Large" />
                        <span>@_pnj.Name</span>
                    </div>
                    <div class="mj-creature-card__body">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <MudChip T="string" Color="@NpcRoleColor(_pnj.Role)" Variant="Variant.Filled">@_pnj.Role</MudChip>
                            <MudChip T="string" Variant="Variant.Outlined">@_pnj.Profession</MudChip>
                            <MudChip T="string" Variant="Variant.Outlined">@_pnj.Tone</MudChip>
                            <MudChip T="string" Color="@DangerColor(_pnj.Danger)" Variant="Variant.Outlined">@_pnj.Danger</MudChip>
                        </div>
                        <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table mb-3">
                            <thead>
                                <tr>
                                    <th>CC</th><th>CT</th><th>F</th><th>E</th><th>I</th><th>Ag</th><th>Dex</th><th>Int</th><th>FM</th><th>Soc</th><th>B</th><th>M</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@_pnj.Stats.WS</td><td>@_pnj.Stats.BS</td><td>@_pnj.Stats.S</td><td>@_pnj.Stats.T</td><td>@_pnj.Stats.I</td><td>@_pnj.Stats.Ag</td><td>@_pnj.Stats.Dex</td><td>@_pnj.Stats.Int</td><td>@_pnj.Stats.WP</td><td>@_pnj.Stats.Fel</td><td>@_pnj.Stats.Wounds</td><td>@_pnj.Stats.Move</td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                        <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table">
                            <tbody>
                                <tr><td style="width:160px"><strong>Apparence</strong></td><td>@_pnj.Appearance</td></tr>
                                <tr><td><strong>Origine</strong></td><td>@_pnj.Origin</td></tr>
                                <tr><td><strong>Voix / attitude</strong></td><td>@_pnj.Manner</td></tr>
                                <tr><td><strong>Motivation</strong></td><td>@_pnj.Motivation</td></tr>
                                <tr><td><strong>Secret</strong></td><td>@_pnj.Secret</td></tr>
                                <tr><td><strong>Accroche</strong></td><td>@_pnj.Hook</td></tr>
                                <tr><td><strong>Profil rapide</strong></td><td>@_pnj.Profile</td></tr>
                                <tr><td><strong>Armement</strong></td><td>@_pnj.Weapon</td></tr>
                                <tr><td><strong>Equipement</strong></td><td>@_pnj.Equipment</td></tr>
                                <tr><td><strong>Sort</strong></td><td>@_pnj.Spell</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </div>
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true">Generez un PNJ pour obtenir une fiche de scene immediate.</MudAlert>
            }
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Groupes de PNJ" Icon="@Icons.Material.Filled.Groups">
        <div class="old-world-tab-body">
            <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
                <div>
                    <MudText Class="old-world-kicker mb-2">Rencontre</MudText>
                    <MudText Typo="Typo.h4" Style="font-family: var(--wfrp4-font-heading)">Groupe de PNJ</MudText>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Groups"
                               OnClick="GenererGroupe">
                        Generer
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Casino"
                               OnClick="GenererVariantesGroupe">
                        Variantes
                    </MudButton>
                </div>
            </div>

            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12">
                    <MudPaper Class="old-world-panel pa-3" Elevation="0">
                        <MudText Class="old-world-kicker mb-2">Etape 1</MudText>
                        <MudText Typo="Typo.h6" Class="mb-3">Ambiance et nombre de PNJ</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" @bind-Value="_groupTone" Label="Ambiance" Dense="true">
                                    @foreach (var tone in GroupToneOptions)
                                    {
                                        <MudSelectItem Value="@tone">@tone</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="int" @bind-Value="_groupSize" Label="Taille du groupe" Min="1" Max="12" Dense="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Class="old-world-kicker mt-2">Armement, equipement et sorts du groupe</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="_groupWeaponChoice" Label="Armement" Dense="true">
                                    @foreach (var weapon in WeaponOptions)
                                    {
                                        <MudSelectItem Value="@weapon">@weapon</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="_groupEquipmentChoice" Label="Equipement" Dense="true">
                                    @foreach (var equipment in EquipmentOptions)
                                    {
                                        <MudSelectItem Value="@equipment">@equipment</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="_groupSpellChoice" Label="Sort" Dense="true">
                                    @foreach (var spell in SpellOptions)
                                    {
                                        <MudSelectItem Value="@spell">@spell</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3" StartIcon="@Icons.Material.Filled.Check"
                                   OnClick="PreparerGroupe">
                            Valider
                        </MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Class="old-world-panel pa-3" Elevation="0">
                        <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                            <div>
                                <MudText Class="old-world-kicker mb-2">Etape 2</MudText>
                                <MudText Typo="Typo.h6">Sources des membres</MudText>
                            </div>
                            <MudSwitch T="bool" @bind-Value="_groupSourcesRandom" Color="Color.Primary" Label="Sources aleatoires" />
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="_groupThreat" Label="Menace par defaut" Dense="true">
                                    <MudSelectItem Value="@("Faible")">Faible</MudSelectItem>
                                    <MudSelectItem Value="@("Moyenne")">Moyenne</MudSelectItem>
                                    <MudSelectItem Value="@("Forte")">Forte</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="_groupSource" Label="Source par defaut" Dense="true" Disabled="@_groupSourcesRandom">
                                    <MudSelectItem Value="@("Humanoide")">Race / classe / carriere</MudSelectItem>
                                    <MudSelectItem Value="@("Bestiaire")">Bestiaire</MudSelectItem>
                                    <MudSelectItem Value="@("Mixte")">Mixte</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.Casino"
                                           OnClick="DefinirSourcesGroupe">
                                    Definir les sources
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_groupMemberSetups.Count > 0)
                        {
                            <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table mt-3">
                                <thead>
                                    <tr>
                                        <th>#</th><th>Qté</th><th>Source</th><th>Danger</th><th>Race</th><th>Classe</th><th>Carriere</th><th>Bestiaire</th><th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var setup in _groupMemberSetups)
                                    {
                                        <tr>
                                            <td>@setup.Order</td>
                                            <td style="min-width:85px">
                                                <MudNumericField T="int" @bind-Value="setup.Quantity" Min="1" Max="12" Dense="true" Disabled="@_groupSourcesRandom" />
                                            </td>
                                            <td>
                                                <MudSelect T="string" @bind-Value="setup.Source" Dense="true" Disabled="@_groupSourcesRandom">
                                                    <MudSelectItem Value="@("Humanoide")">Humanoide</MudSelectItem>
                                                    <MudSelectItem Value="@("Bestiaire")">Bestiaire</MudSelectItem>
                                                </MudSelect>
                                            </td>
                                            <td>
                                                <MudSelect T="string" @bind-Value="setup.Danger" Dense="true" Disabled="@_groupSourcesRandom">
                                                    <MudSelectItem Value="@("Faible")">Faible</MudSelectItem>
                                                    <MudSelectItem Value="@("Moyenne")">Moyenne</MudSelectItem>
                                                    <MudSelectItem Value="@("Elevee")">Elevee</MudSelectItem>
                                                </MudSelect>
                                            </td>
                                            <td class="@InactiveSetupCell(setup.Source == "Bestiaire")">
                                                <MudSelect T="string" @bind-Value="setup.Race" Dense="true" Disabled="@(_groupSourcesRandom || setup.Source == "Bestiaire")">
                                                    @foreach (var race in NpcRaceOptions)
                                                    {
                                                        <MudSelectItem Value="@race">@race</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                            <td class="@InactiveSetupCell(setup.Source == "Bestiaire")">
                                                <MudSelect T="string" @bind-Value="setup.Class" Dense="true" Disabled="@(_groupSourcesRandom || setup.Source == "Bestiaire")">
                                                    @foreach (var npcClass in NpcClassOptions)
                                                    {
                                                        <MudSelectItem Value="@npcClass">@npcClass</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                            <td class="@InactiveSetupCell(setup.Source == "Bestiaire")">
                                                <MudSelect T="string" @bind-Value="setup.Career" Dense="true" Disabled="@(_groupSourcesRandom || setup.Source == "Bestiaire")">
                                                    @foreach (var career in NpcCareerOptions(setup.Race, setup.Class))
                                                    {
                                                        <MudSelectItem Value="@career">@career</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                            <td class="@InactiveSetupCell(setup.Source == "Humanoide")">
                                                <MudSelect T="string" @bind-Value="setup.BestiaryChoice" Dense="true" Disabled="@(_groupSourcesRandom || setup.Source == "Humanoide")">
                                                    <MudSelectItem Value="@("Aleatoire")">Aleatoire</MudSelectItem>
                                                    @foreach (var creature in Bestiary)
                                                    {
                                                        <MudSelectItem Value="@creature.Name">@creature.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Secondary"
                                                                   Disabled="@_groupSourcesRandom" OnClick="@(() => DupliquerLigneGroupe(setup))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                                   Disabled="@(_groupSourcesRandom || _groupMemberSetups.Count <= 1)" OnClick="@(() => SupprimerLigneGroupe(setup))" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Class="old-world-panel pa-3" Elevation="0">
                        <div class="d-flex flex-wrap align-center justify-space-between gap-3">
                            <div>
                                <MudText Class="old-world-kicker mb-2">Etape 3</MudText>
                                <MudText Typo="Typo.h6">Generation des noms et caracteristiques</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Groups"
                                       OnClick="GenererGroupeDepuisPreparation">
                                Generer le groupe
                            </MudButton>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_group is not null)
            {
                <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-2">
                    <MudText Typo="Typo.h6">@_group.Name</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               Disabled="_pdfExportEnCours" OnClick="ExporterGroupePdf">
                        Export PDF
                    </MudButton>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mb-2">@_group.Tone</MudChip>
                <MudText Typo="Typo.body2" Class="mb-3">@_group.Objective</MudText>
                <MudGrid Spacing="2" Class="mb-3">
                    @foreach (var member in _group.Members)
                    {
                        <MudItem xs="12">
                            <div class="mj-group-member">
                                <div class="mj-group-member__portrait @PortraitModifierClass(member.Visual)">
                                    <MudIcon Icon="@CreatureIcon(member.Visual)" Size="Size.Medium" />
                                </div>
                                <div class="mj-group-member__body">
                                    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-2">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">@member.Name</MudText>
                                            <MudText Typo="Typo.caption">@member.Role - @member.Manner.ToLowerInvariant()</MudText>
                                            <MudText Typo="Typo.caption">@member.Origin</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="@DangerColor(member.Danger)" Variant="Variant.Filled">@member.Danger</MudChip>
                                    </div>
                                    <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table">
                                        <thead>
                                            <tr>
                                                <th>CC</th><th>CT</th><th>F</th><th>E</th><th>I</th><th>Ag</th><th>Dex</th><th>Int</th><th>FM</th><th>Soc</th><th>B</th><th>M</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>@member.Stats.WS</td><td>@member.Stats.BS</td><td>@member.Stats.S</td><td>@member.Stats.T</td><td>@member.Stats.I</td><td>@member.Stats.Ag</td><td>@member.Stats.Dex</td><td>@member.Stats.Int</td><td>@member.Stats.WP</td><td>@member.Stats.Fel</td><td>@member.Stats.Wounds</td><td>@member.Stats.Move</td>
                                            </tr>
                                        </tbody>
                                    </MudSimpleTable>
                                    <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table mt-2">
                                        <tbody>
                                            <tr><td style="width:140px"><strong>Armement</strong></td><td>@member.Weapon</td></tr>
                                            <tr><td><strong>Equipement</strong></td><td>@member.Equipment</td></tr>
                                            <tr><td><strong>Sort</strong></td><td>@member.Spell</td></tr>
                                        </tbody>
                                    </MudSimpleTable>
                                </div>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
                <MudAlert Severity="Severity.Warning" Dense="true">@_group.Complication</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true">Generez un groupe pour improviser une opposition ou une patrouille.</MudAlert>
            }
        </div>
    </MudTabPanel>

    <MudTabPanel Text="Tresors et butin" Icon="@Icons.Material.Filled.Inventory">
        <div class="old-world-tab-body">
            <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
                <div>
                    <MudText Class="old-world-kicker mb-2">Tresor</MudText>
                    <MudText Typo="Typo.h4" Style="font-family: var(--wfrp4-font-heading)">Butin et indices</MudText>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory"
                               OnClick="GenererButin">
                        Generer
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               Disabled="@(_loot is null || _pdfExportEnCours)" OnClick="ExporterButinPdf">
                        Export PDF
                    </MudButton>
                </div>
            </div>

            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="_lootWealth" Label="Richesse" Dense="true">
                        <MudSelectItem Value="@("Misere")">Misere</MudSelectItem>
                        <MudSelectItem Value="@("Pauvre")">Pauvre</MudSelectItem>
                        <MudSelectItem Value="@("Correcte")">Correcte</MudSelectItem>
                        <MudSelectItem Value="@("Riche")">Riche</MudSelectItem>
                        <MudSelectItem Value="@("Exceptionnelle")">Exceptionnelle</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="_lootType" Label="Ambiance" Dense="true">
                        @foreach (var type in LootTypeOptions)
                        {
                            <MudSelectItem Value="@type">@type</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="_lootNature" Label="Nature dominante" Dense="true">
                        @foreach (var nature in LootNatureOptions)
                        {
                            <MudSelectItem Value="@nature">@nature</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="_lootDanger" Label="Danger" Dense="true">
                        @foreach (var danger in LootDangerOptions)
                        {
                            <MudSelectItem Value="@danger">@danger</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="_lootMagicFrequency" Label="Objets magiques" Dense="true">
                        <MudSelectItem Value="@("Jamais")">Jamais</MudSelectItem>
                        <MudSelectItem Value="@("Rare")">Rare</MudSelectItem>
                        <MudSelectItem Value="@("Possible")">Possible</MudSelectItem>
                        <MudSelectItem Value="@("Frequent")">Frequent</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (_loot is not null)
            {
                <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table mb-3">
                    <tbody>
                        <tr><td><strong>Monnaie</strong></td><td>@_loot.Coins</td></tr>
                        <tr><td><strong>Objets</strong></td><td>@string.Join(", ", _loot.Items)</td></tr>
                        <tr><td><strong>Objet utile</strong></td><td>@_loot.UsefulItem</td></tr>
                        <tr><td><strong>Objet magique</strong></td><td>@_loot.MagicItem</td></tr>
                        <tr><td><strong>Effet magique</strong></td><td>@_loot.MagicEffect</td></tr>
                        <tr><td><strong>Risque magique</strong></td><td>@_loot.MagicRisk</td></tr>
                        <tr><td><strong>Valeur</strong></td><td>@_loot.ValueEstimate</td></tr>
                        <tr><td><strong>Proprietaire</strong></td><td>@_loot.Owner</td></tr>
                        <tr><td><strong>Etat</strong></td><td>@_loot.Condition</td></tr>
                        <tr><td><strong>Indice</strong></td><td>@_loot.Clue</td></tr>
                        <tr><td><strong>Complication</strong></td><td>@_loot.Complication</td></tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true">Generez un butin pour recompenser une scene sans casser l'economie.</MudAlert>
            }
        </div>
    </MudTabPanel>
</MudTabs>
</MudPaper>

@code {
    private string? _bestiarySearch;
    private string _pnjSource = "Humanoide";
    private string _pnjTone = "Urbain";
    private string _pnjRole = "Aleatoire";
    private string _pnjPower = "Ordinaire";
    private string _pnjRace = "Aleatoire";
    private string _pnjClass = "Aleatoire";
    private string _pnjCareer = "Aleatoire";
    private string _pnjBestiaryChoice = "Aleatoire";
    private string _pnjDanger = "Aleatoire";
    private string _pnjWeaponChoice = "Aleatoire";
    private string _pnjEquipmentChoice = "Aleatoire";
    private string _pnjSpellChoice = "Aleatoire";
    private string _groupSource = "Humanoide";
    private int _groupSize = 4;
    private string _groupTone = "Urbain";
    private string _groupThreat = "Moyenne";
    private string _groupRace = "Aleatoire";
    private string _groupClass = "Aleatoire";
    private string _groupCareer = "Aleatoire";
    private string _groupBestiaryChoice = "Aleatoire";
    private bool _groupSourcesRandom = true;
    private string _groupWeaponChoice = "Aleatoire";
    private string _groupEquipmentChoice = "Aleatoire";
    private string _groupSpellChoice = "Aleatoire";
    private string _lootWealth = "Correcte";
    private string _lootType = "Route";
    private string _lootNature = "Aleatoire";
    private string _lootDanger = "Aleatoire";
    private string _lootMagicFrequency = "Rare";
    private GeneratedNpc? _pnj;
    private GeneratedGroup? _group;
    private GeneratedLoot? _loot;
    private bool _pdfExportEnCours;
    private List<GroupMemberSetup> _groupMemberSetups = [];
    private List<EspeceDto> _especes = [];
    private List<ClasseDto> _classes = [];
    private List<CarriereDto> _carrieres = [];
    private Dictionary<string, CreatureStats> _generatedCreatureStats = [];

    private IEnumerable<BestiaryEntry> FilteredBestiary =>
        Bestiary.Where(c => string.IsNullOrWhiteSpace(_bestiarySearch)
            || c.Name.Contains(_bestiarySearch, StringComparison.OrdinalIgnoreCase)
            || c.Role.Contains(_bestiarySearch, StringComparison.OrdinalIgnoreCase)
            || c.Environment.Contains(_bestiarySearch, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<string> NpcRaceOptions => OptionsFrom(_especes.Select(e => e.Nom), FallbackNpcRaces);
    private IReadOnlyList<string> NpcClassOptions => OptionsFrom(_classes.Select(c => c.Nom), FallbackNpcClasses);

    private IReadOnlyList<string> NpcCareerOptions(string race, string npcClass)
    {
        if (_carrieres.Count == 0)
            return FallbackNpcCareers;

        var careers = AllowedCareers(race, npcClass)
            .Select(c => c.Nom)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n)
            .ToList();

        return ["Aleatoire", .. careers];
    }

    protected override async Task OnInitializedAsync()
    {
        _especes = await Api.GetEspecesAsync() ?? [];
        _classes = await Api.GetClassesAsync() ?? [];
        _carrieres = await Api.GetCarrieresAsync() ?? [];
        ToutGenerer();
    }

    private Task ExporterCreaturePdf(BestiaryEntry creature)
    {
        var stats = CreatureStatsFor(creature);
        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "bestiaire",
            Title = creature.Name,
            Sections =
            [
                new()
                {
                    Title = "Bestiaire",
                    Lines =
                    [
                        Line("Role", creature.Role),
                        Line("Environnement", creature.Environment),
                        Line("Danger", creature.Danger),
                        Line("Profil", creature.Profile),
                        Line("Attaque", creature.Attack),
                        Line("Defense", creature.Defense),
                        Line("Special", creature.Special),
                        Line("Accroche", creature.Hook),
                    ],
                    Stats = [Stats(creature.Name, creature.Role, creature.Environment, creature.Danger, stats)]
                }
            ]
        });
    }

    private Task ExporterPnjPdf()
    {
        if (_pnj is null)
            return Task.CompletedTask;

        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "pnj",
            Title = _pnj.Name,
            Sections =
            [
                new()
                {
                    Title = "PNJ",
                    Lines =
                    [
                        Line("Role", _pnj.Role),
                        Line("Profession", _pnj.Profession),
                        Line("Origine", _pnj.Origin),
                        Line("Danger", _pnj.Danger),
                        Line("Apparence", _pnj.Appearance),
                        Line("Voix / attitude", _pnj.Manner),
                        Line("Motivation", _pnj.Motivation),
                        Line("Secret", _pnj.Secret),
                        Line("Accroche", _pnj.Hook),
                        Line("Profil rapide", _pnj.Profile),
                        Line("Armement", _pnj.Weapon),
                        Line("Equipement", _pnj.Equipment),
                        Line("Sort", _pnj.Spell),
                    ],
                    Stats = [Stats(_pnj.Name, _pnj.Role, _pnj.Origin, _pnj.Danger, _pnj.Stats)]
                }
            ]
        });
    }

    private Task ExporterGroupePdf()
    {
        if (_group is null)
            return Task.CompletedTask;

        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "groupe-pnj",
            Title = _group.Name,
            Sections =
            [
                new()
                {
                    Title = "Groupe de PNJ",
                    Lines =
                    [
                        Line("Objectif", _group.Objective),
                        Line("Ambiance", _group.Tone),
                        Line("Complication", _group.Complication),
                        .._group.Members.SelectMany(member => new[]
                        {
                            Line($"{member.Name} - armement", member.Weapon),
                            Line($"{member.Name} - equipement", member.Equipment),
                            Line($"{member.Name} - sort", member.Spell),
                        }),
                    ],
                    Stats = _group.Members
                        .Select(member => Stats(member.Name, member.Role, member.Origin, member.Danger, member.Stats))
                        .ToList()
                }
            ]
        });
    }

    private Task ExporterButinPdf()
    {
        if (_loot is null)
            return Task.CompletedTask;

        return ExporterMjPdf(new MjPdfExportRequest
        {
            Type = "butin",
            Title = "Butin et indices",
            Sections =
            [
                new()
                {
                    Title = "Tresor et butin",
                    Lines =
                    [
                        Line("Ambiance", _loot.Context),
                        Line("Nature", _loot.Nature),
                        Line("Danger", _loot.Danger),
                        Line("Monnaie", _loot.Coins),
                        Line("Objets", string.Join(", ", _loot.Items)),
                        Line("Objet utile", _loot.UsefulItem),
                        Line("Objet magique", _loot.MagicItem),
                        Line("Effet magique", _loot.MagicEffect),
                        Line("Risque magique", _loot.MagicRisk),
                        Line("Valeur", _loot.ValueEstimate),
                        Line("Proprietaire", _loot.Owner),
                        Line("Etat", _loot.Condition),
                        Line("Indice", _loot.Clue),
                        Line("Complication", _loot.Complication),
                    ]
                }
            ]
        });
    }

    private async Task ExporterMjPdf(MjPdfExportRequest request)
    {
        _pdfExportEnCours = true;
        try
        {
            var content = await Api.ExporterMjPdfAsync(request);
            var fileName = $"atelier-mj-{Slug(request.Type)}-{Slug(request.Title)}.pdf";
            await JS.InvokeVoidAsync("saveWfrp4File", fileName, "application/pdf", Convert.ToBase64String(content));
            Snackbar.Add("PDF MJ genere.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export PDF MJ impossible : {ex.Message}", Severity.Error);
        }
        finally
        {
            _pdfExportEnCours = false;
        }
    }

    private static MjPdfLineDto Line(string label, string value) => new() { Label = label, Value = value };

    private static MjPdfStatsDto Stats(string name, string role, string origin, string danger, CreatureStats stats) => new()
    {
        Name = name,
        Role = role,
        Origin = origin,
        Danger = danger,
        WS = stats.WS,
        BS = stats.BS,
        S = stats.S,
        T = stats.T,
        I = stats.I,
        Ag = stats.Ag,
        Dex = stats.Dex,
        Int = stats.Int,
        WP = stats.WP,
        Fel = stats.Fel,
        Wounds = stats.Wounds,
        Move = stats.Move
    };

    private void ToutGenerer()
    {
        GenererPnj();
        GenererGroupe();
        GenererButin();
    }

    private void Reinitialiser()
    {
        _pnj = null;
        _group = null;
        _loot = null;
        _groupMemberSetups.Clear();
        _generatedCreatureStats.Clear();
    }

    private void GenererPnj()
    {
        if (_pnjSource == "Bestiaire")
        {
            var creature = PickBestiary(_pnjBestiaryChoice, _pnjDanger);
            var bestiaryDanger = _pnjDanger == "Aleatoire" ? creature.Danger : _pnjDanger;
            var stats = VaryCreatureStats(creature, bestiaryDanger);
            var loadout = GenerateLoadout(
                _pnjTone,
                creature.Profile,
                creature.Visual,
                _pnjWeaponChoice,
                _pnjEquipmentChoice,
                _pnjSpellChoice,
                creature.Attack,
                creature.Defense);
            _pnj = new GeneratedNpc(
                Name: creature.Name,
                Role: creature.Role,
                Tone: creature.Environment,
                Profession: creature.Profile,
                Origin: "Bestiaire",
                Danger: bestiaryDanger,
                Visual: creature.Visual,
                Appearance: creature.Special,
                Manner: creature.Defense,
                Motivation: creature.Attack,
                Secret: creature.Hook,
                Hook: creature.Hook,
                Stats: stats,
                Profile: $"{creature.Profile}. {creature.Special}",
                Weapon: loadout.Weapon,
                Equipment: loadout.Equipment,
                Spell: loadout.Spell);
            return;
        }

        var role = _pnjRole == "Aleatoire" ? Pick(["Allie", "Contact", "Rival", "Adversaire"]) : _pnjRole;
        var profile = ResolveHumanoidProfile(_pnjRace, _pnjClass, _pnjCareer, Pick(ProfessionsByTone[_pnjTone]));
        var danger = DangerFromPower(_pnjPower);
        var humanoidLoadout = GenerateLoadout(
            _pnjTone,
            profile.Career,
            "human",
            _pnjWeaponChoice,
            _pnjEquipmentChoice,
            _pnjSpellChoice);
        var power = _pnjPower switch
        {
            "Competent" => "Tests utiles autour de 45-55, 1 talent marquant, moral stable.",
            "Dangereux" => "Tests utiles autour de 55-65, 2 talents marquants, ressources ou garde du corps.",
            _ => "Tests utiles autour de 30-40, 1 specialite simple, moral fragile.",
        };

        _pnj = new GeneratedNpc(
            Name: $"{Pick(FirstNames)} {Pick(LastNames)}",
            Role: role,
            Tone: _pnjTone,
            Profession: profile.Career,
            Origin: $"{profile.Race} - {profile.Class}",
            Danger: danger,
            Visual: "human",
            Appearance: Pick(Appearances),
            Manner: Pick(Manners),
            Motivation: Pick(Motivations),
            Secret: Pick(Secrets),
            Hook: Pick(Hooks),
            Stats: GenerateNpcStats(_pnjPower, role, profile.Career, profile.Race, profile.Class),
            Profile: power,
            Weapon: humanoidLoadout.Weapon,
            Equipment: humanoidLoadout.Equipment,
            Spell: humanoidLoadout.Spell);
    }

    private void GenererVariantePnj()
    {
        if (_pnj is null)
        {
            GenererPnj();
            return;
        }

        _pnj = _pnj with
        {
            Appearance = Pick(Appearances),
            Manner = Pick(Manners),
            Weapon = ResolveWeaponChoice(_pnjWeaponChoice, WeaponsFor(_pnj.Tone, _pnj.Profession, _pnj.Visual), _pnj.Weapon),
            Equipment = ResolveChoice(_pnjEquipmentChoice, EquipmentFor(_pnj.Tone, _pnj.Profession, _pnj.Visual), _pnj.Equipment),
            Spell = ResolveSpellChoice(_pnjSpellChoice, _pnj.Tone, _pnj.Profession, _pnj.Visual, _pnj.Spell),
            Stats = _pnj.Origin == "Bestiaire"
                ? VaryCreatureStats(PickBestiary(_pnj.Name, _pnj.Danger), _pnj.Danger)
                : GenerateNpcStats(_pnjPower, _pnj.Role, _pnj.Profession, _pnj.Origin, _pnj.Origin)
        };
    }

    private void GenererGroupe()
    {
        PreparerGroupe();
        DefinirSourcesGroupe();
        GenererGroupeDepuisPreparation();
    }

    private void PreparerGroupe()
    {
        var existing = _groupMemberSetups.ToDictionary(s => s.Order);
        _groupMemberSetups = Enumerable.Range(1, _groupSize)
            .Select(i => existing.TryGetValue(i, out var setup) ? setup : CreateDefaultGroupSetup(i))
            .ToList();
        ReindexGroupSetups();
    }

    private void DefinirSourcesGroupe()
    {
        if (_groupMemberSetups.Count == 0)
            PreparerGroupe();

        foreach (var setup in _groupMemberSetups)
        {
            if (_groupSourcesRandom)
            {
                setup.Source = Pick(GroupSourcesForTone(_groupTone));
                setup.Danger = Pick(["Faible", "Moyenne", "Elevee"]);
                var profile = ResolveHumanoidProfile("Aleatoire", "Aleatoire", "Aleatoire", Pick(ProfessionsForTone(_groupTone)));
                setup.Race = profile.Race;
                setup.Class = profile.Class;
                setup.Career = profile.Career;
                setup.BestiaryChoice = "Aleatoire";
                setup.Quantity = Math.Max(1, setup.Quantity);
            }
            else
            {
                setup.Source = _groupSource == "Mixte" ? Pick(["Humanoide", "Bestiaire"]) : _groupSource;
                setup.Danger = DangerFromThreat(_groupThreat);
                setup.Race = _groupRace;
                setup.Class = _groupClass;
                setup.Career = _groupCareer;
                setup.BestiaryChoice = _groupBestiaryChoice;
                setup.Quantity = Math.Max(1, setup.Quantity);
            }
        }
    }

    private void GenererGroupeDepuisPreparation()
    {
        var baseName = Pick(GroupNamesForTone(_groupTone));
        var leader = Pick(FirstNames);

        if (_groupMemberSetups.Count == 0)
            PreparerGroupe();

        if (_groupSourcesRandom
            || _groupMemberSetups.All(s => s.Source == "Humanoide" && s.Race == "Aleatoire" && s.Class == "Aleatoire" && s.Career == "Aleatoire" && s.BestiaryChoice == "Aleatoire"))
        {
            DefinirSourcesGroupe();
        }

        var members = _groupMemberSetups
            .OrderBy(s => s.Order)
            .SelectMany(setup => Enumerable.Range(1, Math.Max(1, setup.Quantity)).Select(_ => GenerateGroupMember(setup)))
            .ToList();

        _group = new GeneratedGroup(
            Name: $"{baseName} de {leader}",
            Threat: _groupThreat,
            Tone: _groupTone,
            Objective: Pick(GroupObjectivesForTone(_groupTone)),
            Members: members,
            Complication: Pick(GroupComplicationsForTone(_groupTone)));
    }

    private void GenererVariantesGroupe()
    {
        if (_group is null)
        {
            GenererGroupe();
            return;
        }

        _group = _group with
        {
            Threat = _groupThreat,
            Tone = _groupTone,
            Objective = Pick(GroupObjectivesForTone(_groupTone)),
            Complication = Pick(GroupComplicationsForTone(_groupTone)),
            Members = GroupMemberSetupsForGeneration()
                .OrderBy(s => s.Order)
                .SelectMany(setup => Enumerable.Range(1, Math.Max(1, setup.Quantity)).Select(_ => GenerateGroupMember(setup)))
                .ToList()
        };
    }

    private List<GroupMemberSetup> GroupMemberSetupsForGeneration()
    {
        if (_groupSourcesRandom)
            DefinirSourcesGroupe();

        return _groupMemberSetups;
    }

    private void DupliquerLigneGroupe(GroupMemberSetup setup)
    {
        var index = _groupMemberSetups.IndexOf(setup);
        if (index < 0)
            return;

        _groupMemberSetups.Insert(index + 1, setup.Clone());
        ReindexGroupSetups();
    }

    private void SupprimerLigneGroupe(GroupMemberSetup setup)
    {
        if (_groupMemberSetups.Count <= 1)
            return;

        _groupMemberSetups.Remove(setup);
        ReindexGroupSetups();
    }

    private void ReindexGroupSetups()
    {
        for (var i = 0; i < _groupMemberSetups.Count; i++)
            _groupMemberSetups[i].Order = i + 1;
    }

    private void GenererButin()
    {
        var coins = _lootWealth switch
        {
            "Misere" => $"{Roll(1, 10)} sous de cuivre",
            "Pauvre" => $"{Roll(2, 10)} sous de cuivre, {Roll(1, 5)} pistoles d'argent",
            "Riche" => $"{Roll(2, 10)} pistoles d'argent, {Roll(1, 5)} couronnes d'or",
            "Exceptionnelle" => $"{Roll(4, 10)} pistoles d'argent, {Roll(2, 10)} couronnes d'or",
            _ => $"{Roll(3, 10)} sous de cuivre, {Roll(2, 10)} pistoles d'argent",
        };
        var nature = ResolveChoice(_lootNature, LootNatureOptionsWithoutRandom);
        var danger = ResolveChoice(_lootDanger, LootDangerOptionsWithoutRandom);
        var magicItem = GenerateMagicLoot(nature, _lootMagicFrequency);

        _loot = new GeneratedLoot(
            Context: _lootType,
            Nature: nature,
            Danger: danger,
            Coins: coins,
            Items: PickMany(ItemsForLoot(_lootType, nature), 3),
            UsefulItem: Pick(UsefulLootItems[nature]),
            MagicItem: magicItem.Name,
            MagicEffect: magicItem.Effect,
            MagicRisk: magicItem.Risk,
            ValueEstimate: Pick(ValueEstimates[_lootWealth]),
            Owner: Pick(LootOwners[_lootType]),
            Condition: Pick(LootConditions),
            Clue: Pick(CluesForLoot(_lootType, nature)),
            Complication: BuildLootComplication(danger, magicItem.Risk));
    }

    private static IReadOnlyList<string> ItemsForLoot(string context, string nature)
    {
        var items = new List<string>();
        if (LootItems.TryGetValue(context, out var contextItems))
            items.AddRange(contextItems);

        if (LootItemsByNature.TryGetValue(nature, out var natureItems))
            items.AddRange(natureItems);

        return items.Count > 0 ? items : LootItems["Route"];
    }

    private static IReadOnlyList<string> CluesForLoot(string context, string nature)
    {
        var clues = new List<string>(LootClues);
        if (LootCluesByContext.TryGetValue(context, out var contextClues))
            clues.AddRange(contextClues);
        if (LootCluesByNature.TryGetValue(nature, out var natureClues))
            clues.AddRange(natureClues);

        return clues;
    }

    private static MagicLoot GenerateMagicLoot(string nature, string frequency)
    {
        var forcedByNature = nature is "Objet magique" or "Composants magiques" or "Reliques";
        var chance = frequency switch
        {
            "Jamais" => 0,
            "Possible" => 45,
            "Frequent" => 100,
            _ => 15,
        };

        if (!forcedByNature && Random.Shared.Next(100) >= chance)
            return new MagicLoot("Aucun", "Aucun", "Aucun");

        var pool = nature switch
        {
            "Composants magiques" => MagicComponents,
            "Reliques" => MagicRelics,
            "Equipement" => MagicWeapons,
            "Objet magique" => MagicItems,
            _ => MagicItems,
        };

        return Pick(pool);
    }

    private static string BuildLootComplication(string danger, string magicRisk)
    {
        var complication = Pick(LootComplicationsByDanger[danger]);
        return magicRisk == "Aucun" ? complication : $"{complication} {magicRisk}";
    }

    private static GroupMemberSetup CreateDefaultGroupSetup(int order) =>
        new()
        {
            Order = order,
            Quantity = 1,
            Source = "Humanoide",
            Danger = "Moyenne",
            Race = "Aleatoire",
            Class = "Aleatoire",
            Career = "Aleatoire",
            BestiaryChoice = "Aleatoire"
        };

    private GeneratedGroupMember GenerateGroupMember(GroupMemberSetup setup, GeneratedGroupMember? previous = null)
    {
        if (setup.Source == "Bestiaire")
        {
            var creature = PickBestiary(previous?.BestiaryName ?? setup.BestiaryChoice, setup.Danger, _groupTone);
            var loadout = GenerateLoadout(
                _groupTone,
                creature.Profile,
                creature.Visual,
                _groupWeaponChoice,
                _groupEquipmentChoice,
                _groupSpellChoice,
                creature.Attack,
                creature.Defense);
            return new GeneratedGroupMember(
                Order: setup.Order,
                Name: creature.Name,
                Role: creature.Role,
                Origin: $"Bestiaire - {creature.Environment}",
                BestiaryName: creature.Name,
                Danger: setup.Danger,
                Visual: creature.Visual,
                Manner: creature.Special,
                Weapon: loadout.Weapon,
                Equipment: loadout.Equipment,
                Spell: loadout.Spell,
                Stats: VaryCreatureStats(creature, setup.Danger));
        }

        var threat = ThreatFromDanger(setup.Danger);
        var role = previous?.Role ?? Pick(GroupRoles[threat]);
        var profile = ResolveHumanoidProfile(setup.Race, setup.Class, setup.Career, Pick(ProfessionsForTone(_groupTone)));
        var humanoidLoadout = GenerateLoadout(
            _groupTone,
            profile.Career,
            "human",
            _groupWeaponChoice,
            _groupEquipmentChoice,
            _groupSpellChoice);

        return new GeneratedGroupMember(
            Order: setup.Order,
            Name: previous?.Name ?? $"{Pick(FirstNames)} {Pick(LastNames)}",
            Role: profile.Career,
            Origin: $"{profile.Race} - {profile.Class}",
            BestiaryName: null,
            Danger: setup.Danger,
            Visual: "human",
            Manner: Pick(Manners),
            Weapon: humanoidLoadout.Weapon,
            Equipment: humanoidLoadout.Equipment,
            Spell: humanoidLoadout.Spell,
            Stats: GenerateGroupMemberStats(threat, profile.Career, profile.Race, profile.Class));
    }

