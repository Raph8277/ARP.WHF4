    private static string PickChoice(string selected, IReadOnlyList<string> values) =>
        selected == "Aleatoire" ? Pick(values) : selected;

    private HumanoidProfile ResolveHumanoidProfile(string raceSelection, string classSelection, string careerSelection, string fallbackCareer)
    {
        if (_especes.Count == 0 || _classes.Count == 0 || _carrieres.Count == 0)
        {
            var fallbackRace = PickChoice(raceSelection, FallbackNpcRacesWithoutRandom);
            var fallbackClass = PickChoice(classSelection, FallbackNpcClassesWithoutRandom);
            var fallbackCareerName = careerSelection == "Aleatoire" ? fallbackCareer : careerSelection;
            return new HumanoidProfile(fallbackRace, fallbackClass, fallbackCareerName);
        }

        var selectedRace = FindEspece(raceSelection);
        var selectedClass = FindClasse(classSelection);
        var selectedCareer = FindCarriere(careerSelection);

        if (selectedCareer is not null
            && (selectedClass is null || selectedCareer.ClasseId == selectedClass.Id)
            && (selectedRace is null || IsCareerAllowedForRace(selectedCareer, selectedRace)))
        {
            var race = selectedRace ?? PickRaceForCareer(selectedCareer);
            var npcClass = _classes.FirstOrDefault(c => c.Id == selectedCareer.ClasseId) ?? selectedClass ?? Pick(_classes);
            return new HumanoidProfile(race.Nom, npcClass.Nom, selectedCareer.Nom);
        }

        var candidates = AllowedCareers(raceSelection, classSelection).ToList();
        if (candidates.Count == 0 && selectedRace is not null)
            candidates = _carrieres.Where(c => IsCareerAllowedForRace(c, selectedRace)).ToList();
        if (candidates.Count == 0)
            candidates = _carrieres.ToList();

        var preferredCareer = careerSelection == "Aleatoire"
            ? FindPreferredCareer(candidates, fallbackCareer)
            : null;
        var career = preferredCareer ?? (candidates.Count > 0 ? Pick(candidates) : null);
        if (career is null)
            return new HumanoidProfile(PickChoice(raceSelection, FallbackNpcRacesWithoutRandom), PickChoice(classSelection, FallbackNpcClassesWithoutRandom), fallbackCareer);

        var resolvedRace = selectedRace is not null && IsCareerAllowedForRace(career, selectedRace)
            ? selectedRace
            : PickRaceForCareer(career);
        var resolvedClass = _classes.FirstOrDefault(c => c.Id == career.ClasseId) ?? selectedClass ?? Pick(_classes);

        return new HumanoidProfile(resolvedRace.Nom, resolvedClass.Nom, career.Nom);
    }

    private static CarriereDto? FindPreferredCareer(IReadOnlyList<CarriereDto> candidates, string fallbackCareer)
    {
        var normalizedFallback = NormalizeKey(fallbackCareer);
        return candidates.FirstOrDefault(c => NormalizeKey(c.Nom) == normalizedFallback)
            ?? candidates.FirstOrDefault(c => NormalizeKey(c.Nom).Contains(normalizedFallback) || normalizedFallback.Contains(NormalizeKey(c.Nom)));
    }

    private IEnumerable<CarriereDto> AllowedCareers(string raceSelection, string classSelection)
    {
        if (_carrieres.Count == 0)
            return [];

        var selectedRace = FindEspece(raceSelection);
        var selectedClass = FindClasse(classSelection);

        return _carrieres
            .Where(c => selectedClass is null || c.ClasseId == selectedClass.Id)
            .Where(c => selectedRace is null || IsCareerAllowedForRace(c, selectedRace))
            .OrderBy(c => c.Nom);
    }

    private EspeceDto PickRaceForCareer(CarriereDto career)
    {
        var candidates = career.EspecesAutorisees.Count == 0
            ? _especes
            : _especes.Where(e => career.EspecesAutorisees.Contains(e.Code)).ToList();

        return candidates.Count > 0 ? Pick(candidates) : Pick(_especes);
    }

    private EspeceDto? FindEspece(string name) =>
        name == "Aleatoire" ? null : _especes.FirstOrDefault(e => string.Equals(e.Nom, name, StringComparison.OrdinalIgnoreCase));

    private ClasseDto? FindClasse(string name) =>
        name == "Aleatoire" ? null : _classes.FirstOrDefault(c => string.Equals(c.Nom, name, StringComparison.OrdinalIgnoreCase));

    private CarriereDto? FindCarriere(string name) =>
        name == "Aleatoire" ? null : _carrieres.FirstOrDefault(c => string.Equals(c.Nom, name, StringComparison.OrdinalIgnoreCase));

    private static bool IsCareerAllowedForRace(CarriereDto career, EspeceDto race) =>
        career.EspecesAutorisees.Count == 0 || career.EspecesAutorisees.Contains(race.Code);

    private static IReadOnlyList<string> OptionsFrom(IEnumerable<string> values, IReadOnlyList<string> fallback)
    {
        var options = values
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();

        return options.Count == 0 ? fallback : ["Aleatoire", .. options];
    }

    private static BestiaryEntry PickBestiary(string selectedName, string danger)
        => PickBestiary(selectedName, danger, null);

    private static BestiaryEntry PickBestiary(string selectedName, string danger, string? tone)
    {
        if (selectedName != "Aleatoire")
            return Bestiary.FirstOrDefault(c => c.Name == selectedName) ?? Bestiary[0];

        var candidates = danger == "Aleatoire"
            ? Bestiary
            : Bestiary.Where(c => c.Danger == danger).ToList();

        if (!string.IsNullOrWhiteSpace(tone) && tone != "Aleatoire")
        {
            var toneCandidates = candidates.Where(c => BestiaryMatchesTone(c, tone)).ToList();
            if (toneCandidates.Count > 0)
                candidates = toneCandidates;
        }

        return Pick(candidates.Count == 0 ? Bestiary : candidates);
    }

    private static bool BestiaryMatchesTone(BestiaryEntry creature, string tone)
    {
        var environment = creature.Environment;
        return tone switch
        {
            "Urbain" => MatchesAny(environment, "Urbain", "Egouts"),
            "Sombre" => MatchesAny(environment, "Occulte", "Ruines", "Nuit", "Desolation", "Cimetiere", "Tombe"),
            "Cimetiere" => MatchesAny(environment, "Cimetiere", "Tombe"),
            "Foret" => MatchesAny(environment, "Foret", "Bois"),
            "Route" => MatchesAny(environment, "Route"),
            "Noble" => MatchesAny(environment, "Noble", "Urbain", "Nuit"),
            "Egouts" => MatchesAny(environment, "Egouts", "Urbain"),
            "Occulte" => MatchesAny(environment, "Occulte", "Ruines", "Desolation", "Nuit"),
            _ => environment.Contains(tone, StringComparison.OrdinalIgnoreCase),
        };
    }

    private static bool MatchesAny(string value, params string[] candidates) =>
        candidates.Any(candidate => value.Contains(candidate, StringComparison.OrdinalIgnoreCase));

    private static IReadOnlyList<string> ProfessionsForTone(string tone) =>
        ProfessionsByTone.TryGetValue(tone, out var professions) ? professions : ProfessionsByTone["Urbain"];

    private static IReadOnlyList<string> GroupNamesForTone(string tone) =>
        GroupNamesByTone.TryGetValue(tone, out var names) ? names : GroupNames;

    private static IReadOnlyList<string> GroupObjectivesForTone(string tone) =>
        GroupObjectivesByTone.TryGetValue(tone, out var objectives) ? objectives : GroupObjectives;

    private static IReadOnlyList<string> GroupComplicationsForTone(string tone) =>
        GroupComplicationsByTone.TryGetValue(tone, out var complications) ? complications : GroupComplications;

    private static IReadOnlyList<string> GroupSourcesForTone(string tone) =>
        tone is "Cimetiere"
            ? ["Bestiaire"]
            : tone is "Foret" or "Egouts" or "Occulte"
            ? ["Bestiaire", "Bestiaire", "Humanoide"]
            : ["Humanoide", "Bestiaire"];

    private static GeneratedLoadout GenerateLoadout(
        string tone,
        string profession,
        string visual,
        string weaponChoice,
        string equipmentChoice,
        string spellChoice,
        string? defaultWeapon = null,
        string? defaultEquipment = null)
    {
        var weapon = ResolveWeaponChoice(weaponChoice, WeaponsFor(tone, profession, visual), defaultWeapon);
        var equipment = ResolveChoice(equipmentChoice, EquipmentFor(tone, profession, visual), defaultEquipment);
        var spell = ResolveSpellChoice(spellChoice, tone, profession, visual);

        return new GeneratedLoadout(weapon, equipment, spell);
    }

    private static string ResolveChoice(string choice, IReadOnlyList<string> values, string? fallback = null) =>
        choice switch
        {
            "Aleatoire" => Pick(values),
            "Aucun" => "Aucun",
            _ => choice,
        } ?? fallback ?? "Aucun";

    private static string ResolveWeaponChoice(string choice, IReadOnlyList<string> values, string? fallback = null) =>
        WithWeaponDamage(ResolveChoice(choice, values, fallback));

    private static string ResolveSpellChoice(string choice, string tone, string profession, string visual, string? previous = null)
    {
        if (choice == "Aucun")
            return "Aucun";

        if (choice != "Aleatoire")
            return choice;

        if (!CanHaveSpell(tone, profession, visual))
            return previous ?? "Aucun";

        return Pick(["Aucun", ..SpellsFor(tone, profession, visual)]);
    }

    private static IReadOnlyList<string> WeaponsFor(string tone, string profession, string visual)
    {
        var profile = NormalizeKey($"{tone} {profession} {visual}");
        if (profile.Contains("undead") || profile.Contains("squelette"))
            return ["Lame rouillee", "Arc ancien", "Lance brisee", "Griffes osseuses"];
        if (profile.Contains("beast") || profile.Contains("predateur") || profile.Contains("bete"))
            return ["Morsure", "Griffes", "Charge", "Crocs et griffes"];
        if (profile.Contains("spirit"))
            return ["Contact spectral", "Cri glace", "Presence etouffante"];
        if (profile.Contains("mage") || profile.Contains("sorcier") || profile.Contains("mystique") || profile.Contains("occulte"))
            return ["Dague rituelle", "Baton grave", "Couteau sacrificiel", "Serpe noire"];
        if (profile.Contains("noble") || profile.Contains("duelliste") || profile.Contains("courtisan"))
            return ["Rapiere", "Main gauche", "Pistolet de duel", "Canne-epee"];
        if (profile.Contains("foret") || profile.Contains("chasseur") || profile.Contains("eclaireur"))
            return ["Arc court", "Hachette", "Epieu", "Couteau de chasse"];
        if (profile.Contains("route") || profile.Contains("cocher") || profile.Contains("patrouilleur") || profile.Contains("hors-la-loi"))
            return ["Arbalete legere", "Gourdin", "Epee courte", "Pistolet use"];
        if (profile.Contains("egouts") || profile.Contains("ratier") || profile.Contains("voleur"))
            return ["Dague sale", "Gourdin plombe", "Fronde", "Crochet rouille"];

        return ["Dague", "Gourdin", "Epee courte", "Arbalete legere"];
    }

    private static string WithWeaponDamage(string weapon)
    {
        if (weapon == "Aucun" || weapon.Contains("Degats", StringComparison.OrdinalIgnoreCase))
            return weapon;

        return WeaponDamage.TryGetValue(NormalizeWeaponName(weapon), out var damage)
            ? $"{weapon} (Degats {damage})"
            : $"{weapon} (Degats selon profil)";
    }

    private static string NormalizeWeaponName(string weapon)
    {
        var withoutDetails = weapon.Split('(', 2)[0].Trim();
        return NormalizeKey(withoutDetails);
    }

    private static IReadOnlyList<string> EquipmentFor(string tone, string profession, string visual)
    {
        var profile = NormalizeKey($"{tone} {profession} {visual}");
        if (profile.Contains("cimetiere") || profile.Contains("undead"))
            return ["Lanterne sourde", "Pelle courte", "Corde tachee de terre", "Symbole de Morr fendu"];
        if (profile.Contains("foret") || profile.Contains("beast"))
            return ["Piege a machoires", "Cape de pluie", "Sac d'herbes seches", "Corde et silex"];
        if (profile.Contains("noble"))
            return ["Lettre scellee", "Bourse parfumee", "Chevaliere", "Manteau double"];
        if (profile.Contains("egouts"))
            return ["Masque de tissu", "Lampe a huile", "Cle de grille", "Carte humide"];
        if (profile.Contains("occulte") || profile.Contains("sorcier") || profile.Contains("mage"))
            return ["Craie noire", "Bougie grasse", "Page de grimoire", "Amulette fissuree"];
        if (profile.Contains("route"))
            return ["Carte tachee", "Outre de voyage", "Cape ciree", "Sifflet de relais"];

        return ["Bourse legere", "Couteau utilitaire", "Manteau use", "Petit carnet"];
    }

    private static IReadOnlyList<string> SpellsFor(string tone, string profession, string visual)
    {
        var profile = NormalizeKey($"{tone} {profession} {visual}");
        if (profile.Contains("undead") || profile.Contains("cimetiere"))
            return ["Animation mineure", "Voix d'outre-tombe", "Main de poussiere", "Froid de la tombe"];
        if (profile.Contains("occulte") || profile.Contains("sorcier") || profile.Contains("mage"))
            return ["Dard magique", "Murmure corrupteur", "Ombre mouvante", "Mauvais oeil"];
        if (profile.Contains("foret"))
            return ["Ronces entravantes", "Brume des sous-bois", "Peau d'ecorce", "Cri de corbeau"];

        return ["Benediction mineure", "Lumiere vacillante", "Murmure lointain", "Main invisible"];
    }

    private static bool CanHaveSpell(string tone, string profession, string visual)
    {
        var profile = NormalizeKey($"{tone} {profession} {visual}");
        return profile.Contains("mage")
            || profile.Contains("sorcier")
            || profile.Contains("sorciere")
            || profile.Contains("mystique")
            || profile.Contains("pretre")
            || profile.Contains("occulte")
            || profile.Contains("undead")
            || profile.Contains("spirit")
            || profile.Contains("demon")
            || tone is "Occulte" or "Cimetiere";
    }

    private static CreatureStats GenerateNpcStats(string power, string role, string profession, string race, string npcClass)
    {
        var baseValue = power switch
        {
            "Dangereux" => 54,
            "Competent" => 44,
            _ => 34,
        };

        var wounds = power switch
        {
            "Dangereux" => 16,
            "Competent" => 12,
            _ => 9,
        };

        return ApplyHumanoidRoleProfile(RandomHumanoidStats(baseValue, 9, wounds, 4), $"{role} {profession} {race} {npcClass}");
    }

    private static CreatureStats GenerateGroupMemberStats(string threat, string role, string race, string npcClass)
    {
        var baseValue = threat switch
        {
            "Forte" => 50,
            "Moyenne" => 40,
            _ => 30,
        };

        var wounds = threat switch
        {
            "Forte" => 15,
            "Moyenne" => 11,
            _ => 8,
        };

        return ApplyHumanoidRoleProfile(RandomHumanoidStats(baseValue, 8, wounds, 4), $"{role} {race} {npcClass}");
    }

    private static CreatureStats RandomHumanoidStats(int baseValue, int variance, int wounds, int move) =>
        new(
            Vary(baseValue, variance),
            Vary(baseValue - 3, variance),
            Vary(baseValue - 2, variance),
            Vary(baseValue + 1, variance),
            Vary(baseValue, variance),
            Vary(baseValue, variance),
            Vary(baseValue - 1, variance),
            Vary(baseValue - 1, variance),
            Vary(baseValue, variance),
            Vary(baseValue - 2, variance),
            Math.Max(1, Vary(wounds, 3)),
            move);

    private static CreatureStats ApplyHumanoidRoleProfile(CreatureStats stats, string role)
    {
        var profile = role.ToLowerInvariant();
        if (profile.Contains("arbaletrier") || profile.Contains("tireur"))
            stats = stats with { BS = Math.Clamp(stats.BS + 10, 1, 99), I = Math.Clamp(stats.I + 3, 1, 99) };

        if (profile.Contains("spadassin") || profile.Contains("duelliste") || profile.Contains("veteran") || profile.Contains("adversaire"))
            stats = stats with { WS = Math.Clamp(stats.WS + 10, 1, 99), WP = Math.Clamp(stats.WP + 5, 1, 99), Wounds = Math.Max(1, stats.Wounds + 2) };

        if (profile.Contains("chef") || profile.Contains("rival"))
            stats = stats with { Fel = Math.Clamp(stats.Fel + 7, 1, 99), WP = Math.Clamp(stats.WP + 5, 1, 99) };

        if (profile.Contains("eclaireur") || profile.Contains("guetteur") || profile.Contains("messager"))
            stats = stats with { Ag = Math.Clamp(stats.Ag + 8, 1, 99), Dex = Math.Clamp(stats.Dex + 5, 1, 99), I = Math.Clamp(stats.I + 5, 1, 99) };

        if (profile.Contains("allie") || profile.Contains("contact") || profile.Contains("intendant") || profile.Contains("precepteur"))
            stats = stats with { Int = Math.Clamp(stats.Int + 6, 1, 99), Fel = Math.Clamp(stats.Fel + 6, 1, 99) };

        if (profile.Contains("fanatique") || profile.Contains("cultiste"))
            stats = stats with { WP = Math.Clamp(stats.WP + 10, 1, 99), Fel = Math.Clamp(stats.Fel - 5, 1, 99) };

        return stats;
    }

    private static T Pick<T>(IReadOnlyList<T> values) => values[Random.Shared.Next(values.Count)];

    private static string Slug(string value)
    {
        var chars = value.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray();
        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }

    private static string NormalizeKey(string value)
    {
        var normalized = value.Normalize(System.Text.NormalizationForm.FormD);
        var chars = normalized
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-')
            .ToArray();

        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }

    private static List<string> PickMany(IReadOnlyList<string> values, int count) =>
        values.OrderBy(_ => Random.Shared.Next()).Take(count).ToList();

    private static int Roll(int dice, int sides)
    {
        var total = 0;
        for (var i = 0; i < dice; i++)
            total += Random.Shared.Next(1, sides + 1);

        return total;
    }

