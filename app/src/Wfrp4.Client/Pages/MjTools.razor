    private Task OnTabChanged(int index)
    {
        _activeTabIndex = index;
        if (index == 5 && !_mapInitialized)
            _mapNeedsInit = true;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapNeedsInit)
        {
            _mapNeedsInit = false;
            await InitMap();
        }
        if (_campaignMapsNeedInit && _campagne is not null)
        {
            _campaignMapsNeedInit = false;
            for (var i = 0; i < _campagne.Episodes.Count; i++)
                await InitAdventureMap(_campagne.Episodes[i], i + 1);
        }
    }

    private async Task InitMap()
    {
        var cities = MapCities.Select(c => new { name = c.Name, type = c.Type, population = c.Population, region = c.Region, lat = c.Lat, lng = c.Lng }).ToArray();
        var regions = MapRegions.Select(r => new { name = r.Name, type = r.Type, parent = r.Parent ?? "", tags = r.Tags, hooks = r.ScenarioHooks, lat = r.Lat, lng = r.Lng }).ToArray();
        await JS.InvokeVoidAsync("wfrp4Map.init", "wfrp4-map", cities,
            "https://wjrf.bimondiens.com/content/tools/tile.rpc.php?map=oldworld&zoom={z}&x={x}&y={y}",
            new[] { 66.5, -31.0 }, 3, 2, 7, regions);
        _mapInitialized = true;
    }

    private async Task ApplyMapFilter()
    {
        if (_mapInitialized)
            await JS.InvokeVoidAsync("wfrp4Map.filter", _mapRegionFilter, _mapTypeFilter, _mapSearch);
    }

    private async Task OnMapSearchChanged(string value)
    {
        _mapSearch = value;
        await ApplyMapFilter();
    }

    private async Task OnMapTypeChanged(string value)
    {
        _mapTypeFilter = value;
        await ApplyMapFilter();
    }

    private async Task ClearRegionFilter()
    {
        _mapRegionFilter = "Toutes";
        await ApplyMapFilter();
    }

    private async Task FlyToCity(MapCity city)
    {
        if (!_mapInitialized) await InitMap();
        await JS.InvokeVoidAsync("wfrp4Map.flyTo", city.Lat, city.Lng);
    }

    private async Task FlyToRegion(MapRegion region)
    {
        if (!_mapInitialized) await InitMap();
        await JS.InvokeVoidAsync("wfrp4Map.flyTo", region.Lat, region.Lng, 4);
    }

    private async Task SelectCity(MapCity city)
    {
        _mapSelectedCity = _mapSelectedCity == city ? null : city;
        _mapSelectedRegion = null;
        if (_mapSelectedCity is not null)
        {
            await FlyToCity(_mapSelectedCity);
            await JS.InvokeVoidAsync("wfrp4Map.highlight", _mapSelectedCity.Lat, _mapSelectedCity.Lng, false);
        }
        else
        {
            await JS.InvokeVoidAsync("wfrp4Map.clearHighlight");
        }
    }

    private async Task SelectRegion(MapRegion region)
    {
        var wasSame = _mapSelectedRegion == region;
        _mapSelectedRegion = wasSame ? null : region;
        _mapSelectedCity = null;
        _mapRegionFilter = wasSame ? "Toutes" : region.Name;
        await ApplyMapFilter();
        if (_mapSelectedRegion is not null)
        {
            await FlyToRegion(_mapSelectedRegion);
            await JS.InvokeVoidAsync("wfrp4Map.highlight", _mapSelectedRegion.Lat, _mapSelectedRegion.Lng, true);
        }
        else
        {
            await JS.InvokeVoidAsync("wfrp4Map.clearHighlight");
        }
    }

    private async Task ClearMapSelection()
    {
        _mapSelectedCity = null;
        _mapSelectedRegion = null;
        await JS.InvokeVoidAsync("wfrp4Map.clearHighlight");
    }

    private async Task ToggleMapFullscreen()
    {
        if (_mapInitialized)
            _mapFullscreen = await JS.InvokeAsync<bool>("wfrp4Map.toggleFullscreen");
    }

    private async Task ToggleMapLayer(string layer)
    {
        if (layer == "cities")
        {
            _mapShowCities = !_mapShowCities;
            await JS.InvokeVoidAsync("wfrp4Map.toggleLayer", "cities", _mapShowCities);
        }
        else
        {
            _mapShowRegions = !_mapShowRegions;
            await JS.InvokeVoidAsync("wfrp4Map.toggleLayer", "regions", _mapShowRegions);
        }
    }

