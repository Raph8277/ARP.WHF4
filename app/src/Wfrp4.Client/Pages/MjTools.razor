    private static string AttackFromTraits(string traits)
    {
        var attacks = traits.Split(',', StringSplitOptions.TrimEntries)
            .Where(t => t.StartsWith("Arme", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Morsure", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Cornes", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Queue", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Griffes", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Souffle", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Distance", StringComparison.OrdinalIgnoreCase)
                     || t.Contains("Tentacules", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Langue", StringComparison.OrdinalIgnoreCase));
        return string.Join(", ", attacks);
    }

    private static string DefenseFromTraits(string traits)
    {
        var defense = traits.Split(',', StringSplitOptions.TrimEntries)
            .Where(t => t.StartsWith("Armure", StringComparison.OrdinalIgnoreCase)
                     || t.StartsWith("Taille", StringComparison.OrdinalIgnoreCase)
                     || t.Contains("Régénér", StringComparison.OrdinalIgnoreCase)
                     || t.Contains("Éthéré", StringComparison.OrdinalIgnoreCase)
                     || t.Contains("Démoniaque", StringComparison.OrdinalIgnoreCase)
                     || t.Contains("Dure à Tuer", StringComparison.OrdinalIgnoreCase)
                     || t.Contains("Champion", StringComparison.OrdinalIgnoreCase));
        return string.Join(", ", defense);
    }

