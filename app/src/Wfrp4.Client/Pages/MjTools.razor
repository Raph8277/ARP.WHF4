    private static readonly JsonSerializerOptions _jsonOpts = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    private async Task ChargerAventuresSauvegardees()
    {
        _aventuresSauvegardeesChargement = true;
        try { _aventuresSauvegardees = await Api.GetAventuresSauvegardeesAsync(); }
        catch { Snackbar.Add("Erreur lors du chargement des sauvegardes", Severity.Error); }
        finally { _aventuresSauvegardeesChargement = false; }
    }

    private async Task SauvegarderAventure()
    {
        if (_aventure is null && _campagne is null) return;
        _sauvegardeEnCours = true;
        try
        {
            var type = _campagne is not null ? "campagne" : "aventure";
            var titre = _campagne?.Title ?? _aventure!.Title;
            var data = _campagne is not null
                ? JsonSerializer.Serialize(_campagne, _jsonOpts)
                : JsonSerializer.Serialize(_aventure, _jsonOpts);
            await Api.SauvegarderAventureAsync(new SaveAventureRequest { Type = type, Titre = titre, DataJson = data });
            Snackbar.Add($"{(type == "campagne" ? "Campagne" : "Aventure")} sauvegardee", Severity.Success);
            await ChargerAventuresSauvegardees();
        }
        catch { Snackbar.Add("Erreur lors de la sauvegarde", Severity.Error); }
        finally { _sauvegardeEnCours = false; }
    }

    private async Task ChargerAventureSauvegardee(AventureSauvegardeeSummaryDto item)
    {
        try
        {
            var detail = await Api.GetAventureSauvegardeeAsync(item.Id);
            if (detail is null) return;
            if (detail.Type == "campagne")
            {
                _aventure = null;
                _campagne = JsonSerializer.Deserialize<GeneratedCampaign>(detail.DataJson, _jsonOpts);
                _campaignMapsNeedInit = true;
                StateHasChanged();
            }
            else
            {
                _campagne = null;
                _aventure = JsonSerializer.Deserialize<GeneratedAdventure>(detail.DataJson, _jsonOpts);
                if (_aventure is not null)
                {
                    StateHasChanged();
                    await Task.Yield();
                    await InitAdventureMap(_aventure);
                }
            }
            Snackbar.Add($"{item.Titre} charge", Severity.Info);
        }
        catch { Snackbar.Add("Erreur lors du chargement", Severity.Error); }
    }

    private async Task SupprimerAventureSauvegardee(AventureSauvegardeeSummaryDto item)
    {
        try
        {
            await Api.SupprimerAventureSauvegardeeAsync(item.Id);
            Snackbar.Add("Sauvegarde supprimee", Severity.Info);
            await ChargerAventuresSauvegardees();
        }
        catch { Snackbar.Add("Erreur lors de la suppression", Severity.Error); }
    }

    private async Task GenererAventure()
    {
        _campagne = null;
        _aventure = BuildAdventure(_advTheme, _advRegion, _advThreat, _advDanger, _advDuration, null);
        StateHasChanged();
        await Task.Yield();
        await InitAdventureMap(_aventure);
    }

    private async Task VoirSurLaCarte(GeneratedAdventure adv)
    {
        _activeTabIndex = 5;
        if (!_mapInitialized)
            _mapNeedsInit = true;
        StateHasChanged();
        await Task.Yield();
        if (_mapInitialized)
        {
            await JS.InvokeVoidAsync("wfrp4Map.flyTo", adv.CityLat, adv.CityLng, 6);
            await JS.InvokeVoidAsync("wfrp4Map.highlight", adv.CityLat, adv.CityLng, false);
        }
    }

    private async Task InitAdventureMap(GeneratedAdventure adv, int mapIndex = 0)
    {
        var elementId = $"wfrp4-adventure-map-{mapIndex}";
        var nearbyMarkers = adv.NearbyCities.Count > 0
            ? MapCities.Where(c => adv.NearbyCities.Any(n => n.StartsWith(c.Name)))
                .Select(c => new { name = c.Name, lat = c.Lat, lng = c.Lng }).ToArray()
            : Array.Empty<object>();
        var route = adv.Acts.Select((a, i) => new { name = a.CityName, lat = a.Lat, lng = a.Lng, step = i + 1 }).ToArray();
        await JS.InvokeVoidAsync("wfrp4Map.initMiniMap", elementId, adv.CityLat, adv.CityLng, 5, nearbyMarkers,
            "https://wjrf.bimondiens.com/content/tools/tile.rpc.php?map=oldworld&zoom={z}&x={x}&y={y}", route);
    }

    private bool _campaignMapsNeedInit;

    private async Task OnEpisodePanelToggle(bool expanded, int mapIndex)
    {
        if (expanded)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("wfrp4Map.invalidateMiniMap", $"wfrp4-adventure-map-{mapIndex}");
        }
    }

    private async Task GenererCampagne()
    {
        _aventure = null;
        var theme = ResolveAdvChoice(_advTheme, AdvThemeOptionsNoRandom);
        var villain = $"{Pick(AdvVillainTitles)} {Pick(LastNames)}";
        var arc = Pick(AdvCampaignArcs[theme]);
        var episodes = new List<GeneratedAdventure>();

        var regionPool = _advRegion == "Aleatoire" ? AdvRegionOptionsNoRandom : new[] { _advRegion };
        var dangers = _advDanger switch
        {
            "Faible" => new[] { "Faible", "Faible", "Moyen" },
            "Eleve" => new[] { "Moyen", "Eleve", "Eleve" },
            _ => new[] { "Faible", "Moyen", "Eleve" },
        };

        for (var i = 0; i < _campagneSize; i++)
        {
            var epTheme = i == 0 ? theme : ResolveAdvChoice("Aleatoire", AdvThemeOptionsNoRandom);
            var epRegion = Pick(regionPool);
            var epDanger = dangers[Math.Min(i, dangers.Length - 1)];
            var link = i == 0
                ? $"Premiere apparition de {villain}. {arc}"
                : i == _campagneSize - 1
                    ? $"Confrontation finale avec {villain}."
                    : Pick(AdvCampaignLinks);
            episodes.Add(BuildAdventure(epTheme, epRegion, _advThreat, epDanger, _advDuration, link));
        }

        _campagne = new GeneratedCampaign(
            Title: $"{Pick(AdvCampaignTitles)} — {arc.Split('.')[0]}",
            ArcSummary: arc,
            RecurringVillain: villain,
            Episodes: episodes);

        _campaignMapsNeedInit = true;
    }

    private GeneratedAdventure BuildAdventure(string themePref, string regionPref, string threatPref, string danger, string duration, string? campaignLink)
    {
        var theme = ResolveAdvChoice(themePref, AdvThemeOptionsNoRandom);
        var region = ResolveAdvChoice(regionPref, AdvRegionOptionsNoRandom);
        var threat = ResolveAdvChoice(threatPref, AdvThreatOptionsNoRandom);

        // Pick a real city from the map for this region
        var regionCities = MapCities.Where(c => c.Region.Contains(region, StringComparison.OrdinalIgnoreCase)).ToArray();
        MapCity? mapCity = regionCities.Length > 0 ? Pick(regionCities) : null;
        var cityName = mapCity?.Name ?? (AdvLocations.TryGetValue(region, out var locPool) ? Pick(locPool).Split(',')[0] : region);
        var cityLat = mapCity?.Lat ?? 52.0;
        var cityLng = mapCity?.Lng ?? -10.0;

        // Get nearby cities (same region, different from picked city)
        var nearby = regionCities.Where(c => c != mapCity).OrderBy(_ => Random.Shared.Next()).Take(3).Select(c => $"{c.Name} ({c.Type})").ToList();

        // Get region info from MapRegions
        var mapRegion = MapRegions.FirstOrDefault(r => r.Name.Equals(region, StringComparison.OrdinalIgnoreCase));
        var regionDesc = mapRegion is not null ? string.Join(", ", mapRegion.Tags) : "";

        var location = AdvLocations.TryGetValue(region, out var locs) ? $"{Pick(locs)}, {region}" : $"{cityName}, {region}";
        var titlePrefix = Pick(AdvTitlePrefixes[theme]);
        var titleSuffix = Pick(AdvTitleSuffixes);

        var actCount = duration switch { "One-shot" => 2, "Long" => 4, _ => 3 };
        var actCities = new List<MapCity>();
        if (mapCity is not null) actCities.Add(mapCity);
        var otherCities = regionCities.Where(c => c != mapCity).OrderBy(_ => Random.Shared.Next()).ToList();
        while (actCities.Count < actCount && otherCities.Count > 0)
        {
            actCities.Add(otherCities[0]);
            otherCities.RemoveAt(0);
        }
        if (actCities.Count == 0)
            actCities.Add(new MapCity(cityName, "Ville", "Inconnue", region, cityLat, cityLng));
        while (actCities.Count < actCount)
            actCities.Add(actCities[^1]);

        var acts = Enumerable.Range(0, actCount).Select(i =>
        {
            var pool = i == 0 ? AdvActsOpening : i == actCount - 1 ? AdvActsClimax : AdvActsDevelopment;
            var actCity = actCities[i];
            return new AdventureAct(
                Title: Pick(pool),
                Description: Pick(AdvSceneDescriptions[theme]),
                Challenge: Pick(AdvChallenges[theme]),
                CityName: actCity.Name,
                Lat: actCity.Lat,
                Lng: actCity.Lng);
        }).ToList();

        var power = danger switch { "Faible" => "Ordinaire", "Eleve" => "Dangereux", _ => "Competent" };
        var toneForTheme = theme switch
        {
            "Intrigue" or "Politique" => "Urbain",
            "Exploration" => "Foret",
            "Horreur" => "Souterrain",
            _ => "Route",
        };
        var roles = new[] { "Allie", "Contact", "Antagoniste" };
        var npcs = roles.Select(role =>
        {
            var profession = Pick(AdvNpcProfessions);
            var profile = ResolveHumanoidProfile("Aleatoire", "Aleatoire", "Aleatoire", profession);
            var loadout = GenerateLoadout(toneForTheme, profile.Career, "human", "Aleatoire", "Aleatoire", "Aleatoire");
            var stats = GenerateNpcStats(power, role, profile.Career, profile.Race, profile.Class);
            return new AdventureNpc(
                Name: $"{Pick(FirstNames)} {Pick(LastNames)}",
                Role: role,
                Profession: profile.Career,
                Origin: $"{profile.Race} — {profile.Class}",
                Appearance: Pick(Appearances),
                Manner: Pick(Manners),
                Motivation: Pick(Motivations),
                Secret: Pick(AdvNpcSecrets),
                Weapon: loadout.Weapon,
                Equipment: loadout.Equipment,
                Stats: stats);
        }).ToList();

        return new GeneratedAdventure(
            Title: $"{titlePrefix} {titleSuffix}",
            Theme: theme,
            Region: region,
            Danger: danger,
            Duration: duration,
            Synopsis: Pick(AdvSynopsis[theme]),
            Location: location,
            Hook: Pick(AdvHooks[theme]),
            Threat: $"{threat} — {Pick(AdvThreatDetails[threat])}",
            KeyNpcs: npcs,
            Acts: acts,
            Twist: Pick(AdvTwists),
            Climax: Pick(AdvClimaxes[theme]),
            Resolutions: PickMany(AdvResolutions, 3),
            Rewards: PickMany(AdvRewards[danger], 2),
            CityName: cityName,
            CityLat: cityLat,
            CityLng: cityLng,
            RegionDescription: regionDesc,
            NearbyCities: nearby,
            Atmosphere: Pick(AdvAtmospheres[theme]),
            CampaignLink: campaignLink);
    }

    private AdventureNpc GenererUnNpc(string danger, string theme, string role)
    {
        var power = danger switch { "Faible" => "Ordinaire", "Eleve" => "Dangereux", _ => "Competent" };
        var toneForTheme = theme switch
        {
            "Intrigue" or "Politique" => "Urbain",
            "Exploration" => "Foret",
            "Horreur" => "Souterrain",
            _ => "Route",
        };
        var profession = Pick(AdvNpcProfessions);
        var profile = ResolveHumanoidProfile("Aleatoire", "Aleatoire", "Aleatoire", profession);
        var loadout = GenerateLoadout(toneForTheme, profile.Career, "human", "Aleatoire", "Aleatoire", "Aleatoire");
        var stats = GenerateNpcStats(power, role, profile.Career, profile.Race, profile.Class);
        return new AdventureNpc(
            Name: $"{Pick(FirstNames)} {Pick(LastNames)}",
            Role: role,
            Profession: profile.Career,
            Origin: $"{profile.Race} — {profile.Class}",
            Appearance: Pick(Appearances),
            Manner: Pick(Manners),
            Motivation: Pick(Motivations),
            Secret: Pick(AdvNpcSecrets),
            Weapon: loadout.Weapon,
            Equipment: loadout.Equipment,
            Stats: stats);
    }

    private void AjouterNpc(GeneratedAdventure adv)
    {
        var role = Pick(AdvNpcRoles);
        adv.KeyNpcs.Add(GenererUnNpc(adv.Danger, adv.Theme, role));
    }

    private void SupprimerNpc(GeneratedAdventure adv, AdventureNpc npc)
    {
        adv.KeyNpcs.Remove(npc);
    }

    private async Task ExporterAventurePdf()
    {
        if (_aventure is not null)
        {
            var sections = new List<MjPdfSectionDto>
            {
                new() { Title = "Synopsis", Lines = [Line("Synopsis", _aventure.Synopsis), Line("Lieu", _aventure.Location), Line("Accroche", _aventure.Hook), Line("Menace", _aventure.Threat), Line("Duree", _aventure.Duration)] },
                new() { Title = "PNJ cles", Lines = _aventure.KeyNpcs.Select(n => Line(n.Name, $"{n.Role} — {n.Profession} ({n.Origin}) | CC {n.Stats.WS} CT {n.Stats.BS} F {n.Stats.S} E {n.Stats.T} I {n.Stats.I} Ag {n.Stats.Ag} Int {n.Stats.Int} FM {n.Stats.WP} Soc {n.Stats.Fel} B {n.Stats.Wounds} | {n.Weapon} | Secret : {n.Secret}")).ToList() },
                new() { Title = "Actes", Lines = _aventure.Acts.Select((a, i) => Line($"Acte {i + 1} — {a.Title}", $"{a.Description} [Defi : {a.Challenge}]")).ToList() },
                new() { Title = "Resolution", Lines = [Line("Retournement", _aventure.Twist), Line("Climax", _aventure.Climax), .. _aventure.Resolutions.Select(r => Line("Resolution", r)), .. _aventure.Rewards.Select(r => Line("Recompense", r))] }
            };
            await ExporterMjPdf(new MjPdfExportRequest { Type = "aventure", Title = _aventure.Title, Sections = sections });
        }
        else if (_campagne is not null)
        {
            var sections = new List<MjPdfSectionDto>
            {
                new() { Title = "Campagne", Lines = [Line("Fil rouge", _campagne.ArcSummary), Line("Antagoniste", _campagne.RecurringVillain)] }
            };
            foreach (var (ep, idx) in _campagne.Episodes.Select((e, i) => (e, i)))
            {
                sections.Add(new MjPdfSectionDto
                {
                    Title = $"Episode {idx + 1} — {ep.Title}",
                    Lines =
                    [
                        Line("Theme", ep.Theme), Line("Region", ep.Region), Line("Danger", ep.Danger),
                        Line("Synopsis", ep.Synopsis), Line("Lieu", ep.Location), Line("Accroche", ep.Hook), Line("Menace", ep.Threat),
                        .. ep.KeyNpcs.Select(n => Line(n.Name, $"{n.Role} — {n.Profession} ({n.Origin}) | {n.Weapon}")),
                        .. ep.Acts.Select((a, i) => Line($"Acte {i + 1}", $"{a.Title} — {a.Description}")),
                        Line("Retournement", ep.Twist), Line("Climax", ep.Climax),
                        .. ep.Resolutions.Select(r => Line("Resolution", r)),
                        .. ep.Rewards.Select(r => Line("Recompense", r)),
                        .. (ep.CampaignLink is not null ? new[] { Line("Lien de campagne", ep.CampaignLink) } : Array.Empty<MjPdfLineDto>()),
                    ]
                });
            }
            await ExporterMjPdf(new MjPdfExportRequest { Type = "campagne", Title = _campagne.Title, Sections = sections });
        }
    }

