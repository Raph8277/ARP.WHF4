            Snackbar.Add(fois > 0
                ? $"{talent.TalentNom} ajouté {fois} fois."
                : $"{talent.TalentNom} retiré {-fois} fois.", Severity.Success);
            await Recharger();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _enregistrementAvancement = false;
        }
    }

    private async Task SauvegarderEdition()
    {
        if (_personnage == null)
            return;

        if (string.IsNullOrWhiteSpace(_edition.Nom))
        {
            Snackbar.Add("Le nom est obligatoire.", Severity.Warning);
            return;
        }

        _enregistrementEdition = true;
        try
        {
            _personnage = await Api.MettreAJourPersonnageAsync(Id, _edition);
            _editionActive = false;
            Snackbar.Add("Fiche mise à jour.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _enregistrementEdition = false;
        }
    }

    private async Task OuvrirAvancementCaracteristique(CaracteristiqueDto caracteristique)
    {
        if (_personnage == null) return;

        var parameters = new DialogParameters<Components.AvancementDialog>
        {
            { x => x.PersonnageId, Id },
            { x => x.CodeCaracteristique, caracteristique.Code },
