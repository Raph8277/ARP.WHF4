        var parameters = new DialogParameters<Components.SortDetailsDialog>
        {
            { x => x.Sort, sort },
        };

        await Dialog.ShowAsync<Components.SortDetailsDialog>(sort.Nom, parameters);
    }

    private static SortReferenceDto ToSortReference(PersonnageSortDto sort) => new()
    {
        Id = sort.SortReferenceId,
        Nom = sort.SortNom,
        Categorie = sort.Categorie,
        Domaine = sort.Domaine,
        Cn = sort.Cn,
        Portee = sort.Portee,
        Cible = sort.Cible,
        Duree = sort.Duree,
        Resume = sort.Resume,
    };

    private static SortReferenceDto ToSortReference(PersonnageParcheminDto parchemin) => new()
    {
        Id = parchemin.SortReferenceId,
        Nom = parchemin.SortNom,
        Categorie = parchemin.Categorie,
        Domaine = parchemin.Domaine,
        Cn = parchemin.Cn,
        Portee = parchemin.Portee,
        Cible = parchemin.Cible,
        Duree = parchemin.Duree,
        Resume = parchemin.Resume,
    };

    private async Task OuvrirAjoutPossession(TypePossession type)
    {
        if (_personnage == null) return;

        var label = type == TypePossession.Arme ? "arme" : "objet";
        var parameters = new DialogParameters<Components.AjoutPossessionDialog>
        {
            { x => x.PersonnageId, Id },
            { x => x.TypePossession, type },
        };

        var dialog = await Dialog.ShowAsync<Components.AjoutPossessionDialog>($"Ajouter un {label}", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await Recharger();
        }
    }

    private async Task TransfererDotation(string nom, bool estArme)
    {
        if (_personnage == null) return;

        try
        {
            var type = estArme ? TypePossession.Arme : TypePossession.Objet;
            await Api.AjouterPossessionAsync(Id, new AjoutPossessionRequest
            {
                Nom = nom,
                Type = type,
                Quantite = 1,
            });
            var label = estArme ? "arme" : "objet";
            Snackbar.Add($"{nom} ajouté comme {label}.", Severity.Success);
            await Recharger();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    private async Task ModifierBourse(char monnaie, int delta)
    {
        if (_personnage == null) return;

        _edition.CouronnesOr = _personnage.CouronnesOr;
        _edition.PistolesArgent = _personnage.PistolesArgent;
        _edition.SousCuivre = _personnage.SousCuivre;

        switch (monnaie)
        {
            case 'C': _edition.CouronnesOr = Math.Max(0, _edition.CouronnesOr + delta); break;
            case 'P': _edition.PistolesArgent = Math.Max(0, _edition.PistolesArgent + delta); break;
            case 'S': _edition.SousCuivre = Math.Max(0, _edition.SousCuivre + delta); break;
        }

        try
        {
            _personnage = await Api.MettreAJourPersonnageAsync(Id, _edition);
            var label = delta > 0 ? "ajouté" : "retiré";
            Snackbar.Add($"Bourse mise à jour ({label} {Math.Abs(delta)}).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
            await Recharger();
        }
    }

    private async Task SupprimerPossession(PossessionDto possession)
    {
        if (_personnage == null) return;

        try
        {
            await Api.SupprimerPossessionAsync(Id, possession.Id);
            Snackbar.Add($"{possession.Nom} supprimé.", Severity.Success);
            await Recharger();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    private async Task SupprimerSort(PersonnageSortDto sort)
    {
        if (_personnage == null) return;

        try
        {
            await Api.SupprimerSortAsync(Id, sort.Id);
            Snackbar.Add($"{sort.SortNom} retiré des sorts connus.", Severity.Success);
            await Recharger();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    private async Task SupprimerParchemin(PersonnageParcheminDto parchemin)
    {
        if (_personnage == null) return;

        try
        {
            await Api.SupprimerParcheminAsync(Id, parchemin.Id);
            Snackbar.Add($"Parchemin de {parchemin.SortNom} supprimé.", Severity.Success);
            await Recharger();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }
}
