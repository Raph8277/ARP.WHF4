@page "/creation"
@attribute [Authorize]
@inject Wfrp4ApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Création de Personnage — WFRP4</PageTitle>

<section class="old-world-hero old-world-hero--creation mb-6">
    <div>
        <MudText Class="old-world-kicker">Rite d'inscription</MudText>
        <MudText Typo="Typo.h2" Class="old-world-hero__title">Création de Personnage</MudText>
        <MudText Class="old-world-hero__text">Choisissez une espèce, gravez une carrière et consignez les premières lignes du destin de votre aventurier.</MudText>
    </div>
</section>

@if (!_referentielsCharges)
{
    <div class="old-world-loading">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if ((_especes?.Count ?? 0) == 0 || (_classes?.Count ?? 0) == 0 || (_carrieres?.Count ?? 0) == 0)
{
    <MudAlert Severity="Severity.Warning">
        Les référentiels ne sont pas encore disponibles. Vérifiez le démarrage de l'API et le seed automatique de la base.
    </MudAlert>
}
else
{
    <MudPaper Class="old-world-panel old-world-stepper-shell pa-6">
    <MudStepper @bind-ActiveIndex="_activeStep" Linear="true" Color="Color.Primary" Class="old-world-stepper">
        @* Étape 1 : Espèce *@
        <MudStep Title="Espèce">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre I</MudText>
                <MudText Typo="Typo.h4">Choisissez votre espèce</MudText>
            </div>
            <MudSelect T="int" Label="Espèce" Value="_request.EspeceId" ValueChanged="OnEspeceChanged" Required="true">
                @foreach (var e in _especes!)
                {
                    <MudSelectItem T="int" Value="@e.Id">@e.Nom (Mouvement : @e.MouvementBase)</MudSelectItem>
                }
            </MudSelect>

            @if (SelectedEspece?.CaracInitiales.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Les caractéristiques de base de l'espèce ont été préremplies. Vous pouvez encore les ajuster avant validation.
                </MudAlert>
            }
        </MudStep>

        @* Étape 2 : Classe *@
        <MudStep Title="Classe">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre II</MudText>
                <MudText Typo="Typo.h4">Choisissez votre classe</MudText>
            </div>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                <MudToggleGroup T="string" @bind-Value="_classeMode" Color="Color.Primary" Rounded="true" CheckMark="true">
                    <MudToggleItem T="string" Value="@("manuel")" Text="Manuel" />
                    <MudToggleItem T="string" Value="@("aleatoire")" Text="Aléatoire" />
                </MudToggleGroup>

                @if (_classeMode == "aleatoire")
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Casino"
                               OnClick="TirerClasseAleatoire">
                        Tirer au sort
                    </MudButton>
                }
            </MudStack>

            @if (_classeMode == "manuel")
            {
                <MudSelect T="int" Label="Classe" Value="_selectedClasseId" ValueChanged="OnClasseChanged" Required="true">
                    @foreach (var cl in _classes!.OrderBy(c => c.Nom))
                    {
                        <MudSelectItem T="int" Value="@cl.Id">@cl.Nom</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_selectedClasseId > 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    Classe tirée au sort : <strong>@(SelectedClasse?.Nom ?? "—")</strong>
                </MudAlert>
            }
        </MudStep>

        @* Étape 3 : Carrière *@
        <MudStep Title="Carrière">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre III</MudText>
                <MudText Typo="Typo.h4">Choisissez votre carrière</MudText>
            </div>

            @if (_selectedClasseId <= 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Veuillez d'abord choisir une classe à l'étape précédente.
                </MudAlert>
            }
            else
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                    <MudToggleGroup T="string" @bind-Value="_carriereMode" Color="Color.Primary" Rounded="true" CheckMark="true">
                        <MudToggleItem T="string" Value="@("manuel")" Text="Manuel" />
                        <MudToggleItem T="string" Value="@("aleatoire")" Text="Aléatoire" />
                    </MudToggleGroup>

                    @if (_carriereMode == "aleatoire")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Casino"
                                   OnClick="TirerCarriereAleatoire">
                            Tirer au sort
                        </MudButton>
                    }
                </MudStack>

                @if (_carriereMode == "manuel")
                {
                    <MudSelect T="int" Label="Carrière" @bind-Value="_selectedCarriereId" Required="true">
                        @foreach (var c in CarrieresDeLaClasse)
                        {
                            <MudSelectItem T="int" Value="@c.Id">@c.Nom</MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (_selectedCarriereId > 0)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">
                        Carrière tirée au sort : <strong>@(SelectedCarriere?.Nom ?? "—")</strong>
                    </MudAlert>
                }

                @if (SelectedCarriere?.Niveaux.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Progression de carrière</MudText>
                    <div class="career-progression">
                        @foreach (var niveau in SelectedCarriere.Niveaux.OrderBy(n => n.Niveau))
                        {
                            <div class="career-progression__level @(niveau.Niveau == 1 ? "career-progression__level--active" : "")">
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.body2">
                                        <strong>@niveau.Intitule</strong>
                                    </MudText>
                                    <StatutBadge Tier="@niveau.Statut" Rang="@niveau.StatutNumerique" />
                                </div>
                                <MudText Typo="Typo.caption">Niveau @niveau.Niveau</MudText>
                            </div>
                        }
                    </div>
                }
            }
        </MudStep>

        @* Étape 4 : Caractéristiques *@
        <MudStep Title="Caractéristiques">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre IV</MudText>
                <MudText Typo="Typo.h4">Définissez vos caractéristiques</MudText>
            </div>

            @* Tirage aléatoire *@
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">
                    <b>Tirage aléatoire</b> — 2d10 + bonus d'espèce
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Casino"
                               OnClick="TirerLesDes"
                               Disabled="@(_request.EspeceId <= 0)">
                        Tirer les dés
                    </MudButton>
                    @if (_desLances)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                            +@_xpBonusDes XP au départ
                        </MudChip>
                        @if (_xpBonusDes < 50)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                (valeur modifiée — bonus réduit à +25 XP)
                            </MudText>
                        }
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
                    Accepter tous les dés : +50 XP · Modifier après tirage : +25 XP · Saisie manuelle : 0 XP
                </MudText>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudGrid>
                        @foreach (var caracCode in _codesCarac)
                        {
                            <MudItem xs="6">
                                <MudNumericField T="int" Label="@caracCode"
                                                 Value="GetCaracValue(caracCode)"
                                                 ValueChanged="v => OnCaracChanged(caracCode, v)"
                                                 Min="1" Max="99" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>

                <MudItem xs="12" md="6">
                    <div class="carac-radar-container">
                        <MudChart T="double" ChartType="ChartType.Radar"
                                  ChartSeries="@CaracChartSeries"
                                  ChartLabels="@_codesCarac"
                                  Width="100%" Height="360px"
                                  ChartOptions="@_radarOptions" />
                    </div>
                </MudItem>
            </MudGrid>
        </MudStep>

        @* Étape 5 : Compétences *@
        <MudStep Title="Compétences">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre V</MudText>
                <MudText Typo="Typo.h4">Compétences de carrière</MudText>
            </div>

            @if (CompetencesCarriere.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Aucune compétence définie pour ce niveau de carrière. Vous pourrez en acquérir plus tard via la dépense d'XP.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-4">
                    Voici les compétences accessibles au niveau 1 de votre carrière.
                    Cochez celles que vous souhaitez acquérir et ajustez les avances initiales.
                </MudText>

                <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Compétence</th>
                            <th>Caractéristique</th>
                            <th>Type</th>
                            <th style="width:120px">Avances</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in CompetencesCarriere)
                        {
                            var isSelected = _selectedCompetences.ContainsKey(comp.Id);
                            <tr>
                                <td>
                                    <MudCheckBox T="bool" Value="isSelected"
                                                 ValueChanged="v => OnCompetenceToggled(comp.Id, v)" />
                                </td>
                                <td>
                                    <MudText Typo="Typo.body2"><strong>@comp.Nom</strong></MudText>
                                    @if (!string.IsNullOrEmpty(comp.Description))
                                    {
                                        <MudText Typo="Typo.caption">@comp.Description</MudText>
                                    }
                                </td>
                                <td>@comp.Caracteristique</td>
                                <td>
                                    @if (comp.EstAvancee)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Avancée</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">De base</MudChip>
                                    }
                                    @if (comp.EstGroupee)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Groupée</MudChip>
                                    }
                                </td>
                                <td>
                                    @if (isSelected)
                                    {
                                        <MudNumericField T="int"
                                                         Value="_selectedCompetences[comp.Id]"
                                                         ValueChanged="v => OnCompetenceAvancesChanged(comp.Id, v)"
                                                         Min="0" Max="10" Dense="true" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
                    @_selectedCompetences.Count compétence(s) sélectionnée(s) — @_selectedCompetences.Values.Sum() avance(s) au total
                </MudText>
            }
        </MudStep>

        @* Étape 6 : Talents *@
        <MudStep Title="Talents">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre VI</MudText>
                <MudText Typo="Typo.h4">Talents de carrière</MudText>
            </div>

            @if (TalentsCarriere.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Aucun talent défini pour ce niveau de carrière. Vous pourrez en acquérir plus tard via la dépense d'XP.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-4">
                    Voici les talents accessibles au niveau 1 de votre carrière.
                    Cochez ceux que vous souhaitez acquérir.
                </MudText>

                <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Talent</th>
                            <th>Max</th>
                            <th>Effet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var talent in TalentsCarriere)
                        {
                            var isSelected = _selectedTalents.Contains(talent.Id);
                            <tr>
                                <td>
                                    <MudCheckBox T="bool" Value="isSelected"
                                                 ValueChanged="v => OnTalentToggled(talent.Id, v)" />
                                </td>
                                <td>
                                    <MudText Typo="Typo.body2"><strong>@talent.Nom</strong></MudText>
                                    @if (!string.IsNullOrEmpty(talent.Description))
                                    {
                                        <MudText Typo="Typo.caption">@talent.Description</MudText>
                                    }
                                </td>
                                <td>
                                    @if (talent.MaxFois.HasValue)
                                    {
                                        @talent.MaxFois
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Illimité</MudText>
                                    }
                                </td>
                                <td>
                                    <MudText Typo="Typo.caption">@(talent.Effet ?? "—")</MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
                    @_selectedTalents.Count talent(s) sélectionné(s)
                </MudText>
            }
        </MudStep>

        @* Étape 7 : Dotations *@
        <MudStep Title="Dotations">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre VII</MudText>
                <MudText Typo="Typo.h4">Possessions de départ</MudText>
            </div>

            @if (DotationsCarriere.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Aucune dotation définie pour ce niveau de carrière.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-4">
                    Voici les possessions de départ du niveau 1 de votre carrière.
                    Ces objets vous sont attribués automatiquement à la création.
                </MudText>

                <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table">
                    <thead>
                        <tr>
                            <th>Objet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var objet in DotationsCarriere)
                        {
                            <tr>
                                <td>
                                    <MudText Typo="Typo.body2">@objet</MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
                    @DotationsCarriere.Count objet(s) de départ
                </MudText>
            }
        </MudStep>

        @* Étape 8 : Détails *@
        <MudStep Title="Détails">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre VIII</MudText>
                <MudText Typo="Typo.h4">Identité du personnage</MudText>
            </div>

            @if (SelectedEspece?.TraitsPhysiques != null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Casino"
                           OnClick="TirerTousDetails" Class="mb-4">
                    Tout tirer au sort
                </MudButton>
            }

            <MudStack Row="true" AlignItems="AlignItems.End" Class="mb-2">
                <MudTextField @bind-Value="_request.Nom" Label="Nom" Required="true" Style="flex:1" />
                @if (SelectedEspece?.TraitsPhysiques != null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Casino" OnClick="TirerNom"
                                   Title="Tirer un nom au sort" />
                }
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.End" Class="mb-2">
                <MudNumericField T="int?" @bind-Value="_request.Age" Label="Âge" Min="@AgeMin" Style="flex:1" />
                @if (SelectedEspece?.TraitsPhysiques != null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Casino" OnClick="TirerAge"
                                   Title="Tirer l'âge au sort" />
                }
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.End" Class="mb-2">
                <MudSelect T="string" @bind-Value="_request.CouleurYeux" Label="Couleur des yeux" Style="flex:1">
                    @foreach (var c in CouleursYeuxEspece)
                    {
                        <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                    }
                </MudSelect>
                @if (SelectedEspece?.TraitsPhysiques != null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Casino" OnClick="TirerCouleurYeux"
                                   Title="Tirer la couleur des yeux au sort" />
                }
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.End" Class="mb-2">
                <MudSelect T="string" @bind-Value="_request.CouleurCheveux" Label="Couleur des cheveux" Style="flex:1">
                    @foreach (var c in CouleursCheveux)
                    {
                        <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                    }
                </MudSelect>
                @if (SelectedEspece?.TraitsPhysiques != null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Casino" OnClick="TirerCouleurCheveux"
                                   Title="Tirer la couleur des cheveux au sort" />
                }
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.End" Class="mb-2">
                <MudNumericField T="int?" @bind-Value="_request.TailleCm" Label="Taille (cm)"
                                 Min="@TailleMin" Max="@TailleMax" Style="flex:1" />
                @if (SelectedEspece?.TraitsPhysiques != null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Casino" OnClick="TirerTaille"
                                   Title="Tirer la taille au sort" />
                }
            </MudStack>

            <MudAutocomplete T="string" @bind-Value="_request.Motivation" Label="Motivation"
                             SearchFunc="SuggererMotivations" CoerceText="true" CoerceValue="false"
                             MaxItems="15" Lines="2" Class="mb-2" />
        </MudStep>

        @* Étape 9 : Résumé *@
        <MudStep Title="Résumé">
            <div class="old-world-section-header">
                <MudText Class="old-world-kicker">Chapitre IX</MudText>
                <MudText Typo="Typo.h4">Vérification</MudText>
            </div>
            <MudSimpleTable Dense="true" Bordered="true" Class="old-world-table">
                <tbody>
                    <tr><td><strong>Nom</strong></td><td>@_request.Nom</td></tr>
                    <tr><td><strong>Espèce</strong></td><td>@(SelectedEspece?.Nom ?? "—")</td></tr>
                    <tr><td><strong>Classe</strong></td><td>@(SelectedClasse?.Nom ?? "—")</td></tr>
                    <tr>
                        <td><strong>Carrière</strong></td>
                        <td class="d-flex align-center gap-2">
                            @(SelectedCarriere?.Nom ?? "—")
                            @if (NiveauUn != null)
                            {
                                <StatutBadge Tier="@NiveauUn.Statut" Rang="@NiveauUn.StatutNumerique" />
                            }
                        </td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudSimpleTable Dense="true" Class="mt-4 old-world-table">
                <thead>
                    <tr><th>Caractéristique</th><th>Valeur</th></tr>
                </thead>
                <tbody>
                    @foreach (var caracCode in _codesCarac)
                    {
                        <tr>
                            <td><strong>@caracCode</strong></td>
                            <td>@GetCaracValue(caracCode)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (_selectedCompetences.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mt-4 mb-2">Compétences</MudText>
                <MudSimpleTable Dense="true" Class="old-world-table">
                    <thead>
                        <tr><th>Compétence</th><th>Avances</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (compId, avances) in _selectedCompetences)
                        {
                            var comp = _competences?.FirstOrDefault(c => c.Id == compId);
                            <tr>
                                <td>@(comp?.Nom ?? $"#{compId}")</td>
                                <td>@avances</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (_selectedTalents.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mt-4 mb-2">Talents</MudText>
                <MudSimpleTable Dense="true" Class="old-world-table">
                    <tbody>
                        @foreach (var talentId in _selectedTalents)
                        {
                            var talent = _talents?.FirstOrDefault(t => t.Id == talentId);
                            <tr>
                                <td>@(talent?.Nom ?? $"#{talentId}")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (DotationsCarriere.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mt-4 mb-2">Dotations</MudText>
                <MudSimpleTable Dense="true" Class="old-world-table">
                    <tbody>
                        @foreach (var objet in DotationsCarriere)
                        {
                            <tr>
                                <td>@objet</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       OnClick="CreerPersonnage" Disabled="_submitting">
                @if (_submitting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Créer le Personnage
            </MudButton>
        </MudStep>
    </MudStepper>
    </MudPaper>
}

@code {
    private int _activeStep;
    private bool _submitting;
    private bool _referentielsCharges;
    private CreatePersonnageRequest _request = new();
    private List<EspeceDto>? _especes;
    private List<ClasseDto>? _classes;
    private List<CarriereDto>? _carrieres;
    private List<CompetenceDto>? _competences;
    private List<TalentDto>? _talents;
    private int _selectedClasseId;
    private int _selectedCarriereId;

    // Mode de sélection : "manuel" ou "aleatoire"
    private string _classeMode = "manuel";
    private string _carriereMode = "manuel";

    // Tirage aléatoire
    private static readonly Random _rng = new();
    private bool _desLances = false;
    private int _xpBonusDes = 0;

    // Compétences et talents sélectionnés
    private Dictionary<int, int> _selectedCompetences = new();
    private HashSet<int> _selectedTalents = new();

    // Bonus fixes par espèce selon WFRP4 (ajouté à 2d10 pour chaque carac)
    private static readonly Dictionary<string, Dictionary<string, int>> _bonusDes = new()
    {
        ["HUMAIN"]   = new() { ["CC"]=20,["CT"]=20,["F"]=20,["E"]=20,["I"]=20,["Ag"]=20,["Dex"]=20,["Int"]=20,["FM"]=20,["Soc"]=20 },
