    private Task<IEnumerable<string>> SuggererMotivations(string? value, CancellationToken ct)
    {
        var suggestions = new List<string>(_motivationsGeneriques);

        if (SelectedEspece != null && _motivationsEspece.TryGetValue(SelectedEspece.Code, out var motEspece))
            suggestions.AddRange(motEspece);

        if (SelectedClasse != null && _motivationsClasse.TryGetValue(SelectedClasse.Code, out var motClasse))
            suggestions.AddRange(motClasse);

        IEnumerable<string> result = string.IsNullOrWhiteSpace(value)
            ? suggestions
            : suggestions.Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }
