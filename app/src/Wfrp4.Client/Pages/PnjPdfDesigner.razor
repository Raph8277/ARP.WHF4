    private MjPdfExportRequest BuildTestRequest()
    {
        var members = new List<MjPdfStatsDto>();
        var equipLines = new List<MjPdfLineDto>();
        var names = new[] { "Rudi Reiss", "Magda Kappel", "Greta Schreiber", "Hans Vogel", "Bruno Stein" };
        var roles = new[] { "Tueur", "Guerrier", "Eclaireur", "Mage", "Brute" };
        var origins = new[] { "Nain - Guerrier", "Humain - Roturier", "Humain - Lettres", "Elfe - Ranger", "Nain - Guerrier" };
        var dangers = new[] { "Elevee", "Moyenne", "Faible", "Moyenne", "Elevee" };
        var weapons = new[] { "Dague (Degats +BF+2)", "Arbalete legere (Degats +7)", "Gourdin (Degats +BF+4)", "Epee (Degats +BF+4)", "Hache (Degats +BF+5)" };
        var equip = new[] { "Manteau use", "Couteau utilitaire", "Bourse en cuir", "Sacoche de soins", "Corde 10m" };

        var rng = new Random(42);
        var dupCount = Math.Min(_testMemberCount - 1, 2);
        var uniqueCount = Math.Max(1, _testMemberCount - dupCount);

        for (var i = 0; i < _testMemberCount; i++)
        {
            var idx = i < uniqueCount ? i : rng.Next(uniqueCount);
            var name = names[idx % names.Length];
            var baseStat = 30 + idx * 3;
            members.Add(new MjPdfStatsDto
            {
                Name = name, Role = roles[idx % roles.Length], Origin = origins[idx % origins.Length], Danger = dangers[idx % dangers.Length],
                WS = baseStat + rng.Next(20), BS = baseStat + rng.Next(15), S = baseStat + rng.Next(15),
                T = baseStat + rng.Next(15), I = baseStat + rng.Next(20), Ag = baseStat + rng.Next(15),
                Dex = baseStat + rng.Next(15), Int = baseStat + rng.Next(15), WP = baseStat + rng.Next(15),
                Fel = baseStat + rng.Next(15), Wounds = 8 + rng.Next(8), Move = 3 + rng.Next(3)
            });
            equipLines.Add(new MjPdfLineDto { Label = $"{name} - armement", Value = weapons[idx % weapons.Length] });
            equipLines.Add(new MjPdfLineDto { Label = $"{name} - equipement", Value = equip[idx % equip.Length] });
            equipLines.Add(new MjPdfLineDto { Label = $"{name} - sort", Value = "Aucun" });
        }

        return new MjPdfExportRequest
        {
            Type = "groupe-pnj",
            Title = "Main de Guilde de Rudi",
            Layout = _config,
            Sections =
            [
                new MjPdfSectionDto
                {
                    Title = "Groupe de PNJ",
                    Lines =
                    [
                        new() { Label = "Objectif", Value = "Recuperer une dette avant la fermeture des portes" },
                        new() { Label = "Ambiance", Value = "Urbain" },
                        new() { Label = "Complication", Value = "Un marchand local reconnait l'un des membres." },
                        ..equipLines
                    ],
                    Stats = members
                }
            ]
        };
    }

    private async Task TesterRendu()
    {
        _testing = true;
        try
        {
            var content = await Api.ExporterMjPdfAsync(BuildTestRequest());
            await JS.InvokeVoidAsync("openWfrp4Pdf", "application/pdf", Convert.ToBase64String(content));
            Snackbar.Add("Rendu de test genere.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task CopierJson()
    {
        var json = JsonSerializer.Serialize(_config, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
        Snackbar.Add("JSON copie.", Severity.Success);
    }
