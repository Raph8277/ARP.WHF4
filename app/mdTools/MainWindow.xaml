<Window x:Class="MdTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF → Markdown Converter" Height="640" Width="900"
        MinWidth="700" MinHeight="500"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12" LastChildFill="True">

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtPdfPath" Grid.Column="0"
                     VerticalContentAlignment="Center" Padding="6,4"
                     IsReadOnly="True" Margin="0,0,6,0"
                     Text="Glissez un PDF ici ou cliquez Parcourir…"
                     Foreground="Gray"/>
            <Button Grid.Column="1" Content="Parcourir…" Style="{StaticResource Btn}"
                    Click="BtnBrowse_Click" Margin="0,0,6,0"/>
            <Button Grid.Column="2" x:Name="BtnConvert" Content="Convertir"
                    Style="{StaticResource Btn}" IsEnabled="False"
                    Click="BtnConvert_Click"/>
        </Grid>

        <!-- Progress -->
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top"
                     Height="4" Margin="0,0,0,8"
                     Minimum="0" Maximum="100" Value="0"/>

        <!-- Action bar -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0"
                       VerticalAlignment="Center" Foreground="Gray"
                       Text="Prêt"/>
            <Button Grid.Column="1" Content="Tout copier" Style="{StaticResource Btn}"
                    Margin="0,0,6,0" Click="BtnCopy_Click"/>
            <Button Grid.Column="2" x:Name="BtnSave" Content="Enregistrer…"
                    Style="{StaticResource Btn}" IsEnabled="False"
                    Click="BtnSave_Click"/>
        </Grid>

        <!-- Preview -->
        <TextBox x:Name="TxtPreview"
                 AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"/>
    </DockPanel>
</Window>
